# ConnectCV Backend Environment Configuration
PORT=5000
NODE_ENV=production

# JWT Authentication Secret
JWT_SECRET=your_strong_jwt_secret_min_32_chars

# Internal Admin Secret (bảo vệ endpoint nội bộ /api/internal/keys)
INTERNAL_ADMIN_SECRET=your_strong_internal_secret_token_here

# Thời gian cách ly Key khi dính lỗi 429 Quota Exceeded (mặc định 600000ms = 10 phút)
GEMINI_KEY_COOLDOWN_MS=600000

# Telegram Bot Alerting (Tùy chọn: Nhận cảnh báo khi Key hết hạn mức)
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
# TELEGRAM_CHAT_ID=-1001234567890

# QUẢN LÝ API KEYS:
# Toàn bộ Gemini API Keys được quản lý an toàn trong file backend/.keys.json (chmod 600)
# Xem mẫu cấu hình trong file .keys.json.example hoặc dùng lệnh curl /api/internal/keys/add
