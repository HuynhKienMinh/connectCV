{"body": "<div id=\"cvo-document\" class=\"cvo-document\">\n                <div class=\"cvo-page\">\n                    <div class=\"cvo-subpage\">\n                        <div id=\"cvo-body\">\n    <div id=\"cvo-main\">\n        <div id=\"group-header\">\n            <div class=\"cvo-col-7\">\n                                    <div id=\"cvo-profile-avatar-wraper\" class=\"profile-item\">\n                        <img id=\"cvo-profile-avatar\" src=\"{{profile.avatar}}\" value=\"preview_avatar\" alt=\"{{profile.fullname}}\">\n                    </div>\n                                <div class=\"cvo-profile-fullname-and-title\">\n                    <div id=\"cvo-profile-fullname-wraper\">\n                        <span id=\"cvo-profile-fullname\" contenteditable=\"true\"><strong class=\"end-action ql-size-22px\">{{profile.fullname}}</strong></span>\n                    </div>\n                                        <div id=\"cvo-profile-title-wraper\">\n                        <span id=\"cvo-profile-title\" contenteditable=\"true\"><span class=\"ql-size-18px cvo-profile-info-value\">{{profile.title}}</span></span>\n                    </div>\n                                    </div>\n            </div>\n            <div class=\"cvo-col-5\">\n                <div id=\"cvo-profile\" class=\"cvo-block\">\n        <div class=\"contact-item\">\n        Giới tính: <span id=\"cvo-profile-gender\" contenteditable=\"true\"><span class=\"ql-size-13px\">{{profile.gender}}</span></span>\n    </div>\n                <div class=\"contact-item\">\n            Ngày sinh: <span id=\"cvo-profile-dob\" contenteditable=\"true\"><span class=\"end-action ql-size-13px\">{{profile.dob}}</span></span>\n        </div>\n        <div class=\"contact-item\">\n        Email: <span id=\"cvo-profile-email\" contenteditable=\"true\"><span class=\"end-action ql-size-13px\">{{profile.email}}</span></span>\n    </div>\n    <div class=\"contact-item\">\n        Điện thoại: <span id=\"cvo-profile-phone\" contenteditable=\"true\"><span class=\"end-action ql-size-13px\">{{profile.phone}}</span></span>\n    </div>\n    <div class=\"contact-item\">\n        Địa chỉ: <span id=\"cvo-profile-address\" contenteditable=\"true\"><span class=\"end-action ql-size-13px\">{{profile.address}}</span></span>\n    </div>\n        <div class=\"contact-item\">\n        Website: <span id=\"cvo-profile-website\" contenteditable=\"true\"><span class=\"ql-size-13px\">{{profile.website}}</span></span>\n    </div>\n    </div>\n            </div>\n        </div>\n        <div class=\"cvo-col-7\">\n            <div id=\"group-left\">\n                                    {{?objective}}<div id=\"cvo-objective\" class=\"cvo-block\">\n    <div class=\"cvo-block-header\">\n        <span id=\"cvo-objective-blocktitle\">Mục tiêu nghề nghiệp</span>\n    </div>\n    <div class=\"cvo-block-body\">\n        <div id=\"cvo-objective-objective\" contenteditable=\"true\"><p class=\"ql-align-justify\">{{objective.objective}}</p></div>\n    </div>\n</div>                                    {{/objective}}{{?education}}<div id=\"cvo-education\" class=\"cvo-block\">\n    <div class=\"cvo-block-header\">\n        <span id=\"cvo-education-blocktitle\">Học vấn</span>\n    </div>\n    <div id=\"education-table\" class=\"cvo-block-body\">\n                        {{#education}}</div>\n</div>\n                                    {{/education}}{{?skillgroup}}<div id=\"cvo-skillgroup\" class=\"cvo-block\"><div class=\"cvo-block-title\">Kỹ năng</div><div id=\"skillgroup-table\" class=\"block-content\">{{#skillgroup}}</div></div>{{/skillgroup}}{{?experience}}<div id=\"cvo-experience\" class=\"cvo-block\">\n    <div class=\"cvo-block-header\">\n        <span id=\"cvo-experience-blocktitle\">Kinh nghiệm làm việc</span>\n    </div>\n    <div id=\"experience-table\" class=\"cvo-block-body\">\n                        {{#experience}}</div>\n</div>\n                                    {{/experience}}{{?activity}}<div id=\"cvo-activity\" class=\"cvo-block\">\n    <div class=\"cvo-block-header\"><span id=\"cvo-activity-blocktitle\">Hoạt động</span></div>\n    <div id=\"activity-table\" class=\"cvo-block-body\">\n                        {{#activity}}</div>\n    <div style=\"clear: both\"></div>\n</div>\n                            {{/activity}}</div>\n        </div>\n        <div class=\"cvo-col-5\">\n            <div id=\"group-right\">\n                                    {{?award}}<div id=\"cvo-award\" class=\"cvo-block\">\n    <div class=\"cvo-block-header\"><span id=\"cvo-award-blocktitle\">Danh hiệu và giải thưởng</span></div>\n    <div id=\"award-table\" class=\"cvo-block-body\">\n                        {{#award}}</div>\n    <div style=\"clear: both\"></div>\n</div>\n                                    {{/award}}{{?certification}}<div id=\"cvo-certification\" class=\"cvo-block\">\n    <div class=\"cvo-block-header\"><span id=\"cvo-certification-blocktitle\">Chứng chỉ</span></div>\n    <div id=\"certification-table\" class=\"cvo-block-body\">\n                        {{#certification}}</div>\n    <div style=\"clear: both\"></div>\n</div>\n                                    {{/certification}}{{?interest}}<div id=\"cvo-interest\" class=\"cvo-block\">\n    <div class=\"cvo-block-header\"><span id=\"cvo-interest-blocktitle\">Sở thích</span></div>\n    <ul id=\"interest-table\" class=\"cvo-block-body\">\n                            <li class=\"row\"><span class=\"cvo-interest-details\">Xem phim</span></li>\n                    <li class=\"row\"><span class=\"cvo-interest-details\">Đọc sách</span></li>\n                    </ul>\n    <div style=\"clear: both\"></div>\n</div>\n                            {{/interest}}</div>\n        </div>\n        <div style=\"clear: both;\"></div>\n    </div>\n</div>\n                    </div>\n                </div>\n            </div>", "originalBody": "<div id=\"cvo-document\" class=\"cvo-document\">\n                <div class=\"cvo-page\">\n                    <div class=\"cvo-subpage\">\n                        <div id=\"cvo-body\">\n    <div id=\"cvo-main\">\n        <div id=\"group-header\">\n            <div class=\"cvo-col-7\">\n                                    <div id=\"cvo-profile-avatar-wraper\" class=\"profile-item\">\n                        <img id=\"cvo-profile-avatar\" src=\"/api/cv/source-assets/640cf40b5d4541830388.png\" value=\"preview_avatar\" alt=\"avatar\">\n                    </div>\n                                <div class=\"cvo-profile-fullname-and-title\">\n                    <div id=\"cvo-profile-fullname-wraper\">\n                        <span id=\"cvo-profile-fullname\"><strong class=\"end-action ql-size-22px\">Nguyễn Hoàng Anh</strong></span>\n                    </div>\n                                        <div id=\"cvo-profile-title-wraper\">\n                        <span id=\"cvo-profile-title\"><span class=\"ql-size-18px cvo-profile-info-value\">Nhân viên tư vấn</span></span>\n                    </div>\n                                    </div>\n            </div>\n            <div class=\"cvo-col-5\">\n                <div id=\"cvo-profile\" class=\"cvo-block\">\n        <div class=\"contact-item\">\n        Giới tính: <span id=\"cvo-profile-gender\"><span class=\"ql-size-13px\">Nam/Nữ/Khác</span></span>\n    </div>\n                <div class=\"contact-item\">\n            Ngày sinh: <span id=\"cvo-profile-dob\"><span class=\"end-action ql-size-13px\">26/05/1996</span></span>\n        </div>\n        <div class=\"contact-item\">\n        Email: <span id=\"cvo-profile-email\"><span class=\"end-action ql-size-13px\">hotro@topcv.vn</span></span>\n    </div>\n    <div class=\"contact-item\">\n        Điện thoại: <span id=\"cvo-profile-phone\"><span class=\"end-action ql-size-13px\">(024) 6680 5588</span></span>\n    </div>\n    <div class=\"contact-item\">\n        Địa chỉ: <span id=\"cvo-profile-address\"><span class=\"end-action ql-size-13px\">Ba Đình, Hà Nội</span></span>\n    </div>\n        <div class=\"contact-item\">\n        Website: <span id=\"cvo-profile-website\"><span class=\"ql-size-13px\">be.net/tencuaban</span></span>\n    </div>\n    </div>\n            </div>\n        </div>\n        <div class=\"cvo-col-7\">\n            <div id=\"group-left\">\n                                    <div id=\"cvo-objective\" class=\"cvo-block\">\n    <div class=\"cvo-block-header\">\n        <span id=\"cvo-objective-blocktitle\">Mục tiêu nghề nghiệp</span>\n    </div>\n    <div class=\"cvo-block-body\">\n        <div id=\"cvo-objective-objective\"><p class=\"ql-align-justify\">Tôi mong muốn ứng tuyển vào vị trí Tổng đài viên Chăm sóc khách hàng để tận dụng 3 năm kinh nghiệm xử lý yêu cầu và phản hồi khách hàng chuyên nghiệp, cùng với khả năng giao tiếp tiếng Anh tốt và tinh thần làm việc năng động, linh hoạt. Mục tiêu của tôi là không ngừng nâng cao trải nghiệm khách hàng, góp phần xây dựng hình ảnh chuyên nghiệp và thân thiện cho doanh nghiệp.</p></div>\n    </div>\n</div>                                    <div id=\"cvo-education\" class=\"cvo-block\">\n    <div class=\"cvo-block-header\">\n        <span id=\"cvo-education-blocktitle\">Học vấn</span>\n    </div>\n    <div id=\"education-table\" class=\"cvo-block-body\">\n                        <div class=\"row \">\n                            <div><span class=\"cvo-education-title\">Quản trị kinh doanh</span></div>\n                        <div class=\"cvo-section-info\">\n                <div class=\"cvo-education-school-wraper\">\n                    <i class=\"fa fa-briefcase\" aria-hidden=\"true\"></i>\n                    <span class=\"cvo-education-school\">ĐH TopCV</span>\n                </div>\n                                <div class=\"cvo-education-time\">\n                    <i class=\"fa fa-calendar-o\" aria-hidden=\"true\"></i>\n                    <span class=\"time-background\">\n                                                <span class=\"cvo-education-start\">2016</span>\n                                                 -                                                 <span class=\"cvo-education-end\">2020</span>\n                                            </span>\n                </div>\n                            </div>\n                        <div class=\"cvo-education-details\"><p><span class=\"ql-size-13px end-action\">Tốt nghiệp loại Giỏi</span></p></div>\n                    </div>\n                    </div>\n</div>\n                                    <div id=\"cvo-experience\" class=\"cvo-block\">\n    <div class=\"cvo-block-header\">\n        <span id=\"cvo-experience-blocktitle\">Kinh nghiệm làm việc</span>\n    </div>\n    <div id=\"experience-table\" class=\"cvo-block-body\">\n                        <div class=\"row \">\n                            <div><span class=\"cvo-experience-position\">Tổng Đài Viên Chăm Sóc Khách Hàng</span></div>\n                        <div class=\"cvo-section-info\">\n                <div class=\"cvo-experience-company-wraper\">\n                    <i class=\"fa fa-building\" aria-hidden=\"true\"></i>\n                    <span class=\"cvo-experience-company\">SVT Finance Innovation Co.</span>\n                </div>\n                                <div class=\"cvo-experience-time\">\n                    <i class=\"fa fa-calendar-o\" aria-hidden=\"true\"></i>\n                    <span class=\"time-background\">\n                                                <span class=\"cvo-experience-start\">08/2020</span>\n                                                                        -\n                                                                        <span class=\"cvo-experience-end\">Nay</span>\n                                            </span>\n                </div>\n                            </div>\n            <div class=\"cvo-experience-details\"><ul><li class=\"ql-align-justify\">Tiếp nhận và giải đáp thắc mắc của phụ huynh liên quan đến khóa học, lịch học, học phí, chính sách hoàn trả qua điện thoại, Zalo và email.</li><li class=\"ql-align-justify\">Gọi điện nhắc lịch học, lịch kiểm tra, lịch đóng phí và tư vấn các chương trình ưu đãi mới phù hợp với từng nhóm học viên.</li><li class=\"ql-align-justify\">Phối hợp với bộ phận học vụ và giáo viên để xử lý các phản hồi từ phụ huynh về chất lượng giảng dạy hoặc tiến độ học tập của học viên.</li><li class=\"ql-align-justify\">Theo dõi mức độ hài lòng của phụ huynh, ghi nhận các phản hồi và đề xuất cải thiện trải nghiệm dịch vụ.</li><li class=\"ql-align-justify\">Cập nhật và quản lý thông tin khách hàng trên hệ thống CRM, đảm bảo dữ liệu đầy đủ, chính xác và dễ truy xuất.</li><li class=\"ql-align-justify\">Tham gia đào tạo nội bộ và cập nhật kiến thức khóa học để hỗ trợ tư vấn và chăm sóc khách hàng hiệu quả hơn.</li><li class=\"ql-align-justify\">Thành tích:&nbsp;Duy trì tỷ lệ hài lòng của phụ huynh trên 95% trong 12 tháng liên tiếp (dựa trên khảo sát nội bộ sau khóa học).</li></ul></div>\n        </div>\n                <div class=\"row \">\n                            <div><span class=\"cvo-experience-position\">Chuyên Viên Tư Vấn Giải Pháp Phần Mềm</span></div>\n                        <div class=\"cvo-section-info\">\n                <div class=\"cvo-experience-company-wraper\">\n                    <i class=\"fa fa-building\" aria-hidden=\"true\"></i>\n                    <span class=\"cvo-experience-company\">SVT Investment &amp; Development Co., Ltd</span>\n                </div>\n                                <div class=\"cvo-experience-time\">\n                    <i class=\"fa fa-calendar-o\" aria-hidden=\"true\"></i>\n                    <span class=\"time-background\">\n                                                <span class=\"cvo-experience-start\">08/2018</span>\n                                                                        -\n                                                                        <span class=\"cvo-experience-end\">07/2020</span>\n                                            </span>\n                </div>\n                            </div>\n            <div class=\"cvo-experience-details\"><ul><li class=\"ql-align-justify\">Phân tích nhu cầu và quy trình quản lý nhân sự của khách hàng, từ đó đề xuất giải pháp phần mềm chấm công, tính lương, quản lý ca phù hợp.</li><li class=\"ql-align-justify\">Tư vấn giải pháp và trình bày demo sản phẩm cho khách hàng doanh nghiệp, giúp họ hiểu rõ tính năng và lợi ích của phần mềm.</li><li class=\"ql-align-justify\">Làm việc cùng đội ngũ kỹ thuật để tùy chỉnh phần mềm theo yêu cầu đặc thù của từng doanh nghiệp (ca kíp phức tạp, quy định tính công riêng...).</li><li class=\"ql-align-justify\">Hướng dẫn sử dụng phần mềm cho khách hàng (trực tiếp hoặc online), xây dựng tài liệu hướng dẫn, hỗ trợ trong quá trình triển khai ban đầu.</li><li class=\"ql-align-justify\">Theo dõi hiệu quả sau triển khai và hỗ trợ bảo trì, tiếp nhận phản hồi và phối hợp cải tiến giải pháp cho phù hợp với quy mô, nhu cầu thực tế của khách hàng.</li></ul></div>\n        </div>\n                    </div>\n</div>\n                                    <div id=\"cvo-activity\" class=\"cvo-block\">\n    <div class=\"cvo-block-header\"><span id=\"cvo-activity-blocktitle\">Hoạt động</span></div>\n    <div id=\"activity-table\" class=\"cvo-block-body\">\n                        <div class=\"row \">\n                            <div><span class=\"cvo-activity-position\">Ban Sự Kiện</span></div>\n                        <div class=\"cvo-section-info\">\n                <div class=\"cvo-activity-organization-wraper\">\n                    <i class=\"fa fa-share-alt\" aria-hidden=\"true\"></i>\n                    <span class=\"cvo-activity-organization\">Câu lạc bộ Sự kiện, trường Đại học TopCV</span>\n                </div>\n                                <div class=\"cvo-activity-time\">\n                    <i class=\"fa fa-calendar-o\" aria-hidden=\"true\"></i>\n                    <span class=\"time-background\">\n                                                <span class=\"cvo-activity-start\">06/2016</span>\n                                                 -                                                 <span class=\"cvo-activity-end\">09/2020</span>\n                                            </span>\n                </div>\n                            </div>\n            <div class=\"cvo-activity-details\"><ul><li class=\"ql-align-justify\"><span class=\"end-action ql-size-13px\">Xây dựng 5 sự kiện chào đón tân sinh viên với 5000 sinh viên tham gia. </span></li><li class=\"ql-align-justify\"><span class=\"ql-size-13px end-action\">Hỗ trợ 500 tân sinh viên mỗi năm làm hồ sơ, tìm hiểu về nhà trường. </span></li><li class=\"ql-align-justify\"><span class=\"ql-size-13px end-action\">Giao tiếp và hỗ trợ thông tin cho phụ huynh.</span></li></ul></div>\n        </div>\n                    </div>\n    <div style=\"clear: both\"></div>\n</div>\n                            </div>\n        </div>\n        <div class=\"cvo-col-5\">\n            <div id=\"group-right\">\n                                    <div id=\"cvo-award\" class=\"cvo-block\">\n    <div class=\"cvo-block-header\"><span id=\"cvo-award-blocktitle\">Danh hiệu và giải thưởng</span></div>\n    <div id=\"award-table\" class=\"cvo-block-body\">\n                        <div class=\"row \">\n                            <span class=\"cvo-award-time\">2020</span>\n                        <span class=\"cvo-award-symbol\">:</span>\n            <span class=\"cvo-award-title\"><p><span class=\"ql-size-13px\">Tư vấn viên xuất sắc nhất Quý 3/2020</span></p></span>\n            <div style=\"clear:both;\"></div>\n        </div>\n                    </div>\n    <div style=\"clear: both\"></div>\n</div>\n                                    <div id=\"cvo-certification\" class=\"cvo-block\">\n    <div class=\"cvo-block-header\"><span id=\"cvo-certification-blocktitle\">Chứng chỉ</span></div>\n    <div id=\"certification-table\" class=\"cvo-block-body\">\n                        <div class=\"row \">\n                            <span class=\"cvo-certification-time\">2022</span>\n                        <span class=\"cvo-certification-symbol\">:</span>\n            <span class=\"cvo-certification-title\"><p><span class=\"ql-size-13px\">Chương trình đào tạo: Kỹ Năng Bán Hàng Qua Điện Thoại</span></p></span>\n            <div style=\"clear:both;\"></div>\n        </div>\n                <div class=\"row \">\n                            <span class=\"cvo-certification-time\">2021</span>\n                        <span class=\"cvo-certification-symbol\">:</span>\n            <span class=\"cvo-certification-title\"><p><span class=\"ql-size-13px\">Đào tạo Quản Lý Chăm Sóc Khách Hàng Chuyên Nghiệp</span></p></span>\n            <div style=\"clear:both;\"></div>\n        </div>\n                    </div>\n    <div style=\"clear: both\"></div>\n</div>\n                                    <div id=\"cvo-interest\" class=\"cvo-block\">\n    <div class=\"cvo-block-header\"><span id=\"cvo-interest-blocktitle\">Sở thích</span></div>\n    <ul id=\"interest-table\" class=\"cvo-block-body\">\n                            <li class=\"row\"><span class=\"cvo-interest-details\">Xem phim</span></li>\n                    <li class=\"row\"><span class=\"cvo-interest-details\">Đọc sách</span></li>\n                    </ul>\n    <div style=\"clear: both\"></div>\n</div>\n                            </div>\n        </div>\n        <div style=\"clear: both;\"></div>\n    </div>\n</div>\n                    </div>\n                </div>\n            </div>", "rows": {"experience": "<div class=\"row \">\n                            <div><span class=\"cvo-experience-position\" contenteditable=\"true\">{{experience.position}}</span></div>\n                        <div class=\"cvo-section-info\">\n                <div class=\"cvo-experience-company-wraper\">\n                  