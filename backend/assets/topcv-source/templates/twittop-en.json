{"body": "<div id=\"cvo-document\" class=\"cvo-document\">\n                <div class=\"cvo-page\">\n                    <div class=\"cvo-subpage\">\n                        <div id=\"cvo-body\">\n    <!--Header-->\n    <div id=\"top-group-header\">\n        <div id=\"top-header-logo-image\"></div>\n    </div>\n    <div style=\"padding: 0 12px;\">\n        <div id=\"group-header\">\n            <!-- Profile info -->\n            <div class=\"avatar-wrapper\">\n                                <!-- <img id=\"cvo-profile-avatar\" src=\"https://www.topcv.vn/v4/image/cv-template/screenshots/thumbs/cv-template-thumbnails-v1.4/avatar-default/default_avatar.png\" value=\"preview_avatar\" alt=\"avatar\"> -->\n                <img id=\"cvo-profile-avatar\" src=\"{{profile.avatar}}\" value=\"preview_avatar\" alt=\"{{profile.fullname}}\">\n                            </div>\n            <div class=\"short-profile-info\">\n                <div style=\"display: inline;\">\n                    <span id=\"cvo-profile-fullname\" contenteditable=\"true\"><strong class=\"ql-font-RobotoCondensed ql-size-23px\">{{profile.fullname}}</strong></span>\n                    <span class=\"check-icon-wrapper\">\n                        <i class=\"fa fa-check check-icon\"></i>\n                    </span>\n                    <div style=\"clear: both;\"></div>\n                </div>\n                <div style=\"width: 100%; padding: 8px 0;\">\n                    @<span id=\"cvo-profile-title\" contenteditable=\"true\"><strong class=\"ql-font-BeVietnamPro ql-size-18px\">{{profile.title}}</strong></span>\n                    <span style=\"margin: 0 8px; color: #27a1f2;\">•</span>\n                    <span><i class=\"fa fa-external-link\"></i></span>\n                    <span id=\"cvo-profile-website\" contenteditable=\"true\"><span class=\"ql-size-13px\">{{profile.website}}</span></span>\n                </div>\n            </div>\n            <div class=\"right-button\">\n                <s