"cvo-profile-address\" contenteditable=\"true\">{{profile.address}}</span>\n            </div>\n            <div style=\"clear: both;\"></div>\n            <div style=\"padding: 8px 0;\">\n                <i class=\"fa fa-info-circle\" style=\"width: 20px;\"></i>\n                <span id=\"cvo-objective-blocktitle\">CAREER OBJECTIVES</span>:\n                <span id=\"cvo-objective-objective\" contenteditable=\"true\"><p class=\"ql-align-justify\"><span class=\"ql-size-14px\">{{objective.objective}}</span></p></span>\n            </div>\n        </div>\n        <div style=\"clear: both;\"></div>\n        <div id=\"cvo-main\">\n            <div id=\"group-col-left\">\n                                {{?education}}<div id=\"cvo-education\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\">\n        <span class=\"cvo-block-title-span\">\n            #<span id=\"cvo-education-blocktitle\">Education</span>\n        </span>\n        <div class=\"cvo-block-title-underline\">\n        </div>\n    </div>\n    <div id=\"education-table\" class=\"cvo-block-content cvo-block-body\">\n                        {{#education}}</div>\n    <div style=\"clear: both\"></div>\n</div>\n                                {{/education}}{{?skillgroup}}<div id=\"cvo-skillgroup\" class=\"cvo-block\"><div class=\"cvo-block-title\">\n        <span class=\"cvo-block-title-span\">\n            #<span id=\"cvo-skillgroup-blocktitle\">Skills</span>\n        </span>\n        <div class=\"cvo-block-title-underline\">\n        </div>\n    </div>\n    <div id=\"skillgroup-table\" class=\"block-content\">{{#skillgroup}}</div></div>{{/skillgroup}}{{?award}}<div id=\"cvo-award\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\">\n        <span class=\"cvo-block-title-span\">\n            #<span id=\"cvo-award-blocktitle\">Honors &amp; Awards</span>\n        </span>\n        <div class=\"cvo-block-title-underline\">\n        </div>\n    </div>\n    <div id=\"award-table\" class=\"cvo-block-body\">\n                        {{#award}}</div>\n    <div style=\"clear: both\"></div>\n</div>\n                            {{/award}}</div>\n            <div id=\"group-col-right\">\n                                {{?experience}}<div id=\"cvo-experience\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\">\n        <span class=\"cvo-block-title-span\">\n            #<span id=\"cvo-experience-blocktitle\">Work experience</span>\n        </span>\n        <div class=\"cvo-block-title-underline\">\n        </div>\n    </div>\n    <div id=\"experience-table\" class=\"cvo-block-content cvo-block-body\">\n                        {{#experience}}</div>\n    <div style=\"clear: both\"></div>\n</div>\n                                {{/experience}}{{?certification}}<div id=\"cvo-certification\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\">\n        <span class=\"cvo-block-title-span\">\n            #<span id=\"cvo-certification-blocktitle\">Certifications</span>\n        </span>\n        <div class=\"cvo-block-title-underline\">\n        </div>\n    </div>\n    <div id=\"certification-table\" class=\"cvo-block-body\">\n                        {{#certification}}</div>\n    <div style=\"clear: both\"></div>\n</div>\n                            {{/certification}}</div>\n            <div style=\"clear: both;\"></div>\n        </div>\n    </div>\n    <div style=\"clear: both;\"></div>\n</div>\n<div id=\"cv-watermark\">© topcv.vn</div>\n                    </div>\n                </div>\n            </div>", "originalBody": "<div id=\"cvo-document\" class=\"cvo-document\">\n                <div class=\"cvo-page\">\n                    <div class=\"cvo-subpage\">\n                        <div id=\"cvo-body\">\n    <!--Header-->\n    <div id=\"top-group-header\">\n        <div id=\"top-header-logo-image\"></div>\n    </div>\n    <div style=\"padding: 0 12px;\">\n        <div id=\"group-header\">\n            <!-- Profile info -->\n            <div class=\"avatar-wrapper\">\n                                <!-- <img id=\"cvo-profile-avatar\" src=\"/api/cv/source-assets/640cf40b5d4541830388.png\" value=\"preview_avatar\" alt=\"avatar\"> -->\n                <img id=\"cvo-profile-avatar\" src=\"/api/cv/source-assets/640cf40b5d4541830388.png\" value=\"preview_avatar\" alt=\"avatar\">\n                            </div>\n            <div class=\"short-profile-info\">\n                <div style=\"display: inline;\">\n                    <span id=\"cvo-profile-fullname\">\n                        <strong class=\"ql-font-RobotoCondensed ql-size-23px\">PHAM HA AN</strong>\n                    </span>\n                    <span class=\"check-icon-wrapper\">\n                        <i class=\"fa fa-check check-icon\"></i>\n                    </span>\n                    <div style=\"clear: both;\"></div>\n                </div>\n                <div style=\"width: 100%; padding: 8px 0;\">\n                    @<span id=\"cvo-profile-title\"><strong class=\"ql-font-BeVietnamPro ql-size-18px\">Consultant</strong></span>\n                    <span style=\"margin: 0 8px; color: #27a1f2;\">•</span>\n                    <span><i class=\"fa fa-external-link\"></i></span>\n                    <span id=\"cvo-profile-website\"><span class=\"ql-size-13px\">be.net/yourname</span></span>\n                </div>\n            </div>\n            <div class=\"right-button\">\n                <span class=\"hire-me-button\">\n                    Hire me\n                </span>\n            </div>\n            <div style=\"clear: both;\"></div>\n        </div>\n        <div class=\"detail-profile-info\">\n            <div class=\"row-info-item\">\n                <span class=\"row-info-item-icon\"><i class=\"fa fa-envelope-o\" aria-hidden=\"true\"></i></span>\n                <span class=\"row-info-item-label\">Email:</span>\n                <span class=\"row-info-item-value\" id=\"cvo-profile-email\">&lt;span class=\"ql-size-13px ql-font-BeVietnamPro\"&gt;hotro@topcv.vn&lt;/span&gt;</span>\n            </div>\n            <div class=\"row-info-item\">\n                <span class=\"row-info-item-icon\"><i class=\"fa fa-phone\" aria-hidden=\"true\"></i></span>\n                <span class=\"row-info-item-label\">Phone:</span>\n                <span class=\"row-info-item-value\" id=\"cvo-profile-phone\">&lt;span class=\"ql-size-13px ql-font-BeVietnamPro\"&gt;(024) 6680 5588&lt;/span&gt;</span>\n            </div>\n            <div class=\"row-info-item\">\n                <span class=\"row-info-item-icon\"><i class=\"fa fa-user\" aria-hidden=\"true\"></i></span>\n                <span class=\"row-info-item-label\">Gender:</span>\n                <span class=\"row-info-item-value\" id=\"cvo-profile-gender\">&lt;span class=\"ql-size-13px\"&gt;Male/Female/Other&lt;/span&gt;</span>\n            </div>\n            <div class=\"row-info-item\">\n                <span class=\"row-info-item-icon\"><i class=\"fa fa-calendar\" aria-hidden=\"true\"></i></span>\n                <span class=\"row-info-item-label\">Date of birth:</span>\n                <span class=\"row-info-item-value\" id=\"cvo-profile-dob\">&lt;span class=\"ql-size-13px ql-font-BeVietnamPro\"&gt;August 24, 1996&lt;/span&gt;</span>\n            </div>\n            <div class=\"row-info-item\" style=\"width: 100%;\">\n                <span class=\"row-info-item-icon\"><i class=\"fa fa-home\" aria-hidden=\"true\"></i></span>\n                <span class=\"row-info-item-label\">Address:</span>\n                <span class=\"row-info-item-value\" id=\"cvo-profile-address\">Ba Dinh, Ha Noi</span>\n            </div>\n            <div style=\"clear: both;\"></div>\n            <div style=\"padding: 8px 0;\">\n                <i class=\"fa fa-info-circle\" style=\"width: 20px;\"></i>\n                <span id=\"cvo-objective-blocktitle\">CAREER OBJECTIVES</span>:\n                <span id=\"cvo-objective-objective\"><p class=\"ql-align-justify\"><span class=\"ql-size-14px\">Customer Consultant with 5 years of experience in product and course consulting at English centers and technology stores. Skilled in identifying potential customers, providing accurate information, and effectively persuading clients. Known for being quick-witted, adaptable, and thriving under pressure. Seeking a Customer Consultant position to contribute to revenue growth and customer acquisition for the company. </span></p></span>\n            </div>\n        </div>\n        <div style=\"clear: both;\"></div>\n        <div id=\"cvo-main\">\n            <div id=\"group-col-left\">\n                                <div id=\"cvo-education\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\">\n        <span class=\"cvo-block-title-span\">\n            #<span id=\"cvo-education-blocktitle\">Education</span>\n        </span>\n        <div class=\"cvo-block-title-underline\">\n        </div>\n    </div>\n    <div id=\"education-table\" class=\"cvo-block-content cvo-block-body\">\n                        <div class=\"row\">\n            <div>\n                <div class=\"cvo-title-wrapper\">\n                    <span>\n                        <span class=\"background-block-icon\"><i class=\"fa fa-graduation-cap icon-wrapper\"></i></span>\n                        <span class=\"cvo-education-school\">\n                            TopCV University</span></span><span class=\"cvo-separator\">,&nbsp;</span><span class=\"cvo-education-title\">Business Administration</span>                </div>\n                <div class=\"cvo-education-time cvo-time-wraper\">\n                    <span class=\"cvo-education-start\">2016</span>\n                    <span><b>&nbsp;-&nbsp;</b></span>\n                    <span class=\"cvo-education-end\">2020</span>\n                </div>\n            </div>\n            <div>\n                <div class=\"row-details\">\n                                        <div class=\"cvo-education-details color-content\"><p><span class=\"ql-size-14px\">Excellent</span></p></div>\n                                    </div>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>\n                    </div>\n    <div style=\"clear: both\"></div>\n</div>\n                                <div id=\"cvo-award\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\">\n        <span class=\"cvo-block-title-span\">\n            #<span id=\"cvo-award-blocktitle\">Honors &amp; Awards</span>\n        </span>\n        <div class=\"cvo-block-title-underline\">\n        </div>\n    </div>\n    <div id=\"award-table\" class=\"cvo-block-body\">\n                        <div class=\"row\">\n            <span class=\"cvo-award-time cvo-time\">2020</span>:\n            <span class=\"cvo-award-title color-content\"><p><strong class=\"ql-size-14px\">Best consultant in the third quarter of 2022</strong></p></span>\n            <div style=\"clear:both;\"></div>\n        </div>\n                    </div>\n    <div style=\"clear: both\"></div>\n</div>\n                            </div>\n            <div id=\"group-col-right\">\n                                <div id=\"cvo-experience\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\">\n        <span class=\"cvo-block-title-span\">\n            #<span id=\"cvo-experience-blocktitle\">Work experience</span>\n        </span>\n        <div class=\"cvo-block-title-underline\">\n        </div>\n    </div>\n    <div id=\"experience-table\" class=\"cvo-block-content cvo-block-body\">\n                        <div class=\"row\">\n            <div>\n                <div class=\"cvo-experience-wrapper\">\n                    <span>\n                        <span class=\"background-block-icon\"><i class=\"fa fa-briefcase icon-wrapper\"></i></span>\n                        <span class=\"cvo-experience-company\">\n                            HJS Academy</span></span><span class=\"cvo-separator\">,&nbsp;</span><span class=\"cvo-experience-position\">Consultant</span>                </div>\n            </div>\n            <div>\n                <div class=\"row-title\">\n                    <div class=\"cvo-experience-company-wraper\">\n                        <span class=\"cvo-experience-start\">2022</span>\n                        <span><b>&nbsp;-&nbsp;</b></span>\n                        <span class=\"cvo-experience-end\">2025</span>\n                    </div>\n                </div>\n                <div class=\"row-details\">\n                    <div class=\"cvo-experience-details color-content\"><ul><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Provided personalized consultation based on student's learning goals. </span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Recommended suitable English courses aligned with students' interests and proficiency levels, clearly explaining course features, benefits, and how they differ from competitors.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Promoted special enrollment promotions and tuition discounts to increase conversion rates, consistently exceeding 150% of assigned KPIs.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Collected and maintained a database of over 5,000 potential learners for nurturing and follow-up, contributing to long-term customer engagement and upselling.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Collaborated with Marketing and Academic departments to develop strategies for customer acquisition and retention, helping increase overall company revenue by 200% within one year. </span></li></ul></div>\n                </div>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>\n                <div class=\"row\">\n            <div>\n                <div class=\"cvo-experience-wrapper\">\n                    <span>\n                        <span class=\"background-block-icon\"><i class=\"fa fa-briefcase icon-wrapper\"></i></span>\n                        <span class=\"cvo-experience-company\">\n                            TopCV BCD Company</span></span><span class=\"cvo-separator\">,&nbsp;</span><span class=\"cvo-experience-position\">Software Solution Consultant</span>                </div>\n            </div>\n            <div>\n                <div class=\"row-title\">\n                    <div class=\"cvo-experience-company-wraper\">\n                        <span class=\"cvo-experience-start\">August 2018</span>\n                        <span><b>&nbsp;-&nbsp;</b></span>\n                        <span class=\"cvo-experience-end\">July 2020</span>\n                    </div>\n                </div>\n                <div class=\"row-details\">\n                    <div class=\"cvo-experience-details color-content\"><ul><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Searched, consulted, and introduced software and hardware solutions (e.g., printers, barcode scanners) to approximately 50 customers daily, utilizing a database of 5,000 existing contacts and self-sourced 100 new leads per day. </span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Supported and guided customers in using software products both online and onsite, ensuring effective onboarding and usage.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Managed the sales process and contract signing, consistently exceeding 150% of the annual revenue KPI.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Maintained and developed a strong pipeline of potential customers, contributing to long-term business growth. </span></li></ul></div>\n                </div>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>\n                    </div>\n    <div style=\"clear: both\"></div>\n</div>\n                                <div id=\"cvo-certification\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\">\n        <span class=\"cvo-block-title-span\">\n            #<span id=\"cvo-certification-blocktitle\">Certifications</span>\n        </span>\n        <div class=\"cvo-block-title-underline\">\n        </div>\n    </div>\n    <div id=\"certification-table\" class=\"cvo-block-body\">\n                        <div class=\"row\">\n            <span class=\"cvo-certification-time cvo-time\">2022</span>:\n            <span class=\"cvo-certification-title color-content\"><p><strong class=\"ql-size-14px\">Training Program: Telephone Selling Skills</strong></p></span>\n            <div style=\"clear:both;\"></div>\n        </div>\n                <div class=\"row\">\n            <span class=\"cvo-certification-time cvo-time\">2021</span>:\n            <span class=\"cvo-certification-title color-content\"><p><strong class=\"ql-size-14px\">Professional Customer Care Management training course</strong></p></span>\n            <div style=\"clear:both;\"></div>\n        </div>\n                    </div>\n    <div style=\"clear: both\"></div>\n</div>\n                            </div>\n            <div style=\"clear: both;\"></div>\n        </div>\n    </div>\n    <div style=\"clear: both;\"></div>\n</div>\n<div id=\"cv-watermark\">© topcv.vn</div>\n                    </div>\n                </div>\n            </div>", "rows": {"experience": "<div class=\"row\">\n            <div>\n                <div class=\"cvo-experience-wrapper\">\n                    <span>\n                        <span class=\"background-block-icon\"><i class=\"fa fa-briefcase icon-wrapper\"></i></span>\n                        <span class=\"cvo-experience-company\" contenteditable=\"true\">{{experience.company}}</span></span><span class=\"cvo-separator\">, </span><span class=\"cvo-experience-position\" contenteditable=\"true\">{{experience.position}}</span>                </div>\n            </div>\n            <div>\n                <div class=\"row-title\">\n                    <div class=\"cvo-experie