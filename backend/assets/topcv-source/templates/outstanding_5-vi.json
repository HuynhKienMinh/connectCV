{"body": "<div id=\"cvo-document\" class=\"cvo-document\">\n                <div class=\"cvo-page\">\n                    <div class=\"cvo-subpage\">\n                        <div id=\"cvo-body\">\n    <div class=\"name-header theme-background\">\n        <div class=\"cv-col cv-col-left\"></div>\n\n        <div class=\"cv-col cv-col-right name-header-content-wrapper\">\n            <div class=\"name-header-content\">\n                <p id=\"cvo-profile-fullname\" contenteditable=\"true\"><strong class=\"end-action ql-size-22px\">{{profile.fullname}}</strong></p>\n                <p id=\"cvo-profile-title\" contenteditable=\"true\"><span class=\"ql-size-18px cvo-profile-info-value\">{{profile.title}}</span></p>\n            </div>\n        </div>\n    </div>\n    <div id=\"cvo-main\">\n        <div class=\"cv-col cv-col-left\">\n            <div class=\"mb-20 mt--200\">\n                <div class=\"shadow-wrapper radius-50 pb-75 pt-35 relative theme-common-background text-center\">\n                    <div class=\"w-75 mx-auto\" style=\"overflow: hidden\">\n                        <div class=\"radius-50-percent\">\n                                                            <img id=\"cvo-profile-avatar\" class=\"radius-50-percent\" src=\"{{profile.avatar}}\" value=\"preview_avatar\" alt=\"{{profile.fullname}}\">\n                                                    </div>\n                    </div>\n\n                    <div class=\"text-center px-20\">\n                                                    <div class=\"cvo-profile-info-row\" id=\"cvo-profile-gender-wraper\">\n                                <div class=\"cvo-profile-label\">\n                                    <span class=\"info-label\">Giới tính</span>\n                                </div>\n                                <div class=\"cvo-profile-info-value\" id=\"cvo-profile-gender\" contenteditable=\"true\"><span class=\"ql-size-13px\">{{profile.gender}}</span></div>\n                            </div>\n                        \n                                                    <div class=\"cvo-profile-info-row\" id=\"cvo-profile-dob-wraper\">\n                                <div class=\"cvo-profile-label\">\n                                    <span class=\"info-label\">Ngày sinh:</span>\n                                </div>\n                                <div class=\"cvo-profile-info-value\" id=\"cvo-profile-dob\" contenteditable=\"true\"><span class=\"end-action ql-size-13px\">{{profile.dob}}</span></div>\n                            </div>\n                                                <div class=\"cvo-profile-info-row\" id=\"cvo-profile-email-wraper\">\n                            <div class=\"cvo-profile-label\">\n                                <span class=\"info-label\">Email:</span>\n                            </div>\n                            <div class=\"cvo-profile-info-value\" id=\"cvo-profile-email\" contenteditable=\"true\"><span class=\"end-action ql-size-13px\">{{profile.email}}</span></div>\n                        </div>\n                        <div class=\"cvo-profile-info-row\">\n                            <div class=\"cvo-profile-label\">\n                                <span class=\"info-label\">Điện thoại:</span>\n                            </div>\n                            <div class=\"cvo-profile-info-value\" id=\"cvo-profile-phone\" contenteditable=\"true\"><span class=\"end-action ql-size-13px\">{{profile.phone}}</span></div>\n                        </div>\n                                                    <div class=\"cvo-profile-info-row\" id=\"cvo-profile-address-wraper\">\n                                <div class=\"cvo-profile-label\">\n                                    <span class=\"info-label\">Địa chỉ:</span>\n                                </div>\n                                <div class=\"cvo-profile-info-value\" id=\"cvo-profile-address\" contenteditable=\"true\"><span class=\"end-action ql-size-13px\">{{profile.address}}</span></div>\n                            </div>\n                                            </div>\n                </div>\n            </div>\n            <div id=\"group-col-left\" class=\"\">\n                                    {{?award}}<div id=\"cvo-award\" class=\"cvo-block\">\n    <div class=\"theme-background cvo-block-title\">\n        <span id=\"cvo-award-blocktitle\">Danh hiệu và giải thưởng</span>\n\n    </div>\n    <div id=\"award-table\" class=\"cvo-block-content\">\n                        {{#award}}</div>\n    <div style=\"clear: both\"></div>\n</div>\n                            {{/award}}</div>\n        </div>\n        <div id=\"group-col-right\" class=\"cv-col cv-col-right\">\n                            {{?objective}}<div id=\"cvo-objective\" class=\"cvo-block\">\n    <div class=\"theme-background theme-background cvo-block-title\">\n        <span id=\"cvo-objective-blocktitle\">Mục tiêu nghề nghiệp</span>\n    </div>\n    <div class=\"cvo-block-content\">\n        <div id=\"cvo-objective-objective\" class=\"color-content\" contenteditable=\"true\"><p class=\"ql-align-justify\">{{objective.objective}}</p></div>\n    </div>\n\n</div>\n                            {{/objective}}{{?education}}<div id=\"cvo-education\" class=\"cvo-block\">\n    <div class=\"theme-background cvo-block-title\">\n        <span id=\"cvo-education-blocktitle\">Học vấn</span>\n    </div>\n    <div id=\"education-table\" class=\"cvo-block-content\">\n                        {{#education}}</div>\n    <div style=\"clear: both\"></div>\n</div>\n                            {{/education}}{{?skillgroup}}<div id=\"cvo-skillgroup\" class=\"cvo-block\"><div class=\"theme-background cvo-block-title\">\n        <span id=\"cvo-skillgroup-blocktitle\">Kỹ năng</span>\n    </div>\n    <div id=\"skillgroup-table\" class=\"block-content\">{{#skillgroup}}</div></div>{{/skillgroup}}{{?certification}}<div id=\"cvo-certification\" class=\"cvo-block\">\n    <div class=\"theme-background cvo-block-title\">\n        <span id=\"cvo-certification-blocktitle\">Chứng chỉ</span>\n\n    </div>\n    <div id=\"certification-table\" class=\"cvo-block-content\">\n                        {{#certification}}</div>\n    <div style=\"clear: both\"></div>\n</div>\n                            {{/certification}}{{?experience}}<div id=\"cvo-experience\" class=\"cvo-block\">\n    <div class=\"theme-background cvo-block-title\">\n        <span id=\"cvo-experience-blocktitle\">Kinh nghiệm làm việc</span>\n    </div>\n    <div id=\"experience-table\" class=\"cvo-block-content\">\n                        {{#experience}}</div>\n    <div style=\"clear: both\"></div>\n</div>\n                            {{/experience}}{{?activity}}<div id=\"cvo-activity\" class=\"cvo-block\">\n    <div class=\"theme-background cvo-block-title\">\n        <span id=\"cvo-activity-blocktitle\">Hoạt động</span>\n\n    </div>\n    <div id=\"activity-table\" class=\"cvo-block-content\">\n                        {{#activity}}</div>\n    <div style=\"clear: both\"></div>\n</div>\n                            {{/activity}}{{?reference}}<div class=\"cvo-block\" id=\"cvo-reference\">\n    <div class=\"theme-background cvo-block-title\">\n        <span id=\"cvo-reference-blocktitle\">Người giới thiệu</span>\n\n    </div>\n    <div id=\"reference-table\" class=\"cvo-block-content\">\n                        {{#reference}}</div>\n    <div style=\"clear: both;\"></div>\n</div>\n                    {{/reference}}</div>\n        <div style=\"clear: both;\"></div>\n    </div>\n</div>\n    <div id=\"cv-watermark\">\n        © topcv.vn\n    </div>\n                    </div>\n                </div>\n            </div>", "originalBody": "<div id=\"cvo-document\" class=\"cvo-document\">\n                <div class=\"cvo-page\">\n                    <div class=\"cvo-subpage\">\n                        <div id=\"cvo-body\">\n    <div class=\"name-header theme-background\">\n        <div class=\"cv-col cv-col-left\"></div>\n\n        <div class=\"cv-col cv-col-right name-header-content-wrapper\">\n            <div class=\"name-header-content\">\n                <p id=\"cvo-profile-fullname\"><strong class=\"end-action ql-size-22px\">Nguyễn Hoàng Anh</strong></p>\n                <p id=\"cvo-profile-title\"><span class=\"ql-size-18px cvo-profile-info-value\">Nhân viên tư vấn</span></p>\n            </div>\n        </div>\n    </div>\n    <div id=\"cvo-main\">\n        <div class=\"cv-col cv-col-left\">\n            <div class=\"mb-20 mt--200\">\n                <div class=\"shadow-wrapper radius-50 pb-75 pt-35 relative theme-common-background text-center\">\n                    <div class=\"w-75 mx-auto\" style=\"overflow: hidden\">\n                        <div class=\"radius-50-percent\">\n                                                            <img id=\"cvo-profile-avatar\" class=\"radius-50-percent\" src=\"/api/cv/source-assets/640cf40b5d4541830388.png\" value=\"preview_avatar\" alt=\"avatar\">\n                                                    </div>\n                    </div>\n\n                    <div class=\"text-center px-20\">\n                                                    <div class=\"cvo-profile-info-row\" id=\"cvo-profile-gender-wraper\">\n                                <div class=\"cvo-profile-label\">\n                                    <span class=\"info-label\">Giới tính</span>\n                                </div>\n                                <div class=\"cvo-profile-info-value\" id=\"cvo-profile-gender\">\n                                    <span class=\"ql-size-13px\">Nam/Nữ/Khác</span>\n                                </div>\n                            </div>\n                        \n                                                    <div class=\"cvo-profile-info-row\" id=\"cvo-profile-dob-wraper\">\n                                <div class=\"cvo-profile-label\">\n                                    <span class=\"info-label\">Ngày sinh:</span>\n                                </div>\n                                <div class=\"cvo-profile-info-value\" id=\"cvo-profile-dob\">\n                                    <span class=\"end-action ql-size-13px\">26/05/1996</span>\n                                </div>\n                            </div>\n                                                <div class=\"cvo-profile-info-row\" id=\"cvo-profile-email-wraper\">\n                            <div class=\"cvo-profile-label\">\n                                <span class=\"info-label\">Email:</span>\n                            </div>\n                            <div class=\"cvo-profile-info-value\" id=\"cvo-profile-email\"><span class=\"end-action ql-size-13px\">hotro@topcv.vn</span></div>\n                        </div>\n                        <div class=\"cvo-profile-info-row\">\n                            <div class=\"cvo-profile-label\">\n                                <span class=\"info-label\">Điện thoại:</span>\n                            </div>\n                            <div class=\"cvo-profile-info-value\" id=\"cvo-profile-phone\"><span class=\"end-action ql-size-13px\">(024) 6680 5588</span></div>\n                        </div>\n                                                    <div class=\"cvo-profile-info-row\" id=\"cvo-profile-address-wraper\">\n                                <div class=\"cvo-profile-label\">\n                                    <span class=\"info-label\">Địa chỉ:</span>\n                                </div>\n                                <div class=\"cvo-profile-info-value\" id=\"cvo-profile-address\">\n                                    <span class=\"end-action ql-size-13px\">Ba Đình, Hà Nội</span>\n                                </div>\n                            </div>\n                                            </div>\n                </div>\n            </div>\n            <div id=\"group-col-left\" class=\"\">\n                                    <div id=\"cvo-award\" class=\"cvo-block\">\n    <div class=\"theme-background cvo-block-title\">\n        <span id=\"cvo-award-blocktitle\">Danh hiệu và giải thưởng</span>\n\n    </div>\n    <div id=\"award-table\" class=\"cvo-block-content\">\n                        <div class=\"row\">\n            <span class=\"cvo-award-time cvo-time\">2020</span>:\n            <span class=\"cvo-award-title color-content\"><p><span class=\"ql-size-13px\">Tư vấn viên xuất sắc nhất Quý 3/2020</span></p></span>\n            <div style=\"clear:both;\"></div>\n        </div>\n                    </div>\n    <div style=\"clear: both\"></div>\n</div>\n                            </div>\n        </div>\n        <div id=\"group-col-right\" class=\"cv-col cv-col-right\">\n                            <div id=\"cvo-objective\" class=\"cvo-block\">\n    <div class=\"theme-background theme-background cvo-block-title\">\n        <span id=\"cvo-objective-blocktitle\">Mục tiêu nghề nghiệp</span>\n    </div>\n    <div class=\"cvo-block-content\">\n        <div id=\"cvo-objective-objective\" class=\"color-content\">\n            <p class=\"ql-align-justify\">Tôi mong muốn ứng tuyển vào vị trí Tổng đài viên Chăm sóc khách hàng để tận dụng 3 năm kinh nghiệm xử lý yêu cầu và phản hồi khách hàng chuyên nghiệp, cùng với khả năng giao tiếp tiếng Anh tốt và tinh thần làm việc năng động, linh hoạt. Mục tiêu của tôi là không ngừng nâng cao trải nghiệm khách hàng, góp phần xây dựng hình ảnh chuyên nghiệp và thân thiện cho doanh nghiệp.</p>\n        </div>\n    </div>\n\n</div>\n                            <div id=\"cvo-education\" class=\"cvo-block\">\n    <div class=\"theme-background cvo-block-title\">\n        <span id=\"cvo-education-blocktitle\">Học vấn</span>\n    </div>\n    <div id=\"education-table\" class=\"cvo-block-content\">\n                        <div class=\"row\">\n            <div>\n                <div class=\"cvo-title-wrapper\">\n                    <span><span class=\"cvo-education-school\">ĐH TopCV</span></span><span class=\"cvo-separator\">, </span><span class=\"cvo-education-title\">Quản trị kinh doanh</span>                </div>\n                <div class=\"cvo-education-time cvo-time-wraper\">\n                    <span class=\"cvo-education-start\">2016</span>\n                    <span><b>&nbsp;-&nbsp;</b></span>\n                    <span class=\"cvo-education-end\">2020</span>\n                </div>\n            </div>\n            <div>\n                <div class=\"row-details\">\n                                        <div class=\"cvo-education-details color-content\"><p><span class=\"ql-size-13px end-action\">Tốt nghiệp loại Giỏi</span></p></div>\n                                    </div>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>\n                    </div>\n    <div style=\"clear: both\"></div>\n</div>\n                            <div id=\"cvo-certification\" class=\"cvo-block\">\n    <div class=\"theme-background cvo-block-title\">\n        <span id=\"cvo-certification-blocktitle\">Chứng chỉ</span>\n\n    </div>\n    <div id=\"certification-table\" class=\"cvo-block-content\">\n                        <div class=\"row\">\n            <span class=\"cvo-certification-time cvo-time\">2022</span>:\n            <span class=\"cvo-certification-title color-content\"><p><span class=\"ql-size-13px\">Chương trình đào tạo: Kỹ Năng Bán Hàng Qua Điện Thoại</span></p></span>\n            <div style=\"clear:both;\"></div>\n        </div>\n                <div class=\"row\">\n            <span class=\"cvo-certification-time cvo-time\">2021</span>:\n            <span class=\"cvo-certification-title color-content\"><p><span class=\"ql-size-13px\">Đào tạo Quản Lý Chăm Sóc Khách Hàng Chuyên Nghiệp</span></p></span>\n            <div style=\"clear:both;\"></div>\n        </div>\n                    </div>\n    <div style=\"clear: both\"></div>\n</div>\n                            <div id=\"cvo-experience\" class=\"cvo-block\">\n    <div class=\"theme-background cvo-block-title\">\n        <span id=\"cvo-experience-blocktitle\">Kinh nghiệm làm việc</span>\n    </div>\n    <div id=\"experience-table\" class=\"cvo-block-content\">\n                        <div class=\"row\">\n            <div>\n                <div class=\"cvo-experience-wrapper\">\n                    <span><span class=\"cvo-experience-company\">SVT Finance Innovation Co.</span></span><span class=\"cvo-separator\">, </span><span class=\"cvo-experience-position\">Tổng Đài Viên Chăm Sóc Khách Hàng</span>                </div>\n            </div>\n            <div>\n                <div class=\"row-title\">\n                    <div class=\"cvo-experience-company-wraper\">\n                        <span class=\"cvo-experience-start\">08/2020</span>\n                        <span><b>&nbsp;-&nbsp;</b></span>\n                        <span class=\"cvo-experience-end\">Nay</span>\n                    </div>\n                </div>\n                <div class=\"row-details\">\n                    <div class=\"cvo-experience-details color-content\"><ul><li class=\"ql-align-justify\">Tiếp nhận và giải đáp thắc mắc của phụ huynh liên quan đến khóa học, lịch học, học phí, chính sách hoàn trả qua điện thoại, Zalo và email.</li><li class=\"ql-align-justify\">Gọi điện nhắc lịch học, lịch kiểm tra, lịch đóng phí và tư vấn các chương trình ưu đãi mới phù hợp với từng nhóm học viên.</li><li class=\"ql-align-justify\">Phối hợp với bộ phận học vụ và giáo viên để xử lý các phản hồi từ phụ huynh về chất lượng giảng dạy hoặc tiến độ học tập của học viên.</li><li class=\"ql-align-justify\">Theo dõi mức độ hài lòng của phụ huynh, ghi nhận các phản hồi và đề xuất cải thiện trải nghiệm dịch vụ.</li><li class=\"ql-align-justify\">Cập nhật và quản lý thông tin khách hàng trên hệ thống CRM, đảm bảo dữ liệu đầy đủ, chính xác và dễ truy xuất.</li><li class=\"ql-align-justify\">Tham gia đào tạo nội bộ và cập nhật kiến thức khóa học để hỗ trợ tư vấn và chăm sóc khách hàng hiệu quả hơn.</li><li class=\"ql-align-justify\">Thành tích:&nbsp;Duy trì tỷ lệ hài lòng của phụ huynh trên 95% trong 12 tháng liên tiếp (dựa trên khảo sát nội bộ sau khóa học).</li></ul></div>\n                </div>\n            </div>\n        </div>\n                <div class=\"row\">\n            <div>\n                <div class=\"cvo-experience-wrapper\">\n                    <span><span class=\"cvo-experience-company\">SVT Investment &amp; Development Co., Ltd</span></span><span class=\"cvo-separator\">, </span><span class=\"cvo-experience-position\">Chuyên Viên Tư Vấn Giải Pháp Phần Mềm</span>                </div>\n            </div>\n            <div>\n                <div class=\"row-title\">\n                    <div class=\"cvo-experience-company-wraper\">\n                        <span class=\"cvo-experience-start\">08/2018</span>\n                        <span><b>&nbsp;-&nbsp;</b></span>\n                        <span class=\"cvo-experience-end\">07/2020</span>\n                    </div>\n                </div>\n                <div class=\"row-details\">\n                    <div class=\"cvo-experience-details color-content\"><ul><li class=\"ql-align-justify\">Phân tích nhu cầu và quy trình quản lý nhân sự của khách hàng, từ đó đề xuất giải pháp phần mềm chấm công, tính lương, quản lý ca phù hợp.</li><li class=\"ql-align-justify\">Tư vấn giải pháp và trình bày demo sản phẩm cho khách hàng doanh nghiệp, giúp họ hiểu rõ tính năng và lợi ích của phần mềm.</li><li class=\"ql-align-justify\">Làm việc cùng đội ngũ kỹ thuật để tùy chỉnh phần mềm theo yêu cầu đặc thù của từng doanh nghiệp (ca kíp phức tạp, quy định tính công riêng...).</li><li class=\"ql-align-justify\">Hướng dẫn sử dụng phần mềm cho khách hàng (trực tiếp hoặc online), xây dựng tài liệu hướng dẫn, hỗ trợ trong quá trình triển khai ban đầu.</li><li class=\"ql-align-justify\">Theo dõi hiệu quả sau triển khai và hỗ trợ bảo trì, tiếp nhận phản hồi và phối hợp cải tiến giải pháp cho phù hợp với quy mô, nhu cầu thực tế của khách hàng.</li></ul></div>\n                </div>\n            </div>\n        </div>\n                    </div>\n    <div style=\"clear: both\"></div>\n</div>\n                            <div id=\"cvo-activity\" class=\"cvo-block\">\n    <div class=\"theme-background cvo-block-title\">\n        <span id=\"cvo-activity-blocktitle\">Hoạt động</span>\n\n    </div>\n    <div id=\"activity-table\" class=\"cvo-block-content\">\n                        <div class=\"row\">\n            <div>\n                <div class=\"cvo-title-wrapper\">\n                    <span class=\"cvo-activity-organization\">Câu lạc bộ Sự kiện, trường Đại học TopCV</span><span class=\"cvo-separator\">,  </span><span class=\"cvo-activity-position\">Ban Sự Kiện</span>                </div>\n                <div class=\"cvo-activity-time cvo-time-wraper\">\n                    <span class=\"cvo-activity-start\">06/2016</span>\n                    <span><b>&nbsp;-&nbsp;</b></span>\n                    <span class=\"cvo-activity-end\">09/2020</span>\n                </div>\n            </div>\n            <div>\n                <div class=\"row-details\">\n                    <div class=\"cvo-activity-details color-content\"><ul><li class=\"ql-align-justify\"><span class=\"end-action ql-size-13px\">Xây dựng 5 sự kiện chào đón tân sinh viên với 5000 sinh viên tham gia. </span></li><li class=\"ql-align-justify\"><span class=\"ql-size-13px end-action\">Hỗ trợ 500 tân sinh viên mỗi năm làm hồ sơ, tìm hiểu về nhà trường. </span></li><li class=\"ql-align-justify\"><span class=\"ql-size-13px end-action\">Giao tiếp và hỗ trợ thông tin cho phụ huynh.</span></li></ul></div>\n                </div>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>\n\n                    </div>\n    <div style=\"clear: both\"></div>\n</div>\n                            <div class=\"cvo-block\" id=\"cvo-reference\">\n    <div class=\"theme-background cvo-block-title\">\n        <span id=\"cvo-reference-blocktitle\">Người giới thiệu</span>\n\n    </div>\n    <div id=\"reference-table\" class=\"cvo-block-content\">\n                        <div class=\"row\">\n            <div class=\"cvo-reference-content color-content\">\n                                <p>Đỗ Quỳnh Mai - HR Director - SVT Finance Innovation Co.</p><p>Tel.: (024) 6680 5588</p>\n            </div>\n        </div>\n                <div class=\"row\">\n            <div class=\"cvo-reference-content color-content\">\n                                <p>Toàn Viên Hựu - HRBP Manager - SVT Investment &amp; Development Co., Ltd</p><p>Tel.: (024) 6680 5588</p>\n            </div>\n        </div>\n                    </div>\n    <div style=\"clear: both;\"></div>\n</div>\n                    </div>\n        <div style=\"clear: both;\"></div>\n    </div>\n</div>\n    <div id=\"cv-watermark\">\n        © topcv.vn\n    </div>\n                    </div>\n                </div>\n            </div>", "rows": {"experience": "<div class=\"row\">\n            <div>\n                <div class=\"cvo-experience-wrapper\">\n                    <span><span class=\"cvo-experience-company\" contenteditable=\"true\">{{experience.company}}</span></span><span class=\"cvo-separator\">, </span><span class=\"cvo-experience-position\" contenteditable=\"true\">{{experience.position}}</span>                </div>\n            </div>\n            <div>\n                <div class=\"row-title\">\n                    <div class=\"cvo-experience-company-wraper\">\n                        <span class=\"cvo-experience-start\" contenteditable=\"true\">{{experience.start}}</span>\n                        <span><b> - </b></span>\n                        <span class=\"cvo-experience-end\" contenteditable=\"true\">{{experience.end}}</span>\n                    </div>\n                </div>\n                <div class=\"row-detai