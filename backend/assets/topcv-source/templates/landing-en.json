file-phone-label-wraper\"><span>Phone</span></div>\n            </div>\n            <div class=\"contact-item\">\n                <i class=\"fa fa-envelope\"></i>\n                <div id=\"cvo-profile-email-wraper\"><span id=\"cvo-profile-email\" contenteditable=\"true\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">{{profile.email}}</span></span></div>\n                <div id=\"cvo-profile-email-label-wraper\"><span>Email</span></div>\n            </div>\n            <div class=\"contact-item\">\n                <i class=\"fa fa-map-marker\" aria-hidden=\"true\"></i>\n                <div id=\"cvo-profile-address-wraper\"><span id=\"cvo-profile-address\" contenteditable=\"true\">{{profile.address}}</span></div>\n                <div id=\"cvo-profile-address-label-wraper\"><span>Address</span></div>\n            </div>\n        </div>\n        <!-- END #group-header -->\n    </div>\n\n    <!-- #group-content -->\n    <div>\n        {{?education}}<div id=\"cvo-education\" class=\"cvo-block\">\n    <h3 class=\"cvo-block-title\"><span id=\"cvo-education-blocktitle\">Education</span></h3>\n    <div id=\"education-table\">\n                                    {{#education}}</div>\n</div>\n        {{/education}}{{?skillgroup}}<div id=\"cvo-skillgroup\" class=\"cvo-block\"><h3 class=\"cvo-block-title\"><span id=\"cvo-skillgroup-blocktitle\">Skills</span></h3>\n    <div id=\"skillgroup-table\" class=\"block-content\">{{#skillgroup}}</div></div>{{/skillgroup}}{{?experience}}<div id=\"cvo-experience\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\">\n        <span id=\"cvo-experience-blocktitle\">Work experience</span>\n    </div>\n\n    <div id=\"experience-table\" class=\"cvo-block-content cvo-block-body\">\n                        {{#experience}}</div>\n    <div style=\"clear: both\"></div>\n</div>\n\n        {{/experience}}<div class=\"group-content-wrapper\">\n            <div class=\"cvo-col-6\">\n                            </div>\n            <div class=\"cvo-col-6\">\n                            </div>\n        </div>\n        <div>\n            <div class=\"cvo-col-4\">\n                {{?award}}<div id=\"cvo-award\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\">\n        <span id=\"cvo-award-blocktitle\">Honors &amp; Awards</span>\n    </div>\n   \n    <div id=\"award-table\" class=\"cvo-block-body\">\n                        {{#award}}</div>\n    <div style=\"clear: both\"></div>\n</div>\n            {{/award}}</div>\n            <div class=\"line\"></div>\n            <div class=\"cvo-col-4\">\n                {{?certification}}<div id=\"cvo-certification\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\">\n        <span id=\"cvo-certification-blocktitle\">Certifications</span>\n    </div>\n   \n    <div id=\"certification-table\" class=\"cvo-block-body\">\n                        {{#certification}}</div>\n    <div style=\"clear: both\"></div>\n</div>\n            {{/certification}}</div>\n            <div class=\"line\"></div>\n            <div class=\"cvo-col-4\">\n                            </div>\n        </div>\n    </div>\n    <div style=\"clear: both;\"></div>\n    <!-- END #group-content -->\n</div>\n\n<div id=\"cv-watermark\">\n© topcv.vn\n</div>\n                    </div>\n                </div>\n            </div>", "originalBody": "<div id=\"cvo-document\" class=\"cvo-document\">\n                <div class=\"cvo-page\">\n                    <div class=\"cvo-subpage\">\n                        <div id=\"cvo-body\">\n    <div id=\"cvo-top-wrapper\">\n        <div id=\"cvo-top-logo\">\n            <span class=\"cvo-top-logo-color\">Top<span style=\"color: #333333\">Landing</span></span>\n        </div>\n        <div id=\"cvo-top-menu\">\n            <div><span>Certifications</span></div>\n            <div><span>Skills</span></div>\n            <div><span>Activities</span></div>\n            <div><span>Work experience</span></div>\n            <div><span>Education</span></div>\n            <div><span>CAREER OBJECTIVES</span></div>\n        </div>\n    </div>\n    <!--Header-->\n    <div id=\"cvo-wrapper\">\n        <!-- #group-header -->\n        <div id=\"group-header\">\n            <!-- FIXED GROUP -->\n            \n            <div class=\"cvo-block\" id=\"cvo-profile\">\n                <div id=\"cvo-profile-wrapper\">\n                    <div id=\"cvo-profile-info-wrapper\">\n                        <div id=\"cvo-name-title-wrapper\">\n                            <i class=\"fa fa-search\" aria-hidden=\"true\"></i>\n                            <div id=\"cvo-profile-fullname-wraper\">\n                                <span id=\"cvo-profile-fullname\"><strong class=\"ql-font-RobotoCondensed ql-size-23px\">PHAM HA AN</strong></span>\n                            </div>\n                            <div class=\"cvo-profile-cross\">/</div>\n                                                        <div id=\"cvo-profile-title-wraper\">\n                                <span id=\"cvo-profile-title\"><strong class=\"ql-font-BeVietnamPro ql-size-18px\">Consultant</strong></span>\n                            </div>\n                                                    </div>\n                    </div>\n                </div>\n            </div>\n\n                        <div id=\"cvo-objective\" class=\"cvo-block\">\n                <div class=\"freetext-table\">\n                    <div class=\"freetext-table-title full-width cvo-objective-title-wrapper\"><span class=\"block-title\" id=\"cvo-objective-blocktitle\">CAREER OBJECTIVES</span></div>\n                    <div class=\"freetext-table-data full-width\" id=\"cvo-objective-objective\"><p class=\"ql-align-justify\"><span class=\"ql-size-14px\">Customer Consultant with 5 years of experience in product and course consulting at English centers and technology stores. Skilled in identifying potential customers, providing accurate information, and effectively persuading clients. Known for being quick-witted, adaptable, and thriving under pressure. Seeking a Customer Consultant position to contribute to revenue growth and customer acquisition for the company. </span></p></div>\n                </div>\n            </div>\n            \n        </div>\n                <div class=\"cvo-avatar-wrapper\">\n            <img id=\"cvo-profile-avatar\" src=\"/api/cv/source-assets/640cf40b5d4541830388.png\" value=\"preview_avatar\" alt=\"avatar\">\n        </div>\n        \n\n        <div class=\"cvo-profile-contact-info\">\n            <div class=\"contact-item\">\n                <i class=\"fa fa-user\"></i>\n                <div id=\"cvo-profile-gender-wraper\"><span id=\"cvo-profile-gender\"><span class=\"ql-size-13px\">Male/Female/Other</span></span></div>\n                <div id=\"cvo-profile-gender-label-wraper\"><span>Gender</span></div>\n            </div>\n            <div class=\"contact-item\">\n                <i class=\"fa fa-calendar\"></i>\n                <div id=\"cvo-profile-dob-wraper\"><span id=\"cvo-profile-dob\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">August 24, 1996</span></span></div>\n                <div id=\"cvo-profile-dob-label-wraper\"><span>Date of birth</span></div>\n            </div>\n            <div class=\"contact-item\">\n                <i class=\"fa fa-phone\"></i>\n                <div id=\"cvo-profile-phone-wraper\"><span id=\"cvo-profile-phone\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">(024) 6680 5588</span></span></div>\n                <div id=\"cvo-profile-phone-label-wraper\"><span>Phone</span></div>\n            </div>\n            <div class=\"contact-item\">\n                <i class=\"fa fa-envelope\"></i>\n                <div id=\"cvo-profile-email-wraper\"><span id=\"cvo-profile-email\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">hotro@topcv.vn</span></span></div>\n                <div id=\"cvo-profile-email-label-wraper\"><span>Email</span></div>\n            </div>\n            <div class=\"contact-item\">\n                <i class=\"fa fa-map-marker\" aria-hidden=\"true\"></i>\n                <div id=\"cvo-profile-address-wraper\"><span id=\"cvo-profile-address\">Ba Dinh, Ha Noi</span></div>\n                <div id=\"cvo-profile-address-label-wraper\"><span>Address</span></div>\n            </div>\n        </div>\n        <!-- END #group-header -->\n    </div>\n\n    <!-- #group-content -->\n    <div>\n        <div id=\"cvo-education\" class=\"cvo-block\">\n    <h3 class=\"cvo-block-title\"><span id=\"cvo-education-blocktitle\">Education</span></h3>\n    <div id=\"education-table\">\n                                    <div class=\"row cvo-col-4 cvo-education-wrapper \">\n                    <div class=\"cvo-education-icon\">\n                        <i class=\"fa fa-graduation-cap\" aria-hidden=\"true\"></i>\n                    </div>\n                    <div class=\"school\">\n                        <span class=\"cvo-education-school\">TopCV University</span>\n                                                <div class=\"cvo-education-time col-time\">\n                                                        <span class=\"cvo-education-start start\">2016</span>\n                                                                                    -\n                                                                                    <span class=\"cvo-education-end end\">2020</span>\n                                                    </div>\n                                                                            <span class=\"cvo-education-title\">Business Administration</span>\n                                                                                                            <span class=\"cvo-education-details\"><p><span class=\"ql-size-14px\">Excellent</span></p></span>\n                                                                        </div>\n                    <div style=\"clear: both\"></div>\n                </div>\n                        </div>\n</div>\n        <div id=\"cvo-experience\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\">\n        <span id=\"cvo-experience-blocktitle\">Work experience</span>\n    </div>\n\n    <div id=\"experience-table\" class=\"cvo-block-content cvo-block-body\">\n                        <div class=\"row\">\n            <div class=\"cvo-experience-col-left\">\n                <div>\n                    <div class=\"cvo-experience-wrapper\">\n                        <span class=\"cvo-experience-company\">HJS Academy</span><span class=\"cvo-separator\">,&nbsp;</span><span class=\"cvo-experience-position color-highlight\">Consultant</span>                    </div>\n                </div>\n                <div>\n                    <div class=\"row-title\">\n                        <div class=\"cvo-experience-company-wraper\">\n                            <span class=\"cvo-experience-start\">2022</span>\n                            <span><b>&nbsp;-&nbsp;</b></span>\n                            <span class=\"cvo-experience-end\">2025</span>\n                        </div>\n                    </div>\n                    \n                </div>\n            </div>\n            <div class=\"cvo-experience-col-right\">\n                <div class=\"row-details\">\n                    <div class=\"cvo-experience-details color-content\"><ul><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Provided personalized consultation based on student's learning goals. </span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Recommended suitable English courses aligned with students' interests and proficiency levels, clearly explaining course features, benefits, and how they differ from competitors.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Promoted special enrollment promotions and tuition discounts to increase conversion rates, consistently exceeding 150% of assigned KPIs.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Collected and maintained a database of over 5,000 potential learners for nurturing and follow-up, contributing to long-term customer engagement and upselling.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Collaborated with Marketing and Academic departments to develop strategies for customer acquisition and retention, helping increase overall company revenue by 200% within one year. </span></li></ul></div>\n                </div>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>\n                <div class=\"row\">\n            <div class=\"cvo-experience-col-left\">\n                <div>\n                    <div class=\"cvo-experience-wrapper\">\n                        <span class=\"cvo-experience-company\">TopCV BCD Company</span><span class=\"cvo-separator\">,&nbsp;</span><span class=\"cvo-experience-position color-highlight\">Software Solution Consultant</span>                    </div>\n                </div>\n                <div>\n                    <div class=\"row-title\">\n                        <div class=\"cvo-experience-company-wraper\">\n                            <span class=\"cvo-experience-start\">August 2018</span>\n                            <span><b>&nbsp;-&nbsp;</b></span>\n                            <span class=\"cvo-experience-end\">July 2020</span>\n                        </div>\n                    </div>\n                    \n                </div>\n            </div>\n            <div class=\"cvo-experience-col-right\">\n                <div class=\"row-details\">\n                    <div class=\"cvo-experience-details color-content\"><ul><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Searched, consulted, and introduced software and hardware solutions (e.g., printers, barcode scanners) to approximately 50 customers daily, utilizing a database of 5,000 existing contacts and self-sourced 100 new leads per day. </span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Supported and guided customers in using software products both online and onsite, ensuring effective onboarding and usage.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Managed the sales process and contract signing, consistently exceeding 150% of the annual revenue KPI.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Maintained and developed a strong pipeline of potential customers, contributing to long-term business growth. </span></li></ul></div>\n                </div>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>\n                    </div>\n    <div style=\"clear: both\"></div>\n</div>\n\n        <div class=\"group-content-wrapper\">\n            <div class=\"cvo-col-6\">\n                            </div>\n            <div class=\"cvo-col-6\">\n                            </div>\n        </div>\n        <div>\n            <div class=\"cvo-col-4\">\n                <div id=\"cvo-award\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\">\n        <span id=\"cvo-award-blocktitle\">Honors &amp; Awards</span>\n    </div>\n   \n    <div id=\"award-table\" class=\"cvo-block-body\">\n                        <div class=\"row\">\n            <span class=\"cvo-award-time cvo-time\">2020</span>:\n            <span class=\"cvo-award-title color-content\"><p><strong class=\"ql-size-14px\">Best consultant in the third quarter of 2022</strong></p></span>\n            <div style=\"clear:both;\"></div>\n        </div>\n                    </div>\n    <div style=\"clear: both\"></div>\n</div>\n            </div>\n            <div class=\"line\"></div>\n            <div class=\"cvo-col-4\">\n                <div id=\"cvo-certification\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\">\n        <span id=\"cvo-certification-blocktitle\">Certifications</span>\n    </div>\n   \n    <div id=\"certification-table\" cl