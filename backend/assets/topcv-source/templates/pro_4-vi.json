{"body": "<div id=\"cvo-document\" class=\"cvo-document\">\n                <div class=\"cvo-page\">\n                    <div class=\"cvo-subpage\">\n                        <div id=\"cvo-body\">\n    <!--Header-->\n    <div id=\"cvo-main\">\n        <div id=\"col-left\">\n            <!-- #group-top-left -->\n            <div id=\"group-top-left\">\n                <!-- FIXED GROUP -->\n                <div id=\"cvo-profile\" class=\"cvo-block\">\n    <div id=\"profile-title-wrapper\">\n                <div id=\"cvo-profile-avatar-wraper\" class=\"scheme-border-color\">\n            <img id=\"cvo-profile-avatar\" src=\"{{profile.avatar}}\" value=\"preview_avatar\" alt=\"{{profile.fullname}}\">\n        </div>\n                <div>\n            <div id=\"cvo-profile-fullname\" class=\"scheme-color\" contenteditable=\"true\"><strong class=\"end-action ql-size-22px\">{{profile.fullname}}</strong></div>\n                        <div id=\"cvo-profile-title\" class=\"scheme-color\" contenteditable=\"true\"><span class=\"ql-size-18px cvo-profile-info-value\">{{profile.title}}</span></div>\n                    </div>\n    </div>\n    <div id=\"profile-contact-wraper\">\n        <div class=\"cvo-block-title scheme-color scheme-border-color\"><span id=\"cvo-profile-blocktitle\">Thông tin liên hệ</span></div>\n                <div id=\"cvo-profile-dob-wraper\">\n            <i class=\"fa fa-calendar scheme-color\"></i><span id=\"cvo-profile-dob\" class=\"profile-content\" contenteditable=\"true\"><span class=\"end-action ql-size-13px\">{{profile.dob}}</span></span>\n        </div>\n                        <div id=\"cvo-profile-gender-wraper\"><i class=\"fa fa-user scheme-color\"></i><span id=\"cvo-profile-gender\" class=\"profile-content\" contenteditable=\"true\"><span class=\"ql-size-13px\">{{profile.gender}}</span></span></div>\n                <div id=\"cvo-profile-phone-wraper\"><i class=\"fa fa-phone scheme-color\"></i><span id=\"cvo-profile-phone\" class=\"profile-content\" contenteditable=\"true\"><span class=\"end-action ql-size-13px\">{{profile.phone}}</span></span></div>\n        <div id=\"cvo-profile-email-wraper\"><i class=\"fa fa-envelope-square scheme-color\"></i><span id=\"cvo-profile-email\" class=\"profile-content\" contenteditable=\"true\"><span class=\"end-action ql-size-13px\">{{profile.email}}</span></span></div>\n                <div id=\"cvo-profile-address-wraper\"><i class=\"fa fa-map-marker scheme-color\"></i><span id=\"cvo-profile-address\" class=\"profile-content\" contenteditable=\"true\"><span class=\"end-action ql-size-13px\">{{profile.address}}</span></span></div>\n                        <div id=\"cvo-profile-website-wraper\"><i class=\"fa fa-info scheme-color\"></i><span id=\"cvo-profile-website\" class=\"profile-content\" contenteditable=\"true\"><span class=\"ql-size-13px\">{{profile.website}}</span></span></div>\n            </div>\n    <div style=\"clear: both\"></div>\n</div>\n            </div>\n            <!-- END #group-top-left -->\n            <div id=\"group-bottom-left\">\n                            {{?objective}}<div id=\"cvo-objective\" class=\"cvo-block\">\n    <div class=\"cvo-block-title no-horizontal-line scheme-color scheme-border-color\"><span id=\"cvo-objective-blocktitle\">Mục tiêu nghề nghiệp</span></div>\n    <div id=\"cvo-objective-objective\" contenteditable=\"true\"><p class=\"ql-align-justify\">{{objective.objective}}</p></div>\n</div>\n                            {{/objective}}{{?skillrate}}<div id=\"cvo-skillrate\" class=\"cvo-block\">\n    <div class=\"cvo-block-title scheme-color scheme-border-color\"><span id=\"cvo-skillrate-blocktitle\">KỸ NĂNG</span></div>\n    <div id=\"skillrate-table\">\n                        {{#skillrate}}</div>\n</div>\n                            {{/skillrate}}{{?interest}}<div id=\"cvo-interest\" class=\"cvo-block\">\n    <div class=\"cvo-block-title scheme-color scheme-border-color\"><span id=\"cvo-interest-blocktitle\">Sở thích</span></div>\n    <ul id=\"interest-table\">\n                                <li class=\"row\"><span class=\"cvo-interest-details\">Xem phim</span></li>\n                        <li class=\"row\"><span class=\"cvo-interest-details\">Đọc sách</span></li>\n                        </ul>\n    <div style=\"clear: both\"></div>\n</div>\n                        {{/interest}}</div>\n        </div>\n        <!-- END #col-left -->\n        <!-- #col-right -->\n        <div id=\"col-right\">\n            <div id=\"group-col-right\">\n                            {{?education}}<div id=\"cvo-education\" class=\"cvo-block\">\n    <div class=\"cvo-block-title scheme-background-color\">\n        <span id=\"cvo-education-blocktitle\">Học vấn</span>\n    </div>\n    <div id=\"education-table\">\n                        {{#education}}</div>\n</div>\n                            {{/education}}{{?experience}}<div id=\"cvo-experience\" class=\"cvo-block\">\n    <div class=\"cvo-block-title scheme-background-color\"><span id=\"cvo-experience-blocktitle\">Kinh nghiệm làm việc</span></div>\n    <div id=\"experience-table\">\n                        {{#experience}}</div>\n    <div style=\"clear: both\"></div>\n</div>\n                            {{/experience}}{{?activity}}<div id=\"cvo-activity\" class=\"cvo-block\">\n    <div class=\"cvo-block-title scheme-background-color\"><span id=\"cvo-activity-blocktitle\">Hoạt động</span></div>\n    <div id=\"activity-table\">\n                        {{#activity}}</div>\n    <div style=\"clear: both\"></div>\n</div>\n                            {{/activity}}{{?award}}<div id=\"cvo-award\" class=\"cvo-block\">\n    <div class=\"cvo-block-title scheme-background-color\"><span id=\"cvo-award-blocktitle\">Danh hiệu và giải thưởng</span></div>\n    <div id=\"award-table\">\n                        {{#award}}</div>\n    <div style=\"clear: both\"></div>\n</div>\n                            {{/award}}{{?reference}}<div class=\"cvo-block\" id=\"cvo-reference\">\n    <div class=\"cvo-block-title scheme-background-color\"><span id=\"cvo-reference-blocktitle\">Người giới thiệu</span></div>\n    <div id=\"reference-table\">\n                                    {{#reference}}</div>\n    <div style=\"clear: both;\"></div>\n</div>\n                            {{/reference}}{{?certification}}<div id=\"cvo-certification\" class=\"cvo-block\">\n    <div class=\"cvo-block-title scheme-background-color\"><span id=\"cvo-certification-blocktitle\">Chứng chỉ</span></div>\n    <div id=\"certification-table\">\n                        {{#certification}}</div>\n    <div style=\"clear: both\"></div>\n</div>\n                        {{/certification}}</div>\n        </div>\n        <!-- END #col-right -->\n        <div style=\"clear: both;\"></div>\n    </div>\n</div>\n                    </div>\n                </div>\n            </div>", "originalBody": "<div id=\"cvo-document\" class=\"cvo-document\">\n                <div class=\"cvo-page\">\n                    <div class=\"cvo-subpage\">\n                        <div id=\"cvo-body\">\n    <!--Header-->\n    <div id=\"cvo-main\">\n        <div id=\"col-left\">\n            <!-- #group-top-left -->\n            <div id=\"group-top-left\">\n                <!-- FIXED GROUP -->\n                <div id=\"cvo-profile\" class=\"cvo-block\">\n    <div id=\"profile-title-wrapper\">\n                <div id=\"cvo-profile-avatar-wraper\" class=\"scheme-border-color\">\n            <img id=\"cvo-profile-avatar\" src=\"/api/cv/source-assets/640cf40b5d4541830388.png\" value=\"preview_avatar\" alt=\"avatar\">\n        </div>\n                <div>\n            <div id=\"cvo-profile-fullname\" class=\"scheme-color\"><strong class=\"end-action ql-size-22px\">Nguyễn Hoàng Anh</strong></div>\n                        <div id=\"cvo-profile-title\" class=\"scheme-color\"><span class=\"ql-size-18px cvo-profile-info-value\">Nhân viên tư vấn</span></div>\n                    </div>\n    </div>\n    <div id=\"profile-contact-wraper\">\n        <div class=\"cvo-block-title scheme-color scheme-border-color\"><span id=\"cvo-profile-blocktitle\">Thông tin liên hệ</span></div>\n                <div id=\"cvo-profile-dob-wraper\">\n            <i class=\"fa fa-calendar scheme-color\"></i><span id=\"cvo-profile-dob\" class=\"profile-content\"><span class=\"end-action ql-size-13px\">26/05/1996</span></span>\n        </div>\n                        <div id=\"cvo-profile-gender-wraper\"><i class=\"fa fa-user scheme-color\"></i><span id=\"cvo-profile-gender\" class=\"profile-content\"><span class=\"ql-size-13px\">Nam/Nữ/Khác</span></span></div>\n                <div id=\"cvo-profile-phone-wraper\"><i class=\"fa fa-phone scheme-color\"></i><span id=\"cvo-profile-phone\" class=\"profile-content\"><span class=\"end-action ql-size-13px\">(024) 6680 5588</span></span></div>\n        <div id=\"cvo-profile-email-wraper\"><i class=\"fa fa-envelope-square scheme-color\"></i><span id=\"cvo-profile-email\" class=\"profile-content\"><span class=\"end-action ql-size-13px\">hotro@topcv.vn</span></span></div>\n                <div id=\"cvo-profile-address-wraper\"><i class=\"fa fa-map-marker scheme-color\"></i><span id=\"cvo-profile-address\" class=\"profile-content\"><span class=\"end-action ql-size-13px\">Ba Đình, Hà Nội</span></span></div>\n                        <div id=\"cvo-profile-website-wraper\"><i class=\"fa fa-info scheme-color\"></i><span id=\"cvo-profile-website\" class=\"profile-content\"><span class=\"ql-size-13px\">be.net/tencuaban</span></span></div>\n            </div>\n    <div style=\"clear: both\"></div>\n</div>\n            </div>\n            <!-- END #group-top-left -->\n            <div id=\"group-bottom-left\">\n                            <div id=\"cvo-objective\" class=\"cvo-block\">\n    <div class=\"cvo-block-title no-horizontal-line scheme-color scheme-border-color\"><span id=\"cvo-objective-blocktitle\">Mục tiêu nghề nghiệp</span></div>\n    <div id=\"cvo-objective-objective\"><p class=\"ql-align-justify\">Tôi mong muốn ứng tuyển vào vị trí Tổng đài viên Chăm sóc khách hàng để tận dụng 3 năm kinh nghiệm xử lý yêu cầu và phản hồi khách hàng chuyên nghiệp, cùng với khả năng giao tiếp tiếng Anh tốt và tinh thần làm việc năng động, linh hoạt. Mục tiêu của tôi là không ngừng nâng cao trải nghiệm khách hàng, góp phần xây dựng hình ảnh chuyên nghiệp và thân thiện cho doanh nghiệp.</p></div>\n</div>\n                            <div id=\"cvo-skillrate\" class=\"cvo-block\">\n    <div class=\"cvo-block-title scheme-color scheme-border-color\"><span id=\"cvo-skillrate-blocktitle\">KỸ NĂNG</span></div>\n    <div id=\"skillrate-table\">\n                        <div class=\"row\">\n            <div><span class=\"cvo-skillrate-title\">Kỹ năng đàm phán</span></div>\n            <div class=\"cvo-skillrate-bar scheme-border-color\" bval=\"5\" rate-value=\"5\">\n                <span class=\"cvo-skillrate-value scheme-background-color\"></span>\n            </div>\n        </div>\n                <div class=\"row\">\n            <div><span class=\"cvo-skillrate-title\">Kỹ năng thuyết phục</span></div>\n            <div class=\"cvo-skillrate-bar scheme-border-color\" bval=\"5\" rate-value=\"5\">\n                <span class=\"cvo-skillrate-value scheme-background-color\"></span>\n            </div>\n        </div>\n                    </div>\n</div>\n                            <div id=\"cvo-interest\" class=\"cvo-block\">\n    <div class=\"cvo-block-title scheme-color scheme-border-color\"><span id=\"cvo-interest-blocktitle\">Sở thích</span></div>\n    <ul id=\"interest-table\">\n                                <li class=\"row\"><span class=\"cvo-interest-details\">Xem phim</span></li>\n                        <li class=\"row\"><span class=\"cvo-interest-details\">Đọc sách</span></li>\n                        </ul>\n    <div style=\"clear: both\"></div>\n</div>\n                        </div>\n        </div>\n        <!-- END #col-left -->\n        <!-- #col-right -->\n        <div id=\"col-right\">\n            <div id=\"group-col-right\">\n                            <div id=\"cvo-education\" class=\"cvo-block\">\n    <div class=\"cvo-block-title scheme-background-color\">\n        <span id=\"cvo-education-blocktitle\">Học vấn</span>\n    </div>\n    <div id=\"education-table\">\n                        <div class=\"row \">\n            <div class=\"row-title\">\n                <div class=\"cvo-education-first-line\">\n                    <div class=\"cvo-education-school-wraper\">\n                        <span class=\"cvo-education-school\">ĐH TopCV</span>\n                    </div>\n                                        <div class=\"cvo-education-time\">\n                        &nbsp;/&nbsp;&nbsp;<span class=\"cvo-education-start\">2016</span><!--\n                        --><!--\n                        --><!--\n                            -->                            -\n                            <!--\n                        --><!--\n                        --><!--\n                        --><span class=\"cvo-education-end\">2020</span><!--\n                        -->                    </div>\n                                    </div>\n                <div style=\"clear:both;\"></div>\n                                <div>\n                    <span class=\"cvo-education-title\">Quản trị kinh doanh</span>\n                </div>\n                            </div>\n                        <div class=\"row-details\">\n                <div class=\"cvo-education-details\"><p><span class=\"ql-size-13px end-action\">Tốt nghiệp loại Giỏi</span></p></div>\n            </div>\n                        <div style=\"clear:both;\"></div>\n        </div>\n                    </div>\n</div>\n                            <div id=\"cvo-experience\" class=\"cvo-block\">\n    <div class=\"cvo-block-title scheme-background-color\"><span id=\"cvo-experience-blocktitle\">Kinh nghiệm làm việc</span></div>\n    <div id=\"experience-table\">\n                        <div class=\"row \">\n            <div class=\"row-title\">\n                <div class=\"cvo-experience-first-line\">\n                    <div class=\"cvo-experience-company-wraper\">\n                        <span class=\"cvo-experience-company\">SVT Finance Innovation Co.</span>\n                    </div>\n                                        <div class=\"cvo-experience-time\">\n                        &nbsp;/&nbsp;&nbsp;<!--\n                        --><span class=\"cvo-experience-start\">08/2020</span><!--\n                        --><!--\n                        --><!--\n                         -->                            -\n                            <!--\n                        --><!--\n                        --><!--\n                        --><span class=\"cvo-experience-end\">Nay</span><!--\n                        --><!--\n                    --></div><!--\n                    -->                </div>\n                <div style=\"clear:both;\"></div>\n                                <div>\n                    <span class=\"cvo-experience-position\">Tổng Đài Viên Chăm Sóc Khách Hàng</span>\n                </div>\n                            </div>\n            <div class=\"row-details\">\n                <div class=\"cvo-experience-details\"><ul><li class=\"ql-align-justify\">Tiếp nhận và giải đáp thắc mắc của phụ huynh liên quan đến khóa học, lịch học, học phí, chính sách hoàn trả qua điện thoại, Zalo và email.</li><li class=\"ql-align-justify\">Gọi điện nhắc lịch học, lịch kiểm tra, lịch đóng phí và tư vấn các chương trình ưu đãi mới phù hợp với từng nhóm học viên.</li><li class=\"ql-align-justify\">Phối hợp với bộ phận học vụ và giáo viên để xử lý các phản hồi từ phụ huynh về chất lượng giảng dạy hoặc tiến độ học tập của học viên.</li><li class=\"ql-align-justify\">Theo dõi mức độ hài lòng của phụ huynh, ghi nhận các phản hồi và đề xuất cải thiện trải nghiệm dịch vụ.</li><li class=\"ql-align-justify\">Cập nhật và quản lý thông tin khách hàng trên hệ thống CRM, đảm bảo dữ liệu đầy đủ, chính xác và dễ truy xuất.</li><li class=\"ql-align-justify\">Tham gia đào tạo nội bộ và cập nhật kiến thức khóa học để hỗ trợ tư vấn và chăm sóc khách hàng hiệu quả hơn.</li><li class=\"ql-align-justify\">Thành tích:&nbsp;Duy trì tỷ lệ hài lòng của phụ huynh trên 95% trong 12 tháng liên tiếp (dựa trên khảo sát nội bộ sau khóa học).</li></ul></div>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>\n                <div class=\"row \">\n            <div class=\"row-title\">\n                <div class=\"cvo-experience-first-line\">\n                    <div class=\"cvo-experience-company-wraper\">\n                        <span class=\"cvo-experience-company\">SVT Investment &amp; Development Co., Ltd</span>\n                    </div>\n                                        <div class=\"cvo-experience-time\">\n                        &nbsp;/&nbsp;&nbsp;<!--\n                        --><span class=\"cvo-experience-start\">08/2018</span><!--\n                        --><!--\n                        --><!--\n                         -->                            -\n                            <!--\n                        --><!--\n                        --><!--\n                        --><span class=\"cvo-experience-end\">07/2020</span><!--\n                        --><!--\n                    --></div><!--\n                    -->                </div>\n                <div style=\"clear:both;\"></div>\n                                <div>\n                    <span class=\"cvo-experience-position\">Chuyên Viên Tư Vấn Giải Pháp Phần Mềm</span>\n                </div>\n                            </div>\n            <div class=\"row-details\">\n                <div class=\"cvo-experience-details\"><ul><li class=\"ql-align-justify\">Phân tích nhu cầu và quy trình quản lý nhân sự của khách hàng, từ đó đề xuất giải pháp phần mềm chấm công, tính lương, quản lý ca phù hợp.</li><li class=\"ql-align-justify\">Tư vấn giải pháp và trình bày demo sản phẩm cho khách hàng doanh nghiệp, giúp họ hiểu rõ tính năng và lợi ích của phần mềm.</li><li class=\"ql-align-justify\">Làm việc cùng đội ngũ kỹ thuật để tùy chỉnh phần mềm theo yêu cầu đặc thù của từng doanh nghiệp (ca kíp phức tạp, quy định tính công riêng...).</li><li class=\"ql-align-justify\">Hướng dẫn sử dụng phần mềm cho khách hàng (trực tiếp hoặc online), xây dựng tài liệu hướng dẫn, hỗ trợ trong quá trình triển khai ban đầu.</li><li class=\"ql-align-justify\">Theo dõi hiệu quả sau triển khai và hỗ trợ bảo trì, tiếp nhận phản hồi và phối hợp cải tiến giải pháp cho phù hợp với quy mô, nhu cầu thực tế của khách hàng.</li></ul></div>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>\n                    </div>\n    <div style=\"clear: both\"></div>\n</div>\n                            <div id=\"cvo-activity\" class=\"cvo-block\">\n    <div class=\"cvo-block-title scheme-background-color\"><span id=\"cvo-activity-blocktitle\">Hoạt động</span></div>\n    <div id=\"activity-table\">\n                        <div class=\"row \">\n            <div class=\"row-title\">\n                <div class=\"cvo-activity-first-line\">\n                <div class=\"cvo-activity-organization-wraper\">\n                    <span class=\"cvo-activity-organization\">Câu lạc bộ Sự kiện, trường Đại học TopCV</span>\n                </div>\n                                <div class=\"cvo-activity-time\">\n                    &nbsp;/&nbsp;&nbsp;<!--\n                    --><span class=\"cvo-activity-start\">06/2016</span><!--\n                    --><!--\n                    --><!--\n                     -->                        -\n                        <!--\n                    --><!--\n                    --><!--\n                    --><span class=\"cvo-activity-end\">09/2020</span><!--\n                    --><!--\n                --></div>\n                                </div>\n                <div style=\"clear: both;\"></div>\n                                <div>\n                    <span class=\"cvo-activity-position\">Ban Sự Kiện</span>\n                </div>\n                            </div>\n            <div class=\"row-details\">\n                <div class=\"cvo-activity-details\"><ul><li class=\"ql-align-justify\"><span class=\"end-action ql-size-13px\">Xây dựng 5 sự kiện chào đón tân sinh viên với 5000 sinh viên tham gia. </span></li><li class=\"ql-align-justify\"><span class=\"ql-size-13px end-action\">Hỗ trợ 500 tân sinh viên mỗi năm làm hồ sơ, tìm hiểu về nhà trường. </span></li><li class=\"ql-align-justify\"><span class=\"ql-size-13px end-action\">Giao tiếp và hỗ trợ thông tin cho phụ huynh.</span></li></ul></div>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>\n                    </div>\n    <div style=\"clear: both\"></div>\n</div>\n                            <div id=\"cvo-award\" class=\"cvo-block\">\n    <div class=\"cvo-block-title scheme-background-color\"><span id=\"cvo-award-blocktitle\">Danh hiệu và giải thưởng</span></div>\n    <div id=\"award-table\">\n                        <div class=\"row \">\n            <div class=\"row-title\">\n                <div class=\"cvo-award-title-wraper\">\n                    <span class=\"cvo-award-title\"><p><span class=\"ql-size-13px\">Tư vấn viên xuất sắc nhất Quý 3/2020</span></p></span>\n                </div>\n                                <div class=\"cvo-award-time-wraper\">\n                    <span class=\"cvo-award-time\">2020</span>\n                </div>\n                                <div style=\"clear:both;\"></div>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>\n                    </div>\n    <div style=\"clear: both\"></div>\n</div>\n                            <div class=\"cvo-block\" id=\"cvo-reference\">\n    <div class=\"cvo-b