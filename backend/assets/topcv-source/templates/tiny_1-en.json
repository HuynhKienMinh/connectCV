{"body": "<div id=\"cvo-document\" class=\"cvo-document\">\n                <div class=\"cvo-page\">\n                    <div class=\"cvo-subpage\">\n                        <div id=\"cvo-body\">\n    <div id=\"cvo-main\">\n        <div id=\"cvo-header\">\n                        <div id=\"cvo-avatar\">\n                <img id=\"cvo-profile-avatar\" src=\"{{profile.avatar}}\" value=\"preview_avatar\" alt=\"{{profile.fullname}}\">\n            </div>\n                        <p><span id=\"cvo-profile-fullname\" contenteditable=\"true\"><strong class=\"ql-font-RobotoCondensed ql-size-23px\">{{profile.fullname}}</strong></span></p>\n                        <p><span id=\"cvo-profile-title\" contenteditable=\"true\"><strong class=\"ql-font-BeVietnamPro ql-size-18px\">{{profile.title}}</strong></span></p>\n                    </div>\n        <div class=\"cvo-container\">\n            <div id=\"group-col-left\">\n                                    {{?objective}}<div id=\"cvo-objective\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\">\n        <span id=\"cvo-objective-blocktitle\">CAREER OBJECTIVES</span>\n    </div>\n    <div class=\"cvo-block-body\">\n                    <div id=\"cvo-objective-objective\" contenteditable=\"true\"><p class=\"ql-align-justify\"><span class=\"ql-size-14px\">{{objective.objective}}</span></p></div>\n            </div>\n</div>                                    {{/objective}}{{?education}}<div class=\"cvo-block\" id=\"cvo-education\">\n    <div class=\"cvo-block-title\"><span id=\"cvo-education-blocktitle\">Education</span></div>\n    <div class=\"cvo-block-body\" id=\"education-table\">\n                                    {{#education}}</div>\n</div>\n                                    {{/education}}{{?experience}}<div class=\"cvo-block\" id=\"cvo-experience\">\n    <div class=\"cvo-block-title\"><span id=\"cvo-experience-blocktitle\">Work experience</span></div>\n    <div class=\"cvo-block-body\" id=\"experience-table\">\n                            {{#experience}}</div>\n</div>\n                            {{/experience}}</div>\n            <div id=\"col-right\">\n                <div id=\"group-top-right\">\n                    <div class=\"cvo-block\" id=\"cvo-profile\">\n    <div class=\"cvo-block-title\">\n        <span id=\"cvo-profile-blocktitle\">Contact information</span>\n    </div>\n    <div class=\"cvo-block-body\">\n                <div class=\"paragraph\"><span id=\"cvo-profile-dob\" contenteditable=\"true\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">{{profile.dob}}</span></span></div>\n                <div class=\"paragraph\"><span id=\"cvo-profile-phone\" contenteditable=\"true\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">{{profile.phone}}</span></span></div>\n        <div class=\"paragraph\"><span id=\"cvo-profile-email\" contenteditable=\"true\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">{{profile.email}}</span></span></div>\n                <div class=\"paragraph\"><span id=\"cvo-profile-address\" contenteditable=\"true\">{{profile.address}}</span></div>\n            </div>\n</div>                </div>\n                <div id=\"group-bottom-right\">\n                                            {{?certification}}<div class=\"cvo-block\" id=\"cvo-certification\">\n    <div class=\"cvo-block-title\"><span id=\"cvo-certification-blocktitle\">Certifications</span></div>\n    <div class=\"cvo-block-body\" id=\"certification-table\">\n                            {{#certification}}</div>\n</div>\n                                            {{/certification}}{{?award}}<div class=\"cvo-block\" id=\"cvo-award\">\n    <div class=\"cvo-block-title\"><span id=\"cvo-award-blocktitle\">Honors &amp; Awards</span></div>\n    <div class=\"cvo-block-body\" id=\"award-table\">\n                            {{#award}}</div>\n</div>\n                                            {{/award}}{{?skillrate}}<div class=\"cvo-block\" id=\"cvo-skillrate\">\n    <div class=\"cvo-block-title\"><span id=\"cvo-skillrate-blocktitle\">SKILLS</span></div>\n    <div class=\"cvo-block-body\">\n        <div id=\"skillrate-table\">\n                                     {{#skillrate}}</div>\n    </div>\n</div>\n                                    {{/skillrate}}</div>\n            </div>\n            <div style=\"clear: both;\"></div>\n        </div>\n        <div style=\"clear: both;\"></div>\n    </div>\n</div>\n<div id=\"cv-watermark\">\n   © topcv.vn\n</div>\n                    </div>\n                </div>\n            </div>", "originalBody": "<div id=\"cvo-document\" class=\"cvo-document\">\n                <div class=\"cvo-page\">\n                    <div class=\"cvo-subpage\">\n                        <div id=\"cvo-body\">\n    <div id=\"cvo-main\">\n        <div id=\"cvo-header\">\n                        <div id=\"cvo-avatar\">\n                <img id=\"cvo-profile-avatar\" src=\"/api/cv/source-assets/640cf40b5d4541830388.png\" value=\"preview_avatar\" alt=\"avatar\">\n            </div>\n                        <p><span id=\"cvo-profile-fullname\"><strong class=\"ql-font-RobotoCondensed ql-size-23px\">PHAM HA AN</strong></span></p>\n                        <p><span id=\"cvo-profile-title\"><strong class=\"ql-font-BeVietnamPro ql-size-18px\">Consultant</strong></span></p>\n                    </div>\n        <div class=\"cvo-container\">\n            <div id=\"group-col-left\">\n                                    <div id=\"cvo-objective\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\">\n        <span id=\"cvo-objective-blocktitle\">CAREER OBJECTIVES</span>\n    </div>\n    <div class=\"cvo-block-body\">\n                    <div id=\"cvo-objective-objective\"><p class=\"ql-align-justify\"><span class=\"ql-size-14px\">Customer Consultant with 5 years of experience in product and course consulting at English centers and technology stores. Skilled in identifying potential customers, providing accurate information, and effectively persuading clients. Known for being quick-witted, adaptable, and thriving under pressure. Seeking a Customer Consultant position to contribute to revenue growth and customer acquisition for the company. </span></p></div>\n            </div>\n</div>                                    <div class=\"cvo-block\" id=\"cvo-education\">\n    <div class=\"cvo-block-title\"><span id=\"cvo-education-blocktitle\">Education</span></div>\n    <div class=\"cvo-block-body\" id=\"education-table\">\n                                    <div class=\"row\">\n                    <div class=\"paragraph cvo-highlight\">\n                        <span class=\"cvo-education-school\">TopCV University</span>\n                                                    [<!--\n                            --><span class=\"cvo-education-start start\">2016</span>\n                                                                                         -\n                                                                                    <span class=\"cvo-education-end end\">2020</span><!--\n                            -->]\n                                            </div>\n                                        <div class=\"paragraph\"><span class=\"cvo-education-title\">Business Administration</span></div>\n                                                                                            <div class=\"paragraph\"><span class=\"cvo-education-details\"><p><span class=\"ql-size-14px\">Excellent</span></p></span></div>\n                                                            </div>\n                        </div>\n</div>\n                                    <div class=\"cvo-block\" id=\"cvo-experience\">\n    <div class=\"cvo-block-title\"><span id=\"cvo-experience-blocktitle\">Work experience</span></div>\n    <div class=\"cvo-block-body\" id=\"experience-table\">\n                            <div class=\"row\">\n                <div class=\"paragraph cvo-highlight\">\n                    <span class=\"cvo-experience-company\">HJS Academy</span>\n                                                    [<!--\n                            --><span class=\"cvo-experience-start start\">2022</span>\n                                                                                         -\n                                                                                    <span class=\"cvo-experience-end end\">2025</span><!--\n                            -->]\n                                        </div>\n                                    <div class=\"paragraph\"><span class=\"cvo-experience-position\">Consultant</span></div>\n                                                    <div class=\"paragraph\"><span class=\"cvo-experience-details\"><ul><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Provided personalized consultation based on student's learning goals. </span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Recommended suitable English courses aligned with students' interests and proficiency levels, clearly explaining course features, benefits, and how they differ from competitors.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Promoted special enrollment promotions and tuition discounts to increase conversion rates, consistently exceeding 150% of assigned KPIs.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Collected and maintained a database of over 5,000 potential learners for nurturing and follow-up, contributing to long-term customer engagement and upselling.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Collaborated with Marketing and Academic departments to develop strategies for customer acquisition and retention, helping increase overall company revenue by 200% within one year. </span></li></ul></span></div>\n                            </div>\n                        <div class=\"row\">\n                <div class=\"paragraph cvo-highlight\">\n                    <span class=\"cvo-experience-company\">TopCV BCD Company</span>\n                                                    [<!--\n                            --><span class=\"cvo-experience-start start\">August 2018</span>\n                                                                                         -\n                                                                                    <span class=\"cvo-experience-end end\">July 2020</span><!--\n                            -->]\n                                        </div>\n                                    <div class=\"paragraph\"><span class=\"cvo-experience-position\">Software Solution Consultant</span></div>\n                                                    <div class=\"paragraph\"><span class=\"cvo-experience-details\"><ul><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Searched, consulted, and introduced software and hardware solutions (e.g., printers, barcode scanners) to approximately 50 customers daily, utilizing a database of 5,000 existing contacts and self-sourced 100 new leads per day. </span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Supported and guided customers in using software products both online and onsite, ensuring effective onboarding and usage.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Managed the sales process and contract signing, consistently exceeding 150% of the annual revenue KPI.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Maintained and developed a strong pipeline of potential customers, contributing to long-term business growth. </span></li></ul></span></div>\n                            </div>\n                        </div>\n</div>\n                            </div>\n            <div id=\"col-right\">\n                <div id=\"group-top-right\">\n                    <div class=\"cvo-block\" id=\"cvo-profile\">\n    <div class=\"cvo-block-title\">\n        <span id=\"cvo-profile-blocktitle\">Contact information</span>\n    </div>\n    <div class=\"cvo-block-body\">\n                <div class=\"paragraph\"><span id=\"cvo-profile-dob\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">August 24, 1996</span></span></div>\n                <div class=\"paragraph\"><span id=\"cvo-profile-phone\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">(024) 6680 5588</span></span></div>\n        <div class=\"paragraph\"><span id=\"cvo-profile-email\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">hotro@topcv.vn</span></span></div>\n                <div class=\"paragraph\"><span id=\"cvo-profile-address\">Ba Dinh, Ha Noi</span></div>\n            </div>\n</div>                </div>\n                <div id=\"group-bottom-right\">\n                                            <div class=\"cvo-block\" id=\"cvo-certification\">\n    <div class=\"cvo-block-title\"><span id=\"cvo-certification-blocktitle\">Certifications</span></div>\n    <div class=\"cvo-block-body\" id=\"certification-table\">\n                            <div class=\"row\">\n                <div class=\"paragraph cvo-highlight\">\n                    <span class=\"cvo-certification-title\"><p><strong class=\"ql-size-14px\">Training Program: Telephone Selling Skills</strong></p></span>\n                                                    [<span class=\"cvo-certification-time time\">2022</span>]\n                                        </div>\n            </div>\n                        <div class=\"row\">\n                <div class=\"paragraph cvo-highlight\">\n                    <span class=\"cvo-certification-title\"><p><strong class=\"ql-size-14px\">Professional Customer Care Management training course</strong></p></span>\n                                                    [<span class=\"cvo-certification-time time\">2021</span>]\n                                        </div>\n            </div>\n                        </div>\n</div>\n                                            <div class=\"cvo-block\" id=\"cvo-award\">\n    <div class=\"cvo-block-title\"><span id=\"cvo-award-blocktitle\">Honors &amp; Awards</span></div>\n    <div class=\"cvo-block-body\" id=\"award-table\">\n                            <div class=\"row\">\n                <div class=\"paragraph cvo-highlight\">\n                    <span class=\"cvo-award-title\"><p><strong class=\"ql-size-14px\">Best consultant in the third quarter of 2022</strong></p></span>\n                                                    [<span class=\"cvo-award-time time\">2020</span>]\n                                        </div>\n            </div>\n                        </div>\n</div>\n                                            <div class=\"cvo-block\" id=\"cvo-skillrate\">\n    <div class=\"cvo-block-title\"><span id=\"cvo-skillrate-blocktitle\">SKILLS</span></div>\n    <div class=\"cvo-block-body\">\n        <div id=\"skillrate-table\">\n                                     <div class=\"row\">\n                <div class=\"cvo-skillrate-title-wraper\"><span class=\"cvo-skillrate-title\">Customer Needs Analysis</span></div>\n                <div class=\"cvo-skillrate-bar\" bval=\"5\" rate-value=\"5\">\n                    <span class=\"cvo-skillrate-value\"></span>\n                </div>\n                <div style=\"clear: both;\"></div>\n            </div>\n                         <div class=\"row\">\n                <div class=\"cvo-skillrate-title-wraper\"><span class=\"cvo-skillrate-title\">Market Research &amp; Client Profiling</span></div>\n                <div class=\"cvo-skillrate-bar\" bval=\"5\" rate-value=\"5\">\n                    <span class=\"cvo-skillrate-value\"></span>\n                </div>\n                <div style=\"clear: both;\"></div>\n            </div>\n                         <div class=\"row\">\n                <div class=\"cvo-skillrate-title-wraper\"><span class=\"cvo-skillrate-title\">Sales Pitch &amp; Persuasive Communication</span></div>\n                <div class=\"cvo-skillrate-bar\" bval=\"5\" rate-value=\"5\">\n                    <span class=\"cvo-skillrate-value\"></span>\n                </div>\n                <div style=\"clear: both;\"></div>\n            </div>\n                         <div class=\"row\">\n                <div class=\"cvo-skillrate-title-wraper\"><span class=\"cvo-skillrate-title\">CRM Systems (e.g., Salesforce, HubSpot)</span></div>\n                <div class=\"cvo-skillrate-bar\" bval=\"5\" rate-value=\"5\">\n                    <span class=\"cvo-skillrate-value\"></span>\n                </div>\n                <div style=\"clear: both;\"></div>\n            </div>\n                         <div class=\"row\">\n                <div class=\"cvo-skillrate-title-wraper\"><span class=\"cvo-skillrate-title\">Microsoft Office Suite (Excel, Word, PowerPoint)</span></div>\n                <div class=\"cvo-skillrate-bar\" bval=\"5\" rate-value=\"5\">\n                    <span class=\"cvo-skillrate-value\"></span>\n                </div>\n                <div style=\"clear: both;\"></div>\n            </div>\n                                </div>\n    </div>\n</div>\n                                    </div>\n            </div>\n            <div style=\"clear: both;\"></div>\n        </div>\n        <div style=\"clear: both;\"></div>\n    </div>\n</div>\n<div id=\"cv-watermark\">\n   © topcv.vn\n</div>\n                    </div>\n                </div>\n            </div>", "rows": {"experience": "<div class=\"row\">\n                <div class=\"paragraph cvo-highlight\">\n                    <span class=\"cvo-experience-company\" contenteditable=\"true\">{{experience.company}}</span>\n                                                    [<!--\n                            --><span class=\"cvo-experience-start start\" contenteditable=\"true\">{{experience.start}}</span>\n                                                                                         -\n                                                                                    <span class=\"cvo-experience-end end\" contenteditable=\"true\">{{experience.end}}</span><!--\n                            -->]\n                                        </div>\n                                    <div class=\"paragraph\"><span class=\"cvo-experience-position\" contenteditable=\"true\">{{experience.position}}</span></div>\n                                                    <div class=\"paragraph\"><span class=\"cvo-experience-details\" contenteditable=\"true\">{{!experience.details}}</span></div>\n                            </div>", "education": "<div class=\"row\">\n                    <div class=\"paragraph cvo-highlight\">\n                        <span class=\"cvo-education-school\" contenteditable=\"true\">{{education.school}}</span>\n                                                    [<!--\n                            --><span class=\"cvo-education-start start\" contenteditable=\"true\">{{education.start}}</span>\n                                                                                         -\n                                                                                    <span class=\"cvo-education-end end\" contenteditable=\"true\">{{education.end}}</span><!--\n                            -->]\n                                            </div>\n                                        <div class=\"paragraph\"><span class=\"cvo-education-title\" contenteditable=\"true\">{{education.title}}</span></div>\n                                                                                            <div class=\"paragraph\"><span class=\"cvo-education-details\" contenteditable=\"true\"><p><span class=\"ql-size-14px\">{{education.details}}</span></p></span></div>\n                                                            </div>", "skillrate": "<div class=\"row\">\n                <div class=\"cvo-skillrate-title-wraper\"><span class=\"cvo-skillrate-title\" contenteditable=\"true\">{{skillrate.title}}</span></div>\n                <div class=\"cvo-skillrate-bar\" bval=\"5\" rate-value=\"5\">\n                    <span class=\"cvo-skillrate-value\"></span>\n                </div>\n                <div style=\"clear: both;\"></div>\n            </div>", "award": "<div class=\"row\">\n                <div class=\"paragraph cvo-highlight\">\n                    <span class=\"cvo-award-title\" contenteditable=\"true\"><p><strong class=\"ql-size-14px\">{{award.title}}</strong></p></span>\n                                                    [<span class=\"cvo-award-time time\" contenteditable=\"true\">{{award.time}}</span>]\n                                        </div>\n            </div>", "certification": "<div class=\"row\">\n                <div class=\"paragraph cvo-highlight\">\n                    <span class=\"cvo-certification-title\" contenteditable=\"true\"><p><strong class=\"ql-size-14px\">{{certification.title}}</strong></p></span>\n                                                    [<span class=\"cvo-certification-time time\" contenteditable=\"true\">{{certification.time}}</span>]\n                                        </div>\n            </div>"}, "rich": {"experience.details": {"before": "<ul>", "item": "<li class=\"ql-align-justify\"><span class=\"ql-size-14px\">{{.}}</span></li>", "after": "</ul>"}}, "cssFiles": ["96a83096b07c340646e1.css", "9c7d63ccc93f634ecf68.css", "883bd085469c4754d68a.css", "1eab4a161a635d7b907d.css", "86cc20d2f25b13832014.css", "a3b1f0f65d52171c74f1.css", "cf5fa69d993d15a8dc95.css", "581f531bf0f484dc9fbc.css", "31649e0fc45729300251.css", "acb3f9d98586f0fe8aad.css", "e63e448ff512d9cbe09d.css", "9989f6c9652651a36899.css", "73d377c3d4ab57940cc3.css", "3454a12f65b2d0d923ce.css", "75a11da44c802486bc6f.css"], "source": "tiny_1-en", "newBuilder": false, "errors": [], "rootConfig": {"bodyClass": "iframe", "htmlStyle": ""}}