killgroup\" class=\"cvo-block\"><div class=\"cvo-block-title\">\n        <span class=\"cvo-block-title-span\">\n            <span id=\"cvo-skillgroup-blocktitle\">Skills</span>\n        </span>\n    </div>\n    <div id=\"skillgroup-table\" class=\"block-content\">{{#skillgroup}}</div></div>{{/skillgroup}}{{?award}}<div id=\"cvo-award\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\">\n        <span class=\"cvo-block-title-span\">\n            <span id=\"cvo-award-blocktitle\">Honors &amp; Awards</span>\n        </span>\n        \n    </div>\n    <div id=\"award-table\">\n                        {{#award}}</div>\n    <div style=\"clear: both\"></div>\n</div>\n                                {{/award}}{{?certification}}<div id=\"cvo-certification\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\">\n        <span class=\"cvo-block-title-span\">\n            <span id=\"cvo-certification-blocktitle\">Certifications</span>\n        </span>\n        \n    </div>\n    <div id=\"certification-table\">\n                        {{#certification}}</div>\n    <div style=\"clear: both\"></div>\n</div>\n                            {{/certification}}</div>\n            <div style=\"clear: both;\"></div>\n        </div>\n    </div>\n</div>\n<div id=\"cv-watermark\">© topcv.vn</div>\n                    </div>\n                </div>\n            </div>", "originalBody": "<div id=\"cvo-document\" class=\"cvo-document\">\n                <div class=\"cvo-page\">\n                    <div class=\"cvo-subpage\">\n                        <div id=\"cvo-body\">\n    <!--Header-->\n    <div id=\"top-group-header\">\n        <div class=\"top-group-header-left\">\n            <div class=\"index-icon\">\n            </div>\n            <div class=\"search-bar\">\n                <i class=\"fa fa-search\" style=\"margin-right: 8px;\"></i>Potential candidate\n            </div>\n            <div style=\"clear: both;\">\n            </div>\n        </div>\n        <div class=\"top-group-header-right\">\n            <div class=\"right-icon-wrapper\">\n                <i class=\"fa fa-caret-down right-icon\"></i>\n            </div>\n            <div class=\"right-icon-wrapper\">\n                <i class=\"fa fa-comments right-icon\"></i>\n            </div>\n            <div class=\"right-icon-wrapper\">\n                <i class=\"fa fa-bell right-icon\"></i>\n            </div>\n            <div class=\"right-icon-wrapper\">\n                <i class=\"fa fa-plus right-icon\"></i>\n            </div>\n        </div>\n    </div>\n    <div>\n        <div id=\"group-header\">\n            <!-- Profile info -->\n            <div class=\"avatar-wrapper\">\n                                <!-- <img id=\"cvo-profile-avatar\" src=\"/api/cv/source-assets/640cf40b5d4541830388.png\" value=\"preview_avatar\" alt=\"avatar\"> -->\n                <img id=\"cvo-profile-avatar\" src=\"/api/cv/source-assets/640cf40b5d4541830388.png\" value=\"preview_avatar\" alt=\"avatar\">\n                            </div>\n            <div class=\"short-profile-info\">\n                <div id=\"cvo-profile-fullname\">\n                    <strong class=\"ql-font-RobotoCondensed ql-size-23px\">PHAM HA AN</strong>\n                </div>\n                <div style=\"clear: both;\"></div>\n                <div id=\"cvo-profile-title\">\n                    <strong class=\"ql-font-BeVietnamPro ql-size-18px\">Consultant</strong>\n                </div>\n            </div>\n            <div class=\"right-button\">\n                <div class=\"follow-button\">\n                    <span>Follow</span>\n                </div>\n                <div class=\"action-button\">\n                    <i class=\"fa fa-comments\"></i>\n                </div>\n                <div class=\"action-button\">\n                    <i class=\"fa fa-ellipsis-h\"></i>\n                </div>\n            </div>\n            <div style=\"clear: both;\"></div>\n        </div>\n        <div style=\"clear: both;\"></div>\n        <div id=\"cvo-main\">\n            <div id=\"group-left\">\n                <!-- for profile info and objective -->\n                <div class=\"cvo-block\" id=\"intro-section\">\n                    <div class=\"cvo-block-title\">\n                        <span class=\"cvo-block-title-span\">\n                            <span>Introduction</span>\n                        </span>\n                    </div>\n                    <div class=\"block-content\">\n                        <div class=\"cvo-profile-info-row\" id=\"cvo-profile-email-wraper\">\n                            <span class=\"cvo-profile-label\">\n                                <i class=\"fa fa-envelope-square profile-icon\"></i>\n                                Email:\n                            </span>\n                            <span class=\"cvo-profile-info-value\" id=\"cvo-profile-email\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">hotro@topcv.vn</span></span>\n                        </div>\n                        <div class=\"cvo-profile-info-row\" id=\"cvo-profile-phone-wraper\">\n                            <span class=\"cvo-profile-label\">\n                                <i class=\"fa fa-phone profile-icon\"></i>\n                                Phone:\n                            </span>\n                            <span class=\"cvo-profile-info-value\" id=\"cvo-profile-phone\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">(024) 6680 5588</span></span>\n                        </div>\n                                                <div class=\"cvo-profile-info-row\" id=\"cvo-profile-gender-wraper\">\n                            <span class=\"cvo-profile-label\">\n                                <i class=\"fa fa-user profile-icon\"></i>\n                                Gender:\n                            </span>\n                            <span class=\"cvo-profile-info-value\" id=\"cvo-profile-gender\">\n                                <span class=\"ql-size-13px\">Male/Female/Other</span>\n                            </span>\n                        </div>\n                                                                        <div class=\"cvo-profile-info-row\" id=\"cvo-profile-dob-wraper\">\n                            <span class=\"cvo-profile-label\">\n                                <i class=\"fa fa-calendar profile-icon\"></i>\n                                Date of birth:\n                            </span>\n                            <span class=\"cvo-profile-info-value\" id=\"cvo-profile-dob\">\n                                <span class=\"ql-size-13px ql-font-BeVietnamPro\">August 24, 1996</span>\n                            </span>\n                        </div>\n                                                                        <div class=\"cvo-profile-info-row\" id=\"cvo-profile-address-wraper\">\n                            <span class=\"cvo-profile-label\">\n                                <i class=\"fa fa-home profile-icon\"></i>\n                                Address:\n                            </span>\n                            <span class=\"cvo-profile-info-value\" id=\"cvo-profile-address\">Ba Dinh, Ha Noi</span>\n                        </div>\n                                            </div>\n                    <div id=\"cvo-objective\">\n                        <div class=\"block-title-section-content\">\n                            <div class=\"cvo-profile-info-row\">\n                                <span class=\"cvo-profile-label\">\n                                    <i class=\"fa fa-info profile-icon\"></i>\n                                    <span id=\"cvo-objective-blocktitle\">\n                                        CAREER OBJECTIVES\n                                    </span>\n                                </span>\n                            </div>\n                            <div id=\"cvo-objective-objective\"><p class=\"ql-align-justify\"><span class=\"ql-size-14px\">Customer Consultant with 5 years of experience in product and course consulting at English centers and technology stores. Skilled in identifying potential customers, providing accurate information, and effectively persuading clients. Known for being quick-witted, adaptable, and thriving under pressure. Seeking a Customer Consultant position to contribute to revenue growth and customer acquisition for the company. </span></p></div>\n                        </div>\n                    </div>\n                </div>\n                <div id=\"group-col-left\">\n                                    </div>\n            </div>\n            <div id=\"group-col-right\">\n                                <div id=\"cvo-experience\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\">\n        <span class=\"cvo-block-title-span\">\n            <span id=\"cvo-experience-blocktitle\">Work experience</span>\n        </span>\n    </div>\n    <div id=\"experience-table\" class=\"cvo-block-content\">\n                        <div class=\"row\">\n            <div>\n                <div class=\"cvo-experience-wrapper\">\n                    <span>\n                        <span class=\"background-block-icon\"><i class=\"fa fa-briefcase icon-wrapper\"></i></span>\n                        <span class=\"cvo-experience-company\">\n                            HJS Academy</span></span><span class=\"cvo-separator\">,&nbsp;</span><span class=\"cvo-experience-position\">Consultant</span>                </div>\n            </div>\n            <div>\n                <div class=\"row-title\">\n                    <div class=\"cvo-experience-company-wraper\">\n                        <span class=\"cvo-experience-start\">2022</span>\n                        <span><b>&nbsp;-&nbsp;</b></span>\n                        <span class=\"cvo-experience-end\">2025</span>\n                    </div>\n                </div>\n                <div class=\"row-details\">\n                    <div class=\"cvo-experience-details color-content\"><ul><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Provided personalized consultation based on student's learning goals. </span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Recommended suitable English courses aligned with students' interests and proficiency levels, clearly explaining course features, benefits, and how they differ from competitors.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Promoted special enrollment promotions and tuition discounts to increase conversion rates, consistently exceeding 150% of assigned KPIs.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Collected and maintained a database of over 5,000 potential learners for nurturing and follow-up, contributing to long-term customer engagement and upselling.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Collaborated with Marketing and Academic departments to develop strategies for customer acquisition and retention, helping increase overall company revenue by 200% within one year. </span></li></ul></div>\n                </div>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>\n                <div class=\"row\">\n            <div>\n                <div class=\"cvo-experience-wrapper\">\n                    <span>\n                        <span class=\"background-block-icon\"><i class=\"fa fa-briefcase icon-wrapper\"></i></span>\n                        <span class=\"cvo-experience-company\">\n                            TopCV BCD Company</span></span><span class=\"cvo-separator\">,&nbsp;</span><span class=\"cvo-experience-position\">Software Solution Consultant</span>                </div>\n            </div>\n            <div>\n                <div class=\"row-title\">\n                    <div class=\"cvo-experience-company-wraper\">\n                        <span class=\"cvo-experience-start\">August 2018</span>\n                        <span><b>&nbsp;-&nbsp;</b></span>\n                        <span class=\"cvo-experience-end\">July 2020</span>\n                    </div>\n                </div>\n                <div class=\"row-details\">\n                    <div class=\"cvo-experience-details color-content\"><ul><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Searched, consulted, and introduced software and hardware solutions (e.g., printers, barcode scanners) to approximately 50 customers daily, utilizing a database of 5,000 existing contacts and self-sourced 100 new leads per day. </span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Supported and guided customers in using software products both online and onsite, ensuring effective onboarding and usage.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Managed the sales process and contract signing, consistently exceeding 150% of the annual revenue KPI.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Maintained and developed a strong pipeline of potential customers, contributing to long-term business growth. </span></li></ul></div>\n                </div>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>\n                    </div>\n    <div style=\"clear: both\"></div>\n</div>\n                                <div id=\"cvo-education\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\">\n        <span class=\"cvo-block-title-span\">\n            <span id=\"cvo-education-blocktitle\">Education</span>\n        </span>\n    </div>\n    <div id=\"education-table\" class=\"cvo-block-content\">\n                        <div class=\"row\">\n            <div>\n                <div class=\"cvo-title-wrapper\">\n                    <span>\n                        <span class=\"background-block-icon\"><i class=\"fa fa-graduation-cap icon-wrapper\"></i></span>\n                        <span class=\"cvo-education-school\">\n                            TopCV University</span></span><span class=\"cvo-separator\">,&nbsp;</span><span class=\"cvo-education-title\">Business Administration</span>                </div>\n                <div class=\"cvo-education-time cvo-time-wraper\">\n                    <span class=\"cvo-education-start\">2016</span>\n                    <span><b>&nbsp;-&nbsp;</b></span>\n                    <span class=\"cvo-education-end\">2020</span>\n                </div>\n            </div>\n            <div>\n                <div class=\"row-details\">\n                                        <div class=\"cvo-education-details color-content\"><p><span class=\"ql-size-14px\">Excellent</span></p></div>\n                                    </div>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>\n                    </div>\n    <div style=\"clear: both\"></div>\n</div>\n                                <div id=\"cvo-award\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\">\n        <span class=\"cvo-block-title-span\">\n            <span id=\"cvo-award-blocktitle\">Honors &amp; Awards</span>\n        </span>\n        \n    </div>\n    <div id=\"award-table\">\n                        <div class=\"row\">\n            <span class=\"cvo-award-time cvo-time\">2020</span>:\n            <span class=\"cvo-award-title color-content\"><p><strong class=\"ql-size-14px\">Best consultant in the third quarter of 2022</strong></p></span>\n            <div style=\"clear:both;\"></div>\n        </div>\n                    </div>\n    <div style=\"clear: both\"></div>\n</div>\n                                <div id=\"cvo-certification\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\">\n        <span class=\"cvo-block-title-span\">\n            <span id=\"cvo-certification-blocktitle\">Certifications</span>\n        </span>\n        \n    </div>\n    <div id=\"certification-table\">\n                        <div class=\"row\">\n            <span class=\"cvo-certification-time cvo-time\">2022</span>:\n            <span class=\"cvo-certification-title color-content\"><p><strong class=\"ql-size-14px\">Training Program: Telephone Selling Skills</strong></p></span>\n            <div style=\"clear:both;\"></div>\n        </div>\n                <div class=\"row\">\n            <span class=\"cvo-certification-time cvo-time\">2021</span>:\n            <span class=\"cvo-certification-title color-content\"><p><strong class=\"ql-size-14px\">Professional Customer Care Management training course</strong></p></span>\n            <div style=\"clear:both;\"></div>\n        </div>\n                    </div>\n    <div style=\"clear: both\"></div>\n</div>\n                            </div>\n            <div style=\"clear: both;\"></div>\n        </div>\n    </div>\n</div>\n<div id=\"cv-watermark\">© topcv.vn</div>\n                    </div>\n                </div>\n            </div>", "rows": {"experience": "<div class=\"row\">\n            <div>\n                <div class=\"cvo-experience-wrapper\">\n                    <span>\n                        <span class=\"background-block-icon\"><i class=\"fa fa-briefcase icon-wrapper\"></i></span>\n                        <span class=\"cvo-experience-company\" contenteditable=\"true\">{{experience.company}}</span></span><span class=\"cvo-separator\">, </span><span class=\"cvo-experience-position\" contenteditable=\"true\">{{experience.position}}</span>                </div>\n            </div>\n            <div>\n                <div class=\"row-title\">\n                    <div class=\"cvo-experience-company-wraper\">\n                        <span class=\"cvo-experience-start\" contenteditable=\"true\">{{experience.start}}</span>\n                        <span><b> - </b></span>\n                        <span class=\"cvo-experience-end\" contenteditable=\"true\">{{experience.end}}</span>\n                    </div>\n                