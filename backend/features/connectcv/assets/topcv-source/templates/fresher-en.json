cvo-block-title\">\n        <span class=\"cvo-block-title-span\">\n            <span id=\"cvo-education-blocktitle\" class=\"block-break-word\">Education</span>\n        </span>\n    </div>\n    <div id=\"education-table\" class=\"cvo-block-content cvo-block-body\">\n                        {{#education}}</div>\n    <div style=\"clear: both\"></div>\n</div>\n                                {{/education}}{{?skillgroup}}<div id=\"cvo-skillgroup\" class=\"cvo-block\"><div class=\"cvo-block-title\">\n        <span class=\"cvo-block-title-span\">\n            <span id=\"cvo-skillgroup-blocktitle\" class=\"block-break-word\">Skills</span>\n        </span>\n    </div>\n    <div id=\"skillgroup-table\" class=\"block-content\">{{#skillgroup}}</div></div>{{/skillgroup}}{{?award}}<div id=\"cvo-award\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\">\n        <span class=\"cvo-block-title-span\">\n            <span id=\"cvo-award-blocktitle\" class=\"block-break-word\">Honors &amp; Awards</span>\n        </span>\n    </div>\n    <div id=\"award-table\" class=\"cvo-block-body\">\n                        {{#award}}</div>\n    <div style=\"clear: both\"></div>\n</div>\n                                {{/award}}{{?certification}}<div id=\"cvo-certification\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\">\n        <span class=\"cvo-block-title-span\">\n            <span id=\"cvo-certification-blocktitle\" class=\"block-break-word\">Certifications</span>\n        </span>\n    </div>\n    <div id=\"certification-table\" class=\"cvo-block-body\">\n                        {{#certification}}</div>\n    <div style=\"clear: both\"></div>\n</div>\n                            {{/certification}}</div>\n            <div id=\"group-col-right\">\n                                {{?experience}}<div id=\"cvo-experience\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\">\n        <span class=\"cvo-block-title-span\">\n            <span id=\"cvo-experience-blocktitle\" class=\"block-break-word\">Work experience</span>\n        </span>\n    </div>\n    <div id=\"experience-table\" class=\"cvo-block-content cvo-block-body\">\n                        {{#experience}}</div>\n    <div style=\"clear: both\"></div>\n</div>\n                            {{/experience}}</div>\n            <div id=\"cvo-footer-image\"></div>\n            <div style=\"clear: both;\"></div>\n        </div>\n    </div>\n</div>\n<div id=\"cv-watermark\">© topcv.vn</div>\n                    </div>\n                </div>\n            </div>", "originalBody": "<div id=\"cvo-document\" class=\"cvo-document\">\n                <div class=\"cvo-page\">\n                    <div class=\"cvo-subpage\">\n                        <div id=\"cvo-body\">\n    <!--Header-->\n    <div>\n        <div id=\"group-header\">\n            <!-- Profile info -->\n            <div id=\"cvo-header-left\">\n                <div class=\"avatar-wrapper\">\n                                            <img id=\"cvo-profile-avatar\" src=\"/api/cv/source-assets/640cf40b5d4541830388.png\" value=\"preview_avatar\" alt=\"avatar\">\n                                    </div>\n            </div>\n            <div id=\"cvo-header-right\">\n                <div class=\"short-profile-info\">\n                    <div style=\"width: 100%;\">\n                        <span id=\"cvo-profile-fullname\" class=\"block-break-word\"><strong class=\"ql-font-RobotoCondensed ql-size-23px\">PHAM HA AN</strong></span>\n                        <div style=\"clear: both;\"></div>\n                    </div>\n                    <div style=\"width: 100%; padding: 8px 0;\">\n                        <span id=\"cvo-profile-title\" class=\"change-color block-break-word\"><strong class=\"ql-font-BeVietnamPro ql-size-18px\">Consultant</strong></span>\n                    </div>\n                </div>\n                <div class=\"detail-profile-info\">\n                    <div class=\"row-info-item block-break-word\">\n                        <span class=\"row-info-item-icon\"><i class=\"fa fa-calendar\" aria-hidden=\"true\"></i></span>\n                        <span class=\"row-info-item-value\" id=\"cvo-profile-dob\">&lt;span class=\"ql-size-13px ql-font-BeVietnamPro\"&gt;August 24, 1996&lt;/span&gt;</span>\n                    </div>\n                    <div class=\"row-info-item block-break-word\">\n                        <span class=\"row-info-item-icon\"><i class=\"fa fa-envelope-o\" aria-hidden=\"true\"></i></span>\n                        <span class=\"row-info-item-value\" id=\"cvo-profile-email\">&lt;span class=\"ql-size-13px ql-font-BeVietnamPro\"&gt;hotro@topcv.vn&lt;/span&gt;</span>\n                    </div>\n                    <div class=\"row-info-item block-break-word\">\n                        <span class=\"row-info-item-icon\"><i class=\"fa fa-tablet profile-icon\" aria-hidden=\"true\"></i></span>\n                        <span class=\"row-info-item-value\" id=\"cvo-profile-phone\">&lt;span class=\"ql-size-13px ql-font-BeVietnamPro\"&gt;(024) 6680 5588&lt;/span&gt;</span>\n                    </div>\n                    <div class=\"row-info-item block-break-word\" style=\"width: 100%;\">\n                        <span class=\"row-info-item-icon\"><i class=\"fa fa-home\" aria-hidden=\"true\"></i></span>\n                        <span class=\"row-info-item-value\" id=\"cvo-profile-address\">Ba Dinh, Ha Noi</span>\n                    </div>\n                    <div style=\"clear: both;\"></div>\n                </div>\n            </div>\n        </div>\n        <div style=\"clear: both;\"></div>\n        <div class=\"icon-img-1\">\n            <div class=\"icon-img-1-wapper\"></div>\n        </div>\n        <div class=\"cvo-objective-block\">\n            <span id=\"cvo-objective-objective\" class=\"block-break-word\"><p class=\"ql-align-justify\"><span class=\"ql-size-14px\">Customer Consultant with 5 years of experience in product and course consulting at English centers and technology stores. Skilled in identifying potential customers, providing accurate information, and effectively persuading clients. Known for being quick-witted, adaptable, and thriving under pressure. Seeking a Customer Consultant position to contribute to revenue growth and customer acquisition for the company. </span></p></span>\n        </div>\n        <div class=\"icon-img-2\">\n            <div class=\"icon-img-2-wapper\"></div>\n        </div>\n        <div class=\"icon-img-3\">\n            <div class=\"icon-img-3-wapper\"></div>\n        </div>\n        <div class=\"icon-img-4\">\n            <div class=\"icon-img-4-wapper\"></div>\n        </div>\n        <div class=\"icon-img-5\">\n            <div class=\"icon-img-5-wapper\"></div>\n        </div>\n        <div id=\"cvo-main\">\n            <div id=\"group-col-left\">\n                                <div id=\"cvo-education\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\">\n        <span class=\"cvo-block-title-span\">\n            <span id=\"cvo-education-blocktitle\" class=\"block-break-word\">Education</span>\n        </span>\n    </div>\n    <div id=\"education-table\" class=\"cvo-block-content cvo-block-body\">\n                        <div class=\"row\">\n            <div>\n                <div class=\"cvo-title-wrapper\">\n                        <span class=\"cvo-education-school change-color\">TopCV University</span>\n                </div>\n                <div class=\"cvo-education-time cvo-time-wraper\">\n                    <span class=\"cvo-education-start\">2016</span>\n                    <span><b>&nbsp;-&nbsp;</b></span>\n                    <span class=\"cvo-education-end\">2020</span>\n                </div>\n                <div style=\"padding-top: 5px\">\n                <span class=\"cvo-education-title\">Business Administration</span>                </div>\n            </div>\n            <div>\n                <div class=\"row-details\">\n                                        <div class=\"cvo-education-details color-content\"><p><span class=\"ql-size-14px\">Excellent</span></p></div>\n                                    </div>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>\n                    </div>\n    <div style=\"clear: both\"></div>\n</div>\n                                <div id=\"cvo-award\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\">\n        <span class=\"cvo-block-title-span\">\n            <span id=\"cvo-award-blocktitle\" class=\"block-break-word\">Honors &amp; Awards</span>\n        </span>\n    </div>\n    <div id=\"award-table\" class=\"cvo-block-body\">\n                        <div class=\"row\">\n            <div>\n                <span class=\"cvo-award-time cvo-time change-color\">2020</span>\n            </div>\n            <div style=\"padding-top: 5px\">\n                <span class=\"cvo-award-title color-content\"><p><strong class=\"ql-size-14px\">Best consultant in the third quarter of 2022</strong></p></span>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>\n                    </div>\n    <div style=\"clear: both\"></div>\n</div>\n                                <div id=\"cvo-certification\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\">\n        <span class=\"cvo-block-title-span\">\n            <span id=\"cvo-certification-blocktitle\" class=\"block-break-word\">Certifications</span>\n        </span>\n    </div>\n    <div id=\"certification-table\" class=\"cvo-block-body\">\n                        <div class=\"row\">\n            <div>\n                <span class=\"cvo-certification-time cvo-time change-color\">2022</span>\n            </div>\n            <div style=\"padding-top: 5px\">\n                <span class=\"cvo-certification-title color-content\"><p><strong class=\"ql-size-14px\">Training Program: Telephone Selling Skills</strong></p></span>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>\n                <div class=\"row\">\n            <div>\n                <span class=\"cvo-certification-time cvo-time change-color\">2021</span>\n            </div>\n            <div style=\"padding-top: 5px\">\n                <span class=\"cvo-certification-title color-content\"><p><strong class=\"ql-size-14px\">Professional Customer Care Management training course</strong></p></span>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>\n                    </div>\n    <div style=\"clear: both\"></div>\n</div>\n                            </div>\n            <div id=\"group-col-right\">\n                                <div id=\"cvo-experience\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\">\n        <span class=\"cvo-block-title-span\">\n            <span id=\"cvo-experience-blocktitle\" class=\"block-break-word\">Work experience</span>\n        </span>\n    </div>\n    <div id=\"experience-table\" class=\"cvo-block-content cvo-block-body\">\n                        <div class=\"row\">\n            <div>\n                <div class=\"cvo-experience-wrapper\">\n                    <span>\n                        <span class=\"cvo-experience-company change-color\">\n                            HJS Academy\n                        </span>\n                    </span>\n                </div>\n            </div>\n            <div>\n                <div class=\"row-title\">\n                    <div class=\"cvo-experience-company-wraper\">\n                        <span class=\"cvo-experience-start\">2022</span>\n                        <span><b>&nbsp;-&nbsp;</b></span>\n                        <span class=\"cvo-experience-end\">2025</span>\n                    </div>\n                </div>\n                <span class=\"cvo-experience-position\">Consultant</span>                <div class=\"row-details\">\n                    <div class=\"cvo-experience-details color-content\"><ul><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Provided personalized consultation based on student's learning goals. </span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Recommended suitable English courses aligned with students' interests and proficiency levels, clearly explaining course features, benefits, and how they differ from competitors.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Promoted special enrollment promotions and tuition discounts to increase conversion rates, consistently exceeding 150% of assigned KPIs.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Collected and maintained a database of over 5,000 potential learners for nurturing and follow-up, contributing to long-term customer engagement and upselling.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Collaborated with Marketing and Academic departments to develop strategies for customer acquisition and retention, helping increase overall company revenue by 200% within one year. </span></li></ul></div>\n                </div>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>\n                <div class=\"row\">\n            <div>\n                <div class=\"cvo-experience-wrapper\">\n                    <span>\n                        <span class=\"cvo-experience-company change-color\">\n                            TopCV BCD Company\n                        </span>\n                    </span>\n                </div>\n            </div>\n            <div>\n                <div class=\"row-title\">\n                    <div class=\"cvo-experience-company-wraper\">\n                        <span class=\"cvo-experience-start\">August 2018</span>\n                        <span><b>&nbsp;-&nbsp;</b></span>\n                        <span class=\"cvo-experience-end\">July 2020</span>\n                    </div>\n                </div>\n                <span class=\"cvo-experience-position\">Software Solution Consultant</span>                <div class=\"row-details\">\n                    <div class=\"cvo-experience-details color-content\"><ul><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Searched, consulted, and introduced software and hardware solutions (e.g., printers, barcode scanners) to approximately 50 customers daily, utilizing a database of 5,000 existing contacts and self-sourced 100 new leads per day. </span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Supported and guided customers in using software products both online and onsite, ensuring effective onboarding and usage.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Managed the sales process and contract signing, consistently exceeding 150% of the annual revenue KPI.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Maintained and developed a strong pipeline of potential customers, contributing to long-term business growth. </span></li></ul></div>\n                </div>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>\n                    </div>\n    <div style=\"clear: both\"></div>\n</div>\n                            </div>\n            <div id=\"cvo-footer-image\"></div>\n            <div style=\"clear: both;\"></div>\n        </div>\n    </div>\n</div>\n<div id=\"cv-watermark\">© topcv.vn</div>\n                    </div>\n                </div>\n            </div>", "rows": {"experience": "<div class=\"row\">\n            <div>\n                <div class=\"cvo-experience-wrapper\">\n                    <span>\n                        <span class=\"cvo-experience-company change-color\" contenteditable=\"true\">{{experience.company}}</span>\n                    </span>\n                </div>\n            </div>\n            <div>\n                <div class=\"row-title\">\n                    <div class=\"cvo-experience-company-wraper\">\n                        <span class=\"cvo-experience-start\" contenteditable=\"true\">{{experience.start}}</span>\n                        <span><b> - </b></span>\n                        <span class=\"cvo-experience-end\" contenteditable=\"true\">{{experience.end}}</span>\n                    </div>\n                </div>\n                <span class=\"cvo-experience-position\" contenteditable=\"true\">{{experience.position}}</span>                <div class=\"row-details\">\n                    <div class=\"cvo-experience-details color-content\" contenteditable=\"true\">{{!experience.details}}</div>\n                </div>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>", "education": "<div class=\"row\">\n            <div>\n                <div class=\"cvo-title-wrapper\">\n                        <span class=\"cvo-education-school change-color\" contenteditable=\"true\">{{education.school}}</span>\n                </div>\n                <div class=\"cvo-education-time cvo-time-wraper\">\n                    <span class=\"cvo-education-start\" contenteditable=\"true\">{{education.start}}</span>\n                    <span><b> - </b></span>\n                    <span class=\"cvo-education-end\" contenteditable=\"true\">{{education.end}}</span>\n                </div>\n                <div style=\"padding-top: 5px\">\n                <span class=\"cvo-education-title\" contenteditable=\"true\">{{education.title}}</span>                </div>\n            </div>\n            <div>\n                <div class=\"row-details\">\n                                        <div class=\"cvo-education-details color-content\" contenteditable=\"true\"><p><span class=\"ql-size-14px\">{{education.details}}</span></p></div>\n                                    </div>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>", "skillgroup": "<div class=\"row\"><span class=\"cvo-skillgroup-area\" contenteditable=\"true\">{{skillgroup.area}}</span></div>", "award": "<div class=\"row\">\n            <div>\n                <span class=\"cvo-award-time cvo-time change-color\" contenteditable=\"true\">{{award.time}}</span>\n            </div>\n            <div style=\"padding-top: 5px\">\n                <span class=\"cvo-award-title color-content\" contenteditable=\"true\"><p><strong class=\"ql-size-14px\">{{award.title}}</strong></p></span>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>", "certification": "<div class=\"row\">\n            <div>\n                <span class=\"cvo-certification-time cvo-time change-color\" contenteditable=\"true\">{{certification.time}}</span>\n            </div>\n            <div style=\"padding-top: 5px\">\n                <span class=\"cvo-certification-title color-content\" contenteditable=\"true\"><p><strong class=\"ql-size-14px\">{{certification.title}}</strong></p></span>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>"}, "rich": {"experience.details": {"before": "<ul>", "item": "<li class=\"ql-align-justify\"><span class=\"ql-size-14px\">{{.}}</span></li>", "after": "</ul>"}}, "cssFiles": ["96a83096b07c340646e1.css", "9c7d63ccc93f634ecf68.css", "883bd085469c4754d68a.css", "1eab4a161a635d7b907d.css", "86cc20d2f25b13832014.css", "a3b1f0f65d52171c74f1.css", "cf5fa69d993d15a8dc95.css", "d45c280e149b594194ac.css", "31649e0fc45729300251.css", "acb3f9d98586f0fe8aad.css", "e63e448ff512d9cbe09d.css", "9989f6c9652651a36899.css", "73d377c3d4ab57940cc3.css", "3454a12f65b2d0d923ce.css", "75a11da44c802486bc6f.css"], "source": "fresher-en", "newBuilder": false, "errors": [], "rootConfig": {"bodyClass": "iframe", "htmlStyle": ""}}