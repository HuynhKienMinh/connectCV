{"body": "<div id=\"cvo-document\" class=\"cvo-document\">\n                <div class=\"cvo-page\">\n                    <div class=\"cvo-subpage\">\n                        <div id=\"cvo-body\">\n    <!--Header-->\n    <div id=\"group-header\">\n        <div id=\"cvo-profile\" class=\"cvo-block\">\n    <div class=\"header-top\">\n        <div id=\"cvo-header-top-left\">\n            <span id=\"cvo-profile-fullname\" class=\"color-highlight\" contenteditable=\"true\"><strong class=\"ql-font-RobotoCondensed ql-size-23px\">{{profile.fullname}}</strong></span><br>\n                        <span id=\"cvo-profile-title\" class=\"color-content\" contenteditable=\"true\"><strong class=\"ql-font-BeVietnamPro ql-size-18px\">{{profile.title}}</strong></span>\n                        <hr>\n        </div>\n        <div id=\"cvo-header-top-right\">\n                        <div id=\"cvo-profile-avatar-wraper\">\n                <img id=\"cvo-profile-avatar\" src=\"{{profile.avatar}}\" value=\"preview_avatar\" alt=\"{{profile.fullname}}\">\n            </div>\n                    </div>\n        <div style=\"clear: both\"></div>\n    </div>\n    <div id=\"cvo-header-bottom\">\n        <i class=\"fa fa-envelope\"></i> <span id=\"cvo-profile-email\" contenteditable=\"true\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">{{profile.email}}</span></span>\n        <i class=\"fa fa-phone\"></i> <span id=\"cvo-profile-phone\" contenteditable=\"true\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">{{profile.phone}}</span></span>\n                <i class=\"fa fa-map-marker\"></i> <span id=\"cvo-profile-address\" contenteditable=\"true\">{{profile.address}}</span>\n                <div style=\"clear: both\"></div>\n    </div>\n</div>    </div>\n    <div id=\"cvo-main\">\n        <div id=\"group-middle\">\n                            {{?objective}}<div id=\"cvo-objective\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\"><span id=\"cvo-objective-blocktitle\">CAREER OBJECTIVES</span></div>\n    <div id=\"cvo-objective-objective\" contenteditable=\"true\"><p class=\"ql-align-justify\"><span class=\"ql-size-14px\">{{objective.objective}}</span></p></div>\n    <div style=\"clear: both\"></div>\n</div>\n                            {{/objective}}{{?education}}<div id=\"cvo-education\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\"><span id=\"cvo-education-blocktitle\">Education</span></div>\n    <div id=\"education-table\">\n                        {{#education}}</div>\n</div>\n                            {{/education}}{{?experience}}<div id=\"cvo-experience\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\"><span id=\"cvo-experience-blocktitle\">Work experience</span></div>\n    <div id=\"experience-table\">\n                        {{#experience}}</div>\n    <div style=\"clear: both\"></div>\n</div>\n                            {{/experience}}{{?certification}}<div id=\"cvo-certification\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\"><span id=\"cvo-certification-blocktitle\">Certifications</span></div>\n    <div id=\"certification-table\">\n                        {{#certification}}</div>\n    <div style=\"clear: both\"></div>\n</div>\n                            {{/certification}}{{?award}}<div id=\"cvo-award\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\"><span id=\"cvo-award-blocktitle\">Honors &amp; Awards</span></div>\n    <div id=\"award-table\">\n                        {{#award}}</div>\n    <div style=\"clear: both\"></div>\n</div>\n                    {{/award}}</div>\n        <div id=\"group-footer\">\n                            {{?skillrate}}<div id=\"cvo-skillrate\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\"><span id=\"cvo-skillrate-blocktitle\">SKILLS</span></div>\n    <div id=\"skillrate-table\">\n                         {{#skillrate}}</div>\n</div>\n                    {{/skillrate}}</div>\n        <div style=\"clear: both;\"></div>\n    </div>\n</div>\n<div id=\"cv-watermark\">\n   © topcv.vn\n</div>\n                    </div>\n                </div>\n            </div>", "originalBody": "<div id=\"cvo-document\" class=\"cvo-document\">\n                <div class=\"cvo-page\">\n                    <div class=\"cvo-subpage\">\n                        <div id=\"cvo-body\">\n    <!--Header-->\n    <div id=\"group-header\">\n        <div id=\"cvo-profile\" class=\"cvo-block\">\n    <div class=\"header-top\">\n        <div id=\"cvo-header-top-left\">\n            <span id=\"cvo-profile-fullname\" class=\"color-highlight\"><strong class=\"ql-font-RobotoCondensed ql-size-23px\">PHAM HA AN</strong></span><br>\n                        <span id=\"cvo-profile-title\" class=\"color-content\"><strong class=\"ql-font-BeVietnamPro ql-size-18px\">Consultant</strong></span>\n                        <hr>\n        </div>\n        <div id=\"cvo-header-top-right\">\n                        <div id=\"cvo-profile-avatar-wraper\">\n                <img id=\"cvo-profile-avatar\" src=\"/api/cv/source-assets/640cf40b5d4541830388.png\" value=\"preview_avatar\" alt=\"avatar\">\n            </div>\n                    </div>\n        <div style=\"clear: both\"></div>\n    </div>\n    <div id=\"cvo-header-bottom\">\n        <i class=\"fa fa-envelope\"></i> <span id=\"cvo-profile-email\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">hotro@topcv.vn</span></span>\n        <i class=\"fa fa-phone\"></i> <span id=\"cvo-profile-phone\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">(024) 6680 5588</span></span>\n                <i class=\"fa fa-map-marker\"></i> <span id=\"cvo-profile-address\">Ba Dinh, Ha Noi</span>\n                <div style=\"clear: both\"></div>\n    </div>\n</div>    </div>\n    <div id=\"cvo-main\">\n        <div id=\"group-middle\">\n                            <div id=\"cvo-objective\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\"><span id=\"cvo-objective-blocktitle\">CAREER OBJECTIVES</span></div>\n    <div id=\"cvo-objective-objective\"><p class=\"ql-align-justify\"><span class=\"ql-size-14px\">Customer Consultant with 5 years of experience in product and course consulting at English centers and technology stores. Skilled in identifying potential customers, providing accurate information, and effectively persuading clients. Known for being quick-witted, adaptable, and thriving under pressure. Seeking a Customer Consultant position to contribute to revenue growth and customer acquisition for the company. </span></p></div>\n    <div style=\"clear: both\"></div>\n</div>\n                            <div id=\"cvo-education\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\"><span id=\"cvo-education-blocktitle\">Education</span></div>\n    <div id=\"education-table\">\n                        <div class=\"row\">\n            <div class=\"row-col-time\">\n                <div class=\"row-com-name\">\n                    <div class=\"cvo-education-school-wraper\">\n                        <span class=\"cvo-education-school\">TopCV University</span>\n                    </div>\n                </div>\n                 <div class=\"cvo-education-time\"><!--\n                    --><span class=\"cvo-education-start\">2016</span><!--\n                    -->                        -\n                        <!--\n                    --><span class=\"cvo-education-end\">2020</span>                </div>\n            </div>\n            <div class=\"row-col-data\">\n                <div class=\"row-title\">\n                                        <span class=\"cvo-education-title color-highlight\">Business Administration</span>\n                                    </div>\n                <div class=\"row-details\">\n                                        <div class=\"cvo-education-details color-content\"><p><span class=\"ql-size-14px\">Excellent</span></p></div>\n                                    </div>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>\n                    </div>\n</div>\n                            <div id=\"cvo-experience\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\"><span id=\"cvo-experience-blocktitle\">Work experience</span></div>\n    <div id=\"experience-table\">\n                        <div class=\"row\">\n            <div class=\"row-col-time\">\n                <div class=\"row-com-name\">\n                    <div class=\"cvo-experience-company-wraper\">\n                        <span class=\"cvo-experience-company\">HJS Academy</span>\n                    </div>\n                </div>\n                <div class=\"cvo-experience-time\"><!--\n                    --><span class=\"cvo-experience-start\">2022</span><!--\n                    -->                        -\n                        <!--\n                    --><span class=\"cvo-experience-end\">2025</span>                </div>\n            </div>\n            <div class=\"row-col-data\">\n                <div class=\"row-title\">\n                                            <span class=\"cvo-experience-position color-highlight\">Consultant</span>\n                                    </div>\n                <div class=\"row-details\">\n                    <div class=\"cvo-experience-details color-content\"><ul><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Provided personalized consultation based on student's learning goals. </span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Recommended suitable English courses aligned with students' interests and proficiency levels, clearly explaining course features, benefits, and how they differ from competitors.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Promoted special enrollment promotions and tuition discounts to increase conversion rates, consistently exceeding 150% of assigned KPIs.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Collected and maintained a database of over 5,000 potential learners for nurturing and follow-up, contributing to long-term customer engagement and upselling.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Collaborated with Marketing and Academic departments to develop strategies for customer acquisition and retention, helping increase overall company revenue by 200% within one year. </span></li></ul></div>\n                </div>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>\n                <div class=\"row\">\n            <div class=\"row-col-time\">\n                <div class=\"row-com-name\">\n                    <div class=\"cvo-experience-company-wraper\">\n                        <span class=\"cvo-experience-company\">TopCV BCD Company</span>\n                    </div>\n                </div>\n                <div class=\"cvo-experience-time\"><!--\n                    --><span class=\"cvo-experience-start\">August 2018</span><!--\n                    -->                        -\n                        <!--\n                    --><span class=\"cvo-experience-end\">July 2020</span>                </div>\n            </div>\n            <div class=\"row-col-data\">\n                <div class=\"row-title\">\n                                            <span class=\"cvo-experience-position color-highlight\">Software Solution Consultant</span>\n                                    </div>\n                <div class=\"row-details\">\n                    <div class=\"cvo-experience-details color-content\"><ul><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Searched, consulted, and introduced software and hardware solutions (e.g., printers, barcode scanners) to approximately 50 customers daily, utilizing a database of 5,000 existing contacts and self-sourced 100 new leads per day. </span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Supported and guided customers in using software products both online and onsite, ensuring effective onboarding and usage.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Managed the sales process and contract signing, consistently exceeding 150% of the annual revenue KPI.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Maintained and developed a strong pipeline of potential customers, contributing to long-term business growth. </span></li></ul></div>\n                </div>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>\n                    </div>\n    <div style=\"clear: both\"></div>\n</div>\n                            <div id=\"cvo-certification\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\"><span id=\"cvo-certification-blocktitle\">Certifications</span></div>\n    <div id=\"certification-table\">\n                        <div class=\"row\">\n            <div class=\"row-col-time\">\n                <span class=\"cvo-certification-time\">2022</span>\n            </div>\n            <div class=\"row-col-data\">\n                <div>\n                    <span class=\"cvo-certification-title color-content\"><p><strong class=\"ql-size-14px\">Training Program: Telephone Selling Skills</strong></p></span>\n                </div>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>\n                <div class=\"row\">\n            <div class=\"row-col-time\">\n                <span class=\"cvo-certification-time\">2021</span>\n            </div>\n            <div class=\"row-col-data\">\n                <div>\n                    <span class=\"cvo-certification-title color-content\"><p><strong class=\"ql-size-14px\">Professional Customer Care Management training course</strong></p></span>\n                </div>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>\n                    </div>\n    <div style=\"clear: both\"></div>\n</div>\n                            <div id=\"cvo-award\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\"><span id=\"cvo-award-blocktitle\">Honors &amp; Awards</span></div>\n    <div id=\"award-table\">\n                        <div class=\"row\">\n            <div class=\"row-col-time\">\n                <span class=\"cvo-award-time\">2020</span>\n            </div>\n            <div class=\"row-col-data\">\n                <div>\n                    <span class=\"cvo-award-title color-content\"><p><strong class=\"ql-size-14px\">Best consultant in the third quarter of 2022</strong></p></span>\n                </div>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>\n                    </div>\n    <div style=\"clear: both\"></div>\n</div>\n                    </div>\n        <div id=\"group-footer\">\n                            <div id=\"cvo-skillrate\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\"><span id=\"cvo-skillrate-blocktitle\">SKILLS</span></div>\n    <div id=\"skillrate-table\">\n                         <div class=\"row\">\n            <div class=\"skill-title\"><span class=\"cvo-skillrate-title color-content\">Customer Needs Analysis</span></div>\n            <div class=\"cvo-skillrate-bar\" bval=\"5\" rate-value=\"5\">\n                <span class=\"cvo-skillrate-value\"></span>\n            </div>\n            <div style=\"clear: both;\"></div>\n        </div>\n                 <div class=\"row\">\n            <div class=\"skill-title\"><span class=\"cvo-skillrate-title color-content\">Market Research &amp; Client Profiling</span></div>\n            <div class=\"cvo-skillrate-bar\" bval=\"5\" rate-value=\"5\">\n                <span class=\"cvo-skillrate-value\"></span>\n            </div>\n            <div style=\"clear: both;\"></div>\n        </div>\n                 <div class=\"row\">\n            <div class=\"skill-title\"><span class=\"cvo-skillrate-title color-content\">Sales Pitch &amp; Persuasive Communication</span></div>\n            <div class=\"cvo-skillrate-bar\" bval=\"5\" rate-value=\"5\">\n                <span class=\"cvo-skillrate-value\"></span>\n            </div>\n            <div style=\"clear: both;\"></div>\n        </div>\n                 <div class=\"row\">\n            <div class=\"skill-title\"><span class=\"cvo-skillrate-title color-content\">CRM Systems (e.g., Salesforce, HubSpot)</span></div>\n            <div class=\"cvo-skillrate-bar\" bval=\"5\" rate-value=\"5\">\n                <span class=\"cvo-skillrate-value\"></span>\n            </div>\n            <div style=\"clear: both;\"></div>\n        </div>\n                 <div class=\"row\">\n            <div class=\"skill-title\"><span class=\"cvo-skillrate-title color-content\">Microsoft Office Suite (Excel, Word, PowerPoint)</span></div>\n            <div class=\"cvo-skillrate-bar\" bval=\"5\" rate-value=\"5\">\n                <span class=\"cvo-skillrate-value\"></span>\n            </div>\n            <div style=\"clear: both;\"></div>\n        </div>\n                    </div>\n</div>\n                    </div>\n        <div style=\"clear: both;\"></div>\n    </div>\n</div>\n<div id=\"cv-watermark\">\n   © topcv.vn\n</div>\n                    </div>\n                </div>\n            </div>", "rows": {"experience": "<div class=\"row\">\n            <div class=\"row-col-time\">\n                <div class=\"row-com-name\">\n                    <div class=\"cvo-experience-company-wraper\">\n                        <span class=\"cvo-experience-company\" contenteditable=\"true\">{{experience.company}}</span>\n                    </div>\n                </div>\n                <div class=\"cvo-experience-time\"><!--\n                    --><span class=\"cvo-experience-start\" contenteditable=\"true\">{{experience.start}}</span><!--\n                    -->                        -\n                        <!--\n                    --><span class=\"cvo-experience-end\" contenteditable=\"true\">{{experience.end}}</span>                </div>\n            </div>\n            <div class=\"row-col-data\">\n                <div class=\"row-title\">\n                                            <span class=\"cvo-experience-position color-highlight\" contenteditable=\"true\">{{experience.position}}</span>\n                                    </div>\n                <div class=\"row-details\">\n                    <div class=\"cvo-experience-details color-content\" contenteditable=\"true\">{{!experience.details}}</div>\n                </div>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>", "education": "<div class=\"row\">\n            <div class=\"row-col-time\">\n                <div class=\"row-com-name\">\n                    <div class=\"cvo-education-school-wraper\">\n                        <span class=\"cvo-education-school\" contenteditable=\"true\">{{education.school}}</span>\n                    </div>\n                </div>\n                 <div class=\"cvo-education-time\"><!--\n                    --><span class=\"cvo-education-start\" contenteditable=\"true\">{{education.start}}</span><!--\n                    -->                        -\n                        <!--\n                    --><span class=\"cvo-education-end\" contenteditable=\"true\">{{education.end}}</span>                </div>\n            </div>\n            <div class=\"row-col-data\">\n                <div class=\"row-title\">\n                                        <span class=\"cvo-education-title color-highlight\" contenteditable=\"true\">{{education.title}}</span>\n                                    </div>\n                <div class=\"row-details\">\n                                        <div class=\"cvo-education-details color-content\" contenteditable=\"true\"><p><span class=\"ql-size-14px\">{{education.details}}</span></p></div>\n                                    </div>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>", "skillrate": "<div class=\"row\">\n            <div class=\"skill-title\"><span class=\"cvo-skillrate-title color-content\" contenteditable=\"true\">{{skillrate.title}}</span></div>\n            <div class=\"cvo-skillrate-bar\" bval=\"5\" rate-value=\"5\">\n                <span class=\"cvo-skillrate-value\"></span>\n            </div>\n            <div style=\"clear: both;\"></div>\n        </div>", "award": "<div class=\"row\">\n            <div class=\"row-col-time\">\n                <span class=\"cvo-award-time\" contenteditable=\"true\">{{award.time}}</span>\n            </div>\n            <div class=\"row-col-data\">\n                <div>\n                    <span class=\"cvo-award-title color-content\" contenteditable=\"true\"><p><strong class=\"ql-size-14px\">{{award.title}}</strong></p></span>\n                </div>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>", "certification": "<div class=\"row\">\n            <div class=\"row-col-time\">\n                <span class=\"cvo-certification-time\" contenteditable=\"true\">{{certification.time}}</span>\n            </div>\n            <div class=\"row-col-data\">\n                <div>\n                    <span class=\"cvo-certification-title color-content\" contenteditable=\"true\"><p><strong class=\"ql-size-14px\">{{certification.title}}</strong></p></span>\n                </div>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>"}, "rich": {"experience.details": {"before": "<ul>", "item": "<li class=\"ql-align-justify\"><span class=\"ql-size-14px\">{{.}}</span></li>", "after": "</ul>"}}, "cssFiles": ["96a83096b07c340646e1.css", "9c7d63ccc93f634ecf68.css", "883bd085469c4754d68a.css", "1eab4a161a635d7b907d.css", "86cc20d2f25b13832014.css", "a3b1f0f65d52171c74f1.css", "cf5fa69d993d15a8dc95.css", "a773b1d6ca2d51c357e0.css", "31649e0fc45729300251.css", "acb3f9d98586f0fe8aad.css", "e63e448ff512d9cbe09d.css", "9989f6c9652651a36899.css", "73d377c3d4ab57940c