            </div>\n                <div class=\"action-icon\">\n                    <i class=\"fa fa-heart\" style=\"color: #69c3a2;\"></i>\n                </div>\n                <div class=\"action-icon\">\n                    <i class=\"fa fa-bolt\" style=\"color: #885da6;\"></i>\n                </div>\n            </div>\n            <span id=\"cvo-profile-fullname\" contenteditable=\"true\"><strong class=\"end-action ql-size-22px\">{{profile.fullname}}</strong></span><br>\n        </div>\n    </div>\n    <div id=\"profile-contact-wraper\">\n        <div class=\"cvo-profile-info-row\" id=\"cvo-profile-email-wraper\">\n            <span class=\"cvo-profile-label\">\n                <i class=\"fa fa-envelope-square icon-wrapper\"></i>\n                Email:\n            </span>\n            <span class=\"cvo-profile-info-value\" id=\"cvo-profile-email\" contenteditable=\"true\"><span class=\"end-action ql-size-13px\">{{profile.email}}</span></span>\n        </div>\n        <div class=\"cvo-profile-info-row\" id=\"cvo-profile-phone-wraper\">\n            <span class=\"cvo-profile-label\">\n                <i class=\"fa fa-phone icon-wrapper\"></i>\n                Điện thoại:\n            </span>\n            <span class=\"cvo-profile-info-value\" id=\"cvo-profile-phone\" contenteditable=\"true\"><span class=\"end-action ql-size-13px\">{{profile.phone}}</span></span>\n        </div>\n                <div class=\"cvo-profile-info-row\" id=\"cvo-profile-gender-wraper\">\n            <span class=\"cvo-profile-label\">\n                <i class=\"fa fa-user icon-wrapper\"></i>\n                Giới tính:\n            </span>\n            <span class=\"cvo-profile-info-value\" id=\"cvo-profile-gender\" contenteditable=\"true\"><span class=\"ql-size-13px\">{{profile.gender}}</span></span>\n        </div>\n                        <div class=\"cvo-profile-info-row\" id=\"cvo-profile-dob-wraper\">\n            <span class=\"cvo-profile-label\">\n                <i class=\"fa fa-calendar icon-wrapper\"></i>\n                Ngày sinh:\n            </span>\n            <span class=\"cvo-profile-info-value\" id=\"cvo-profile-dob\" contenteditable=\"true\"><span class=\"end-action ql-size-13px\">{{profile.dob}}</span></span>\n        </div>\n                        <div class=\"cvo-profile-info-row\" id=\"cvo-profile-address-wraper\">\n            <span class=\"cvo-profile-label\">\n                <i class=\"fa fa-home icon-wrapper\"></i>\n                Địa chỉ:\n            </span>\n            <span class=\"cvo-profile-info-value\" id=\"cvo-profile-address\" contenteditable=\"true\"><span class=\"end-action ql-size-13px\">{{profile.address}}</span></span>\n        </div>\n            </div>\n    <div style=\"clear: both\"></div>\n</div>            </div>\n            <!-- END #group-top-left -->\n            <div id=\"group-bottom-left\">\n                                {{?objective}}<div id=\"cvo-objective\" class=\"cvo-block\">\n    <div class=\"block-title-section-content\">\n        <div class=\"cvo-profile-info-row\">\n            <span class=\"cvo-profile-label\">\n                <i class=\"fa fa-calendar icon-wrapper\"></i>\n                <span id=\"cvo-objective-blocktitle\">\n                    Mục tiêu nghề nghiệp\n                </span>\n            </span>\n        </div>\n        <div id=\"cvo-objective-objective\" contenteditable=\"true\"><p class=\"ql-align-justify\">{{objective.objective}}</p></div>\n    </div>\n</div>                            {{/objective}}</div>\n        </div>\n        <!-- END #col-left -->\n        <!-- #col-right -->\n        <div id=\"col-right\">\n            <div id=\"group-col-right\">\n                                {{?education}}<div id=\"cvo-education\" class=\"cvo-block\">\n    <div class=\"cvo-block-content-wrapper\">\n        <div class=\"block-title-section-content\">\n            <div class=\"cvo-block-title\">\n                <span id=\"cvo-education-blocktitle\">\n   