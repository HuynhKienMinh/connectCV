n        <div class=\"block-title-section-content\">\n            <div class=\"cvo-block-title\">\n                <span id=\"cvo-certification-blocktitle\" style=\"position: relative;\">\n                    Chứng chỉ\n                </span>\n                <div class=\"cvo-block-title-underline\"></div>\n            </div>\n            <div id=\"certification-table\">\n                                                {{#certification}}</div>\n        </div>\n    </div>\n    <div style=\"clear: both\"></div>\n</div>\n                                {{/certification}}{{?award}}<div id=\"cvo-award\" class=\"cvo-block\">\n    <div class=\"cvo-block-content-wrapper\">\n        <div class=\"block-title-section-content\">\n            <div class=\"cvo-block-title\">\n                <span id=\"cvo-award-blocktitle\" style=\"position: relative;\">\n                    Danh hiệu và giải thưởng\n                </span>\n                <div class=\"cvo-block-title-underline\"></div>\n            </div>\n            <div id=\"award-table\">\n                                                {{#award}}</div>\n        </div>\n    </div>\n    <div style=\"clear: both\"></div>\n</div>\n                            {{/award}}</div>\n        </div>\n        <!-- END #col-right -->\n        <div style=\"clear: both;\"></div>\n    </div>\n</div>\n<div id=\"cv-watermark\">\n    © topcv.vn\n</div>\n                    </div>\n                </div>\n            </div>", "originalBody": "<div id=\"cvo-document\" class=\"cvo-document\">\n                <div class=\"cvo-page\">\n                    <div class=\"cvo-subpage\">\n                        <div id=\"cvo-body\">\n    <!--Header-->\n    <div id=\"cvo-main\">\n        <div id=\"col-left\">\n            <!-- #group-top-left -->\n            <div id=\"group-top-left\">\n                <!-- FIXED GROUP -->\n                <div id=\"cvo-profile\" class=\"cvo-block\">\n    <div class=\"cvo-profile-header\">\n        <div class=\"cvo-profile-header-left\">\n            <i class=\"fa fa-user\"></i>\n        </div>\n        <div class=\"cvo-profile-header-middle\">\n            <span class=\"cvo-profile-header-switch\">\n                <span class=\"switch-container\">\n                    <i class=\"fa fa-file-image-o\" style=\"color: #F05A66; margin-left: 3px;\"></i>\n                </span>\n                <i class=\"fa fa-star\"></i>\n            </span>\n        </div>\n        <div class=\"cvo-profile-header-right\">\n            <i class=\"fa fa-comments\"></i>\n        </div>\n    </div>\n    <div id=\"profile-title-wrapper\">\n        <div class=\"avatar-wrapper\">\n            <div style=\"position: relative;\">\n                                <img id=\"cvo-profile-avatar\" src=\"/api/cv/source-assets/640cf40b5d4541830388.png\" value=\"preview_avatar\" alt=\"avatar\">\n                                <div id=\"cvo-profile-title\"><span class=\"ql-size-18px cvo-profile-info-value\">Nhân viên tư vấn</span></div>\n                <div class=\"overlay-image\">\n                </div>\n            </div>\n        </div>\n        <div style=\"margin-top: 16px;\">\n            <div class=\"cvo-action-icons\">\n                <div class=\"action-icon\">\n                    <i class=\"fa fa-undo\" style=\"color: #fbcc0b;\"></i>\n                </div>\n                <div class=\"action-icon favorite-action-icon\">\n                    <i class=\"fa fa-star\"></i>\n                </div>\n                <div class=\"action-icon\">\n                    <i class=\"fa fa-heart\" style=\"color: #69c3a2;\"></i>\n                </div>\n                <div class=\"action-icon\">\n                    <i class=\"fa fa-bolt\" style=\"color: #885da6;\"></i>\n                </div>\n            </div>\n            <span id=\"cvo-profile-fullname\"><strong class=\"end-action ql-size-22px\">Nguyễn Hoàng Anh</strong></span><br>\n        </div>\n    </div>\n    <div id=\"profile-contact-wraper\">\n        <div class=\"cvo-profile-info-row\" id=\"cvo-profile-email-wraper\">\n            <span class=\"cvo-profile-label\">\n                <i class=\"fa fa-envelope-square icon-wrapper\"></i>\n                Email:\n            </span>\n            <span class=\"cvo-profile-info-value\" id=\"cvo-profile-email\"><span class=\"end-action ql-size-13px\">hotro@topcv.vn</span></span>\n        </div>\n        <div class=\"cvo-profile-info-row\" id=\"cvo-profile-phone-wraper\">\n            <span class=\"cvo-profile-label\">\n                <i class=\"fa fa-phone icon-wrapper\"></i>\n                Điện thoại:\n            </span>\n            <span class=\"cvo-profile-info-value\" id=\"cvo-profile-phone\"><span class=\"end-action ql-size-13px\">(024) 6680 5588</span></span>\n        </div>\n                <div class=\"cvo-profile-info-row\" id=\"cvo-profile-gender-wraper\">\n            <span class=\"cvo-profile-label\">\n                <i class=\"fa fa-user icon-wrapper\"></i>\n                Giới tính:\n            </span>\n            <span class=\"cvo-profile-info-value\" id=\"cvo-profile-gender\">\n                <span class=\"ql-size-13px\">Nam/Nữ/Khác</span>\n            </span>\n        </div>\n                        <div class=\"cvo-profile-info-row\" id=\"cvo-profile-dob-wraper\">\n            <span class=\"cvo-profile-label\">\n                <i class=\"fa fa-calendar icon-wrapper\"></i>\n                Ngày sinh:\n            </span>\n            <span class=\"cvo-profile-info-value\" id=\"cvo-profile-dob\">\n                <span class=\"end-action ql-size-13px\">26/05/1996</span>\n            </span>\n        </div>\n                        <div class=\"cvo-profile-info-row\" id=\"cvo-profile-address-wraper\">\n            <span class=\"cvo-profile-label\">\n                <i class=\"fa fa-home icon-wrapper\"></i>\n                Địa chỉ:\n            </span>\n            <span class=\"cvo-profile-info-value\" id=\"cvo-profile-address\"><span class=\"end-action ql-size-13px\">Ba Đình, Hà Nội</span></span>\n        </div>\n            </div>\n    <div style=\"clear: both\"></div>\n</div>            </div>\n            <!-- END #group-top-left -->\n            <div id=\"group-bottom-left\">\n                                <div id=\"cvo-objective\" class=\"cvo-block\">\n    <div class=\"block-title-section-content\">\n        <div class=\"cvo-profile-info-row\">\n            <span class=\"cvo-profile-label\">\n                <i class=\"fa fa-calendar icon-wrapper\"></i>\n                <span id=\"cvo-objective-blocktitle\">\n                    Mục tiêu nghề nghiệp\n                </span>\n            </span>\n        </div>\n        <div id=\"cvo-objective-objective\"><p class=\"ql-align-justify\">Tôi mong muốn ứng tuyển vào vị trí Tổng đài viên Chăm sóc khách hàng để tận dụng 3 năm kinh nghiệm xử lý yêu cầu và phản hồi khách hàng chuyên nghiệp, cùng với khả năng giao tiếp tiếng Anh tốt và tinh thần làm việc năng động, linh hoạt. Mục tiêu của tôi là không ngừng nâng cao trải nghiệm khách hàng, góp phần xây dựng hình ảnh chuyên nghiệp và thân thiện cho doanh nghiệp.</p></div>\n    </div>\n</div>                            </div>\n        </div>\n        <!-- END #col-left -->\n        <!-- #col-right -->\n        <div id=\"col-right\">\n            <div id=\"group-col-right\">\n                                <div id=\"cvo-education\" class=\"cvo-block\">\n    <div class=\"cvo-block-content-wrapper\">\n        <div class=\"block-title-section-content\">\n            <div class=\"cvo-block-title\">\n                <span id=\"cvo-education-blocktitle\">\n                    Học vấn\n                </span>\n                <div class=\"cvo-block-title-underline\"></div>\n            </div>\n            <div id=\"education-table\">\n                                                <div class=\"row \">\n                    <div class=\"row-title\">\n                        <div class=\"cvo-info-wrapper\">\n                            <span class=\"cvo-education-school\">ĐH TopCV</span><span><strong>,&nbsp;</strong></span><span class=\"cvo-education-title\">Quản trị kinh doanh</span>                        </div>\n                                                <div class=\"cvo-section-time-value\">\n                            <span class=\"cvo-education-start\">2016</span>                                                        -\n                                                                                    <span class=\"cvo-education-end\">2020</span>\n                                                    </div>\n                                            </div>\n                                        <div class=\"row-details\">\n                        <div class=\"cvo-education-details\"><p><span class=\"ql-size-13px end-action\">Tốt nghiệp loại Giỏi</span></p></div>\n                    </div>\n                                        <div style=\"clear:both;\"></div>\n                </div>\n                                            </div>\n        </div>\n    </div>\n</div>\n                                <div id=\"cvo-experience\" class=\"cvo-block\">\n    <div class=\"cvo-block-content-wrapper\">\n        <div class=\"block-title-section-content\">\n            <div class=\"cvo-block-title\">\n                <span id=\"cvo-experience-blocktitle\" style=\"position: relative;\">\n                    Kinh nghiệm làm việc\n                </span>\n                <div class=\"cvo-block-title-underline\"></div>\n            </div>\n            <div id=\"experience-table\">\n                                                <div class=\"row \">\n                    <div class=\"row-title\">\n                        <div>\n                            <span class=\"cvo-experience-company\">SVT Finance Innovation Co.</span><span><strong>,&nbsp;</strong></span><span class=\"cvo-experience-position\">Tổng Đài Viên Chăm Sóc Khách Hàng</span>                        </div>\n                                                <div class=\"cvo-experience-time\">\n                            <span class=\"cvo-experience-start\">08/2020</span>                                                        -\n                                                        <span class=\"cvo-experience-end\">Nay</span>                        </div>\n                                            </div>\n                    <div class=\"row-details\">\n                        <div class=\"cvo-experience-details\"><ul><li class=\"ql-align-justify\">Tiếp nhận và giải đáp thắc mắc của phụ huynh liên quan đến khóa học, lịch học, học phí, chính sách hoàn trả qua điện thoại, Zalo và email.</li><li class=\"ql-align-justify\">Gọi điện nhắc lịch học, lịch kiểm tra, lịch đóng phí và tư vấn các chương trình ưu đãi mới phù hợp với từng nhóm học viên.</li><li class=\"ql-align-justify\">Phối hợp với bộ phận học vụ và giáo viên để xử lý các phản hồi từ phụ huynh về chất lượng giảng dạy hoặc tiến độ học tập của học viên.</li><li class=\"ql-align-justify\">Theo dõi mức độ hài lòng của phụ huynh, ghi nhận các phản hồi và đề xuất cải thiện trải nghiệm dịch vụ.</li><li class=\"ql-align-justify\">Cập nhật và quản lý thông tin khách hàng trên hệ thống CRM, đảm bảo dữ liệu đầy đủ, chính xác và dễ truy xuất.</li><li class=\"ql-align-justify\">Tham gia đào tạo nội bộ và cập nhật kiến thức khóa học để hỗ trợ tư vấn và chăm sóc khách hàng hiệu quả hơn.</li><li class=\"ql-align-justify\">Thành tích:&nbsp;Duy trì tỷ lệ hài lòng của phụ huynh trên 95% trong 12 tháng liên tiếp (dựa trên khảo sát nội bộ sau khóa học).</li></ul></div>\n                    </div>\n                    <div style=\"clear:both;\"></div>\n                </div>\n                                <div class=\"row \">\n                    <div class=\"row-title\">\n                        <div>\n                            <span class=\"cvo-experience-company\">SVT Investment &amp; Development Co., Ltd</span><span><strong>,&nbsp;</strong></span><span class=\"cvo-experience-position\">Chuyên Viên Tư Vấn Giải Pháp Phần Mềm</span>                        </div>\n                                                <div class=\"cvo-experience-time\">\n                            <span class=\"cvo-experience-start\">08/2018</span>                                                        -\n                                                        <span class=\"cvo-experience-end\">07/2020</span>                        </div>\n                                            </div>\n                    <div class=\"row-details\">\n                        <div class=\"cvo-experience-details\"><ul><li class=\"ql-align-justify\">Phân tích nhu cầu và quy trình quản lý nhân sự của khách hàng, từ đó đề xuất giải pháp phần mềm chấm công, tính lương, quản lý ca phù hợp.</li><li class=\"ql-align-justify\">Tư vấn giải pháp và trình bày demo sản phẩm cho khách hàng doanh nghiệp, giúp họ hiểu rõ tính năng và lợi ích của phần mềm.</li><li class=\"ql-align-justify\">Làm việc cùng đội ngũ kỹ thuật để tùy chỉnh phần mềm theo yêu cầu đặc thù của từng doanh nghiệp (ca kíp phức tạp, quy định tính công riêng...).</li><li class=\"ql-align-justify\">Hướng dẫn sử dụng phần mềm cho khách hàng (trực tiếp hoặc online), xây dựng tài liệu hướng dẫn, hỗ trợ trong quá trình triển khai ban đầu.</li><li class=\"ql-align-justify\">Theo dõi hiệu quả sau triển khai và hỗ trợ bảo trì, tiếp nhận phản hồi và phối hợp cải tiến giải pháp cho phù hợp với quy mô, nhu cầu thực tế của khách hàng.</li></ul></div>\n                    </div>\n                    <div style=\"clear:both;\"></div>\n                </div>\n                                            </div>\n            <div style=\"clear: both\"></div>\n        </div>\n    </div>\n</div>\n                                <div id=\"cvo-activity\" class=\"cvo-block\">\n    <div class=\"cvo-block-content-wrapper\">\n        <div class=\"block-title-section-content\">\n            <div class=\"cvo-block-title\">\n                <span id=\"cvo-activity-blocktitle\" style=\"position: relative;\">\n                    Hoạt động\n                </span>\n                <div class=\"cvo-block-title-underline\"></div>\n            </div>\n            <div id=\"activity-table\">\n                                                <div class=\"row \">\n                    <div class=\"row-title\">\n                        <div class=\"cvo-info-wrapper\">\n                            <span class=\"cvo-activity-organization\">Câu lạc bộ Sự kiện, trường Đại học TopCV</span><span><strong>,&nbsp;</strong></span><span class=\"cvo-activity-position\">Ban Sự Kiện</span>                        </div>\n                                                <div class=\"cvo-activity-time\">\n                                                        <span class=\"cvo-activity-start\">06/2016</span>\n                                                                                    -\n                                                                                    <span class=\"cvo-activity-end\">09/2020</span>\n                                                    </div>\n                                            </div>\n                    <div class=\"row-details\">\n                        <div class=\"cvo-activity-details\"><ul><li class=\"ql-align-justify\"><span class=\"end-action ql-size-13px\">Xây dựng 5 sự kiện chào đón tân sinh viên với 5000 sinh viên tham gia. </span></li><li class=\"ql-align-justify\"><span class=\"ql-size-13px end-action\">Hỗ trợ 500 tân sinh viên mỗi năm làm hồ sơ, tìm hiểu về nhà trường. </span></li><li class=\"ql-align-justify\"><span class=\"ql-size-13px end-action\">Giao tiếp và hỗ trợ thông tin cho phụ huynh.</span></li></ul></div>\n                    </div>\n                    <div style=\"clear:both;\"></div>\n                </div>\n                                            </div>\n        </div>\n    </div>\n    <div style=\"clear: