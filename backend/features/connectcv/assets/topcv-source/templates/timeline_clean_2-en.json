div>\n    </div>\n</div>\n<div id=\"cv-watermark\">\n   © topcv.vn\n</div>\n                    </div>\n                </div>\n            </div>", "originalBody": "<div id=\"cvo-document\" class=\"cvo-document\">\n                <div class=\"cvo-page\">\n                    <div class=\"cvo-subpage\">\n                        <div id=\"cvo-body\">\n    <div id=\"cvo-main\">\n         <!--Header-->\n        <div id=\"group-header\">\n            <div class=\"cvo-block\" id=\"cvo-profile\">\n    <div id=\"cvo-profile-wrapper\">\n                <div id=\"cvo-profile-avatar-wrapper\">\n            <div id=\"cvo-profile-avatar-outer\">\n                <div id=\"cvo-profile-avatar-inner\">\n                    <img id=\"cvo-profile-avatar\" src=\"/api/cv/source-assets/640cf40b5d4541830388.png\" value=\"preview_avatar\" alt=\"avatar\">\n                </div>\n            </div>\n        </div>\n                <div id=\"cvo-profile-info-wrapper\">\n            <div id=\"cvo-name-title-wrapper\">\n                <div id=\"cvo-profile-fullname-wraper\">\n                    <span id=\"cvo-profile-fullname\"><strong class=\"ql-font-RobotoCondensed ql-size-23px\">PHAM HA AN</strong></span>\n                </div>\n                                <div id=\"cvo-profile-title-wraper\">\n                    <span id=\"cvo-profile-title\"><strong class=\"ql-font-BeVietnamPro ql-size-18px\">Consultant</strong></span>\n                </div>\n                            </div>\n                        <div class=\"contact-item\">\n                <span><i class=\"fa fa-calendar\"></i></span>\n                <span class=\"cvo-profile-info-value\" id=\"cvo-profile-dob\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">August 24, 1996</span></span>\n            </div>\n                                    <div class=\"contact-item\">\n                <span><i class=\"fa fa-user\"></i></span>\n                <span class=\"cvo-profile-info-value\" id=\"cvo-profile-gender\"><span class=\"ql-size-13px\">Male/Female/Other</span></span>\n            </div>\n                        <div class=\"contact-item\">\n                <span><i class=\"fa fa-phone\"></i></span>\n                <span class=\"cvo-profile-info-value\" id=\"cvo-profile-phone\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">(024) 6680 5588</span></span>\n            </div>\n            <div class=\"contact-item\">\n                <span><i class=\"fa fa-envelope-square\"></i></span>\n                <span class=\"cvo-profile-info-value\" id=\"cvo-profile-email\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">hotro@topcv.vn</span></span>\n            </div>\n            <div class=\"contact-item\">\n                <i class=\"fa fa-map-marker\"></i>\n                <span class=\"cvo-profile-info-value\" id=\"cvo-profile-address\">Ba Dinh, Ha Noi</span>\n            </div>\n                        <div class=\"contact-item\">\n                <i class=\"fa fa-info\"></i>\n                <span class=\"cvo-profile-info-value\" id=\"cvo-profile-website\"><span class=\"ql-size-13px\">be.net/yourname</span></span>\n            </div>\n                    </div>\n        <div style=\"clear: both;\"></div>\n    </div>\n    <div id=\"topline\"></div>\n</div>        </div>\n        <div id=\"group-col-left\">\n                            <div id=\"cvo-education\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\">\n        <span id=\"cvo-education-blocktitle\">Education</span>\n        <div class=\"cvo-block-title-underline\"></div>\n    </div>\n    <div id=\"education-table\" class=\"cvo-block-content\">\n                        <div class=\"row\">\n            <div>\n                <div class=\"cvo-education-time cvo-time\">\n                    <span class=\"cvo-education-start\">2016</span>\n                    <span><b>&nbsp;&gt;&gt;&nbsp;</b></span>\n                    <span class=\"cvo-education-end\">2020</span>\n                </div>\n            </div>\n            <div>\n                <div class=\"row-title\">\n                    <div class=\"cvo-education-school-wraper\">\n                        <span class=\"cvo-education-school\">TopCV University</span>\n                    </div>\n                </div>\n                <div class=\"row-details\">\n                                        <div>\n                        <span class=\"cvo-education-title color-highlight\">Business Administration</span>\n                    </div>\n                                                            <div class=\"cvo-education-details color-content\"><p><span class=\"ql-size-14px\">Excellent</span></p></div>\n                                    </div>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>\n                    </div>\n</div>\n                            <div id=\"cvo-experience\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\">\n        <span id=\"cvo-experience-blocktitle\">Work experience</span>\n        <div class=\"cvo-block-title-underline\"></div>\n    </div>\n    <div id=\"experience-table\" class=\"cvo-block-content\">\n                        <div class=\"row\">\n            <div>\n                <div class=\"cvo-experience-time cvo-time\">\n                    <span class=\"cvo-experience-start\">2022</span>\n                    <span><b>&nbsp;&gt;&gt;&nbsp;</b></span>\n                    <span class=\"cvo-experience-end\">2025</span>\n                </div>\n            </div>\n            <div>\n                <div class=\"row-title\">\n                    <div class=\"cvo-experience-company-wraper\">\n                        <span class=\"cvo-experience-company\">HJS Academy</span>\n                    </div>\n                </div>\n                <div class=\"row-details\">\n                                        <div>\n                        <span class=\"cvo-experience-position color-highlight\">Consultant</span>\n                    </div>\n                                        <div class=\"cvo-experience-details color-content\"><ul><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Provided personalized consultation based on student's learning goals. </span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Recommended suitable English courses aligned with students' interests and proficiency levels, clearly explaining course features, benefits, and how they differ from competitors.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Promoted special enrollment promotions and tuition discounts to increase conversion rates, consistently exceeding 150% of assigned KPIs.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Collected and maintained a database of over 5,000 potential learners for nurturing and follow-up, contributing to long-term customer engagement and upselling.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Collaborated with Marketing and Academic departments to develop strategies for customer acquisition and retention, helping increase overall company revenue by 200% within one year. </span></li></ul></div>\n                </div>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>\n                <div class=\"row\">\n            <div>\n                <div class=\"cvo-experience-time cvo-time\">\n                    <span class=\"cvo-experience-start\">August 2018</span>\n                    <span><b>&nbsp;&gt;&gt;&nbsp;</b></span>\n                    <span class=\"cvo-experience-end\">July 2020</span>\n                </div>\n            </div>\n            <div>\n                <div class=\"row-title\">\n                    <div class=\"cvo-experience-company-wraper\">\n                        <span class=\"cvo-experience-company\">TopCV BCD Company</span>\n                    </div>\n                </div>\n                <div class=\"row-details\">\n                                        <div>\n                        <span class=\"cvo-experience-position color-highlight\">Software Solution Consultant</span>\n                    </div>\n                                        <div class=\"cvo-experience-details color-content\"><ul><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Searched, consulted, and introduced software and hardware solutions (e.g., printers, barcode scanners) to approximately 50 customers daily, utilizing a database of 5,000 existing contacts and self-sourced 100 new leads per day. </span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Supported and guided customers in using software products both online and onsite, ensuring effective onboarding and usage.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Managed the sales process and contract signing, consistently exceeding 150% of the annual revenue KPI.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Maintained and developed a strong pipeline of potential customers, contributing to long-term business growth. </span></li></ul></div>\n                </div>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>\n                    </div>\n    <div style=\"clear: both\"></div>\n</div>\n                            <div id=\"cvo-certification\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\">\n        <span id=\"cvo-certification-blocktitle\">Certifications</span>\n        <div class=\"cvo-block-title-underline\"></div>\n    </div>\n    <div id=\"certification-table\">\n                        <div class=\"row\">\n            <div class=\"cvo-activity-time cvo-time\">\n                <span class=\"cvo-certification-time\">2022</span>\n            </div>\n            <div class=\"cvo-bold-text\">\n                <span class=\"cvo-certification-title color-content\"><p><strong class=\"ql-size-14px\">Training Program: Telephone Selling Skills</strong></p></span>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>\n                <div class=\"row\">\n            <div class=\"cvo-activity-time cvo-time\">\n                <span class=\"cvo-certification-time\">2021</span>\n            </div>\n            <div class=\"cvo-bold-text\">\n                <span class=\"cvo-certification-title color-content\"><p><strong class=\"ql-size-14px\">Professional Customer Care Management training course</strong></p></span>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>\n                    </div>\n    <div style=\"clear: both\"></div>\n</div>\n                            <div id=\"cvo-award\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\">\n        <span id=\"cvo-award-blocktitle\">Honors &amp; Awards</span>\n        <div class=\"cvo-block-title-underline\"></div>\n    </div>\n    <div id=\"award-table\">\n                        <div class=\"row\">\n            <div>\n                <span class=\"cvo-award-time cvo-time\">2020</span>\n            </div>\n            <div class=\"cvo-bold-text\">\n                <span class=\"cvo-award-title color-content\"><p><strong class=\"ql-size-14px\">Best consultant in the third quarter of 2022</strong></p></span>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>\n                    </div>\n    <div style=\"clear: both\"></div>\n</div>\n                    </div>\n        <div id=\"group-col-right\">\n                            <div id=\"cvo-objective\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\">\n        <span id=\"cvo-objective-blocktitle\">CAREER OBJECTIVES</span>\n        <div class=\"cvo-block-title-underline\"></div>\n    </div>\n    <div id=\"cvo-objective-objective\" class=\"color-content\"><p class=\"ql-align-justify\"><span class=\"ql-size-14px\">Customer Consultant with 5 years of experience in product and course consulting at English centers and technology stores. Skilled in identifying potential customers, providing accurate information, and effectively persuading clients. Known for being quick-witted, adaptable, and thriving under pressure. Seeking a Customer Consultant position to contribute to revenue growth and customer acquisition for the company. </span></p></div>\n</div>\n                            <div id=\"cvo-skillrate\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\">\n        <span id=\"cvo-skillrate-blocktitle\">SKILLS</span>\n        <div class=\"cvo-block-title-underline\"></div>\n    </div>\n    <div id=\"skillrate-table\">\n                        <div class=\"row\">\n            <div><span class=\"cvo-skillrate-title\">Customer Needs Analysis</span></div>\n            <div class=\"cvo-skillrate-bar\" bval=\"5\" rate-value=\"5\">\n                 <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                                </div>\n        </div>\n                <div class=\"row\">\n            <div><span class=\"cvo-skillrate-title\">Market Research &amp; Client Profiling</span></div>\n            <div class=\"cvo-skillrate-bar\" bval=\"5\" rate-value=\"5\">\n                 <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                                </div>\n        </div>\n                <div class=\"row\">\n            <div><span class=\"cvo-skillrate-title\">Sales Pitch &amp; Persuasive Communication</span></div>\n            <div class=\"cvo-skillrate-bar\" bval=\"5\" rate-value=\"5\">\n                 <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                                </div>\n        </div>\n                <div class=\"row\">\n            <div><span class=\"cvo-skillrate-title\">CRM Systems (e.g., Salesforce, HubSpot)</span></div>\n            <div class=\"cvo-skillrate-bar\" bval=\"5\" rate-value=\"5\">\n                 <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                                </div>\n        </div>\n                <div class=\"row\">\n            <div><span class=\"cvo-skillrate-title\">Microsoft Office Suite (Excel, Word, PowerPoint)</span></div>\n            <div class=\"cvo-skillrate-bar\" bval=\"5\" rate-value=\"5\">\n                 <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                     <span class=\"cvo-skillrate-cell\"></span>\n                                </div>\n        </div>\n                    </div>\n</div>\n                    </div>\n        <div style=\"clear: both;\"></div>\n    </div>\n</div>\n<div id=\"cv-watermark\">\n   © topcv.vn\n</div>\n                    </div>\n                </div>\n            </div>", "rows": {"experience": "<div class=\"row\">\n            <div>\n                <div class=\"cvo-experience-time cvo-time\">\n                    <span class=\"cvo-experience-start\" contenteditable=\"true\">{{experience.start}}</span>\n                    <span><b> &gt;&gt; </b></span>\n                    <span class=\"cvo-experience-end\" contenteditable=\"true\">{{experience.end}}</span>\n                </div>\n            </div>\n            <div>\n                <div class=\"row-title\">\n                    <div cla