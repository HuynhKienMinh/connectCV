{"body": "<div id=\"cvo-document\" class=\"cvo-document\">\n                <div class=\"cvo-page\">\n                    <div class=\"cvo-subpage\">\n                        <div id=\"cvo-body\">\n    <div id=\"cvo-main\">\n         <!--Header-->\n        <div id=\"group-header\">\n            <div class=\"cvo-block\" id=\"cvo-profile\">\n    <div id=\"cvo-profile-wrapper\">\n                <div id=\"cvo-profile-avatar-wrapper\">\n            <div id=\"cvo-profile-avatar-outer\">\n                <div id=\"cvo-profile-avatar-inner\">\n                    <img id=\"cvo-profile-avatar\" src=\"{{profile.avatar}}\" value=\"preview_avatar\" alt=\"{{profile.fullname}}\">\n                </div>\n            </div>\n        </div>\n                <div id=\"cvo-profile-info-wrapper\">\n            <div id=\"cvo-name-title-wrapper\">\n                <div id=\"cvo-profile-fullname-wraper\">\n                    <span id=\"cvo-profile-fullname\" contenteditable=\"true\"><strong class=\"ql-font-RobotoCondensed ql-size-23px\">{{profile.fullname}}</strong></span>\n                </div>\n                                <div id=\"cvo-profile-title-wraper\">\n                    <span id=\"cvo-profile-title\" contenteditable=\"true\"><strong class=\"ql-font-BeVietnamPro ql-size-18px\">{{profile.title}}</strong></span>\n                </div>\n                            </div>\n                        <div class=\"contact-item\">\n                <span><i class=\"fa fa-calendar\"></i></span>\n                <span class=\"cvo-profile-info-value\" id=\"cvo-profile-dob\" contenteditable=\"true\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">{{profile.dob}}</span></span>\n            </div>\n                                    <div class=\"contact-item\">\n                <span><i class=\"fa fa-user\"></i></span>\n                <span class=\"cvo-profile-info-value\" id=\"cvo-profile-gender\" contenteditable=\"true\"><span class=\"ql-size-13px\">{{profile.gender}}</span></span>\n            </div>\n                        <div class=\"contact-item\">\n                <span><i class=\"fa fa-phone\"></i></span>\n                <span class=\"cvo-profile-info-value\" id=\"cvo-profile-phone\" contenteditable=\"true\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">{{profile.phone}}</span></span>\n            </div>\n            <div class=\"contact-item\">\n                <span><i class=\"fa fa-envelope-square\"></i></span>\n                <span class=\"cvo-profile-info-value\" id=\"cvo-profile-email\" contenteditable=\"true\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">{{profile.email}}</span></span>\n            </div>\n            <div class=\"contact-item\">\n                <i class=\"fa fa-map-marker\"></i>\n                <span class=\"cvo-profile-info-value\" id=\"cvo-profile-address\" contenteditable=\"true\">{{profile.address}}</span>\n            </div>\n                        <div class=\"contact-item\">\n                <i class=\"fa fa-info\"></i>\n                <span class=\"cvo-profile-info-value\" id=\"cvo-profile-website\" contenteditable=\"true\"><span class=\"ql-size-13px\">{{profile.website}}</span></span>\n            </div>\n                    </div>\n        <div style=\"clear: both;\"></div>\n    </div>\n    <div id=\"topline\"></div>\n</div>        </div>\n        <div id=\"group-col-left\">\n                            {{?education}}<div id=\"cvo-education\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\">\n        <span id=\"cvo-education-blocktitle\">Education</span>\n        <div class=\"cvo-block-title-underline\"></div>\n    </div>\n    <div id=\"education-table\" class=\"cvo-block-content\">\n                        {{#education}}</div>\n</div>\n                            {{/education}}{{?experience}}<div id=\"cvo-experience\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\">\n        <span id=\"cvo-experience-blocktitle\">Work experience</span>\n        <div class=\"cvo-bloc