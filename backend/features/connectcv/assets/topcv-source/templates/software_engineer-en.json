-email\" contenteditable=\"true\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">{{profile.email}}</span></span>\n            </td>\n        </tr>\n                <tr>\n            <td>\n                <span class=\"profile-label\">Address</span>\n                <span class=\"profile-field\" id=\"cvo-profile-address\" contenteditable=\"true\">{{profile.address}}</span>\n            </td>\n        </tr>\n                        <tr>\n            <td>\n                <span class=\"profile-label\">Website</span>\n                <span class=\"profile-field\" id=\"cvo-profile-website\" contenteditable=\"true\"><span class=\"ql-size-13px\">{{profile.website}}</span></span>\n            </td>\n        </tr>\n            </tbody></table>\n</div>\n        </div>\n        <!-- END #group-header -->\n        <!-- #group-content -->\n        <div id=\"group-content\">\n                    {{?objective}}<div class=\"cvo-block\" id=\"cvo-objective\">\n    <h3 class=\"cvo-block-title\"><span id=\"cvo-objective-blocktitle\">CAREER OBJECTIVES</span></h3>\n    <div class=\"block-body\">\n        <div id=\"cvo-objective-objective\" contenteditable=\"true\"><p class=\"ql-align-justify\"><span class=\"ql-size-14px\">{{objective.objective}}</span></p></div>\n    </div>\n</div>                    {{/objective}}{{?education}}<div class=\"cvo-block\" id=\"cvo-education\">\n    <h3 class=\"cvo-block-title\"><span id=\"cvo-education-blocktitle\">Education</span></h3>\n    <div id=\"education-table\">\n                                    {{#education}}</div>\n</div>\n                    {{/education}}{{?skillgroup}}<div id=\"cvo-skillgroup\" class=\"cvo-block\"><h3 class=\"cvo-block-title\"><span id=\"cvo-skillgroup-blocktitle\">Skills</span></h3>\n    <div id=\"skillgroup-table\" class=\"block-content\">{{#skillgroup}}</div></div>{{/skillgroup}}{{?experience}}<div class=\"cvo-block\" id=\"cvo-experience\">\n    <h3 class=\"cvo-block-title\"><span id=\"cvo-experience-blocktitle\">Work experience</span></h3>\n    <div id=\"experience-table\">\n                                {{#experience}}</div>\n</div>\n                    {{/experience}}{{?certification}}<div class=\"cvo-block\" id=\"cvo-certification\">\n    <h3 class=\"cvo-block-title\"><span id=\"cvo-certification-blocktitle\">Certifications</span></h3>\n    <div id=\"certification-table\">\n                            {{#certification}}</div>\n</div>\n                    {{/certification}}{{?award}}<div class=\"cvo-block\" id=\"cvo-award\">\n    <h3 class=\"cvo-block-title\"><span id=\"cvo-award-blocktitle\">Honors &amp; Awards</span></h3>\n    <div id=\"award-table\">\n                            {{#award}}</div>\n</div>\n                {{/award}}</div>\n        <!-- END #group-content -->\n        <div style=\"clear: both;\"></div>\n    </div>\n</div>\n<div id=\"cv-watermark\">\n   © topcv.vn\n</div>\n                    </div>\n                </div>\n            </div>", "originalBody": "<div id=\"cvo-document\" class=\"cvo-document\">\n                <div class=\"cvo-page\">\n                    <div class=\"cvo-subpage\">\n                        <div id=\"cvo-body\">\n    <!--Header-->\n    <div id=\"cvo-main\">\n        <!-- #group-header -->\n        <div id=\"group-header\">\n            <!-- FIXED GROUP -->\n            <div class=\"cvo-block\" id=\"cvo-profile\">\n    <table id=\"profile-table\">\n        <tbody><tr>\n            <td>\n                <span id=\"cvo-profile-fullname\"><strong class=\"ql-font-RobotoCondensed ql-size-23px\">PHAM HA AN</strong></span>\n            </td>\n                    <td class=\"avatar-wraper\" rowspan=\"9\" id=\"avatar\">\n                <img id=\"cvo-profile-avatar\" src=\"/api/cv/source-assets/640cf40b5d4541830388.png\" value=\"preview_avatar\" alt=\"avatar\">\n            </td>\n                </tr>\n                <tr>\n            <td>\n                <span class=\"profile-label\">Date of birth</span>\n                <span class=\"profile-field\" id=\"cvo-profile-dob\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">August 24, 1996</span></span>\n            </td>\n        </tr>\n                        <tr>\n            <td>\n                <span class=\"profile-label\">Gender</span>\n                <span class=\"profile-field\" id=\"cvo-profile-gender\"><span class=\"ql-size-13px\">Male/Female/Other</span></span>\n            </td>\n        </tr>\n                <tr>\n            <td>\n                <span class=\"profile-label\">Phone</span>\n                <span class=\"profile-field\" id=\"cvo-profile-phone\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">(024) 6680 5588</span></span>\n            </td>\n        </tr>\n        <tr>\n            <td>\n                <span class=\"profile-label\">Email</span>\n                <span class=\"profile-field\" id=\"cvo-profile-email\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">hotro@topcv.vn</span></span>\n            </td>\n        </tr>\n                <tr>\n            <td>\n                <span class=\"profile-label\">Address</span>\n                <span class=\"profile-field\" id=\"cvo-profile-address\">Ba Dinh, Ha Noi</span>\n            </td>\n        </tr>\n                        <tr>\n            <td>\n                <span class=\"profile-label\">Website</span>\n                <span class=\"profile-field\" id=\"cvo-profile-website\"><span class=\"ql-size-13px\">be.net/yourname</span></span>\n            </td>\n        </tr>\n            </tbody></table>\n</div>\n        </div>\n        <!-- END #group-header -->\n        <!-- #group-content -->\n        <div id=\"group-content\">\n                    <div class=\"cvo-block\" id=\"cvo-objective\">\n    <h3 class=\"cvo-block-title\"><span id=\"cvo-objective-blocktitle\">CAREER OBJECTIVES</span></h3>\n    <div class=\"block-body\">\n        <div id=\"cvo-objective-objective\">\n                        <p class=\"ql-align-justify\"><span class=\"ql-size-14px\">Customer Consultant with 5 years of experience in product and course consulting at English centers and technology stores. Skilled in identifying potential customers, providing accurate information, and effectively persuading clients. Known for being quick-witted, adaptable, and thriving under pressure. Seeking a Customer Consultant position to contribute to revenue growth and customer acquisition for the company. </span></p>\n                    </div>\n    </div>\n</div>                    <div class=\"cvo-block\" id=\"cvo-education\">\n    <h3 class=\"cvo-block-title\"><span id=\"cvo-education-blocktitle\">Education</span></h3>\n    <div id=\"education-table\">\n                                    <div class=\"row \">\n                    <div class=\"time\">\n                                                <span class=\"cvo-education-start start\">2016</span>\n                                                                        -\n                                                                        <span class=\"cvo-education-end end\">2020</span>\n                                            </div>\n                    <div class=\"school\">\n                        <span class=\"cvo-education-school\">TopCV University</span>\n                                                    <span class=\"cvo-education-title\">Business Administration</span>\n                                                                                                            <span class=\"cvo-education-details\"><p><span class=\"ql-size-14px\">Excellent</span></p></span>\n                                                                        </div>\n                    <div style=\"clear: both\"></div>\n                </div>\n                        </div>\n</div>\n                    <div class=\"cvo-block\" id=\"cvo-experience\">\n    <h3 class=\"cvo-block-title\"><span id=\"cvo-experience-blocktitle\">Work experience</span></h3>\n    <div id=\"experience-table\">\n                                <div class=\"row \">\n                                        <div class=\"time\">\n                                                <span class=\"cvo-experience-start start\">2022</span>\n                                                                        -\n                                                                        <span class=\"cvo-experience-end end\">2025</span>\n                                            </div>\n                                        <div class=\"company\">\n                       <span class=\"cvo-experience-company\">HJS Academy</span>\n                                                <span class=\"cvo-experience-position\">Consultant</span>\n                                                <div class=\"cvo-experience-details\"><ul><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Provided personalized consultation based on student's learning goals. </span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Recommended suitable English courses aligned with students' interests and proficiency levels, clearly explaining course features, benefits, and how they differ from competitors.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Promoted special enrollment promotions and tuition discounts to increase conversion rates, consistently exceeding 150% of assigned KPIs.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Collected and maintained a database of over 5,000 potential learners for nurturing and follow-up, contributing to long-term customer engagement and upselling.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Collaborated with Marketing and Academic departments to develop strategies for customer acquisition and retention, helping increase overall company revenue by 200% within one year. </span></li></ul></div>\n                        <div style=\"clear: both\"></div>\n                    </div>\n                    <div style=\"clear: both\"></div>\n                </div>\n                            <div class=\"row \">\n                                        <div class=\"time\">\n                                                <span class=\"cvo-experience-start start\">August 2018</span>\n                                                                        -\n                                                                        <span class=\"cvo-experience-end end\">July 2020</span>\n                                            </div>\n                                        <div class=\"company\">\n                       <span class=\"cvo-experience-company\">TopCV BCD Company</span>\n                                                <span class=\"cvo-experience-position\">Software Solution Consultant</span>\n                                                <div class=\"cvo-experience-details\"><ul><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Searched, consulted, and introduced software and hardware solutions (e.g., printers, barcode scanners) to approximately 50 customers daily, utilizing a database of 5,000 existing contacts and self-sourced 100 new leads per day. </span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Supported and guided customers in using software products both online and onsite, ensuring effective onboarding and usage.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Managed the sales process and contract signing, consistently exceeding 150% of the annual revenue KPI.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Maintained and developed a strong pipeline of potential customers, contributing to long-term business growth. </span></li></ul></div>\n                        <div style=\"clear: both\"></div>\n                    </div>\n                    <div style=\"clear: both\"></div>\n                </div>\n                        </div>\n</div>\n                    <div class=\"cvo-block\" id=\"cvo-certification\">\n    <h3 class=\"cvo-block-title\"><span id=\"cvo-certification-blocktitle\">Certifications</span></h3>\n    <div id=\"certification-table\">\n                            <div class=\"row \">\n                <div class=\"time\">\n                    <span class=\"cvo-certification-time\">2022</span>\n                </div>\n                <div class=\"details\">\n                    <span class=\"cvo-certification-title\"><p><strong class=\"ql-size-14px\">Training Program: Telephone Selling Skills</strong></p></span>\n                </div>\n                <div style=\"clear: both\"></div>\n            </div>\n                        <div class=\"row \">\n                <div class=\"time\">\n                    <span class=\"cvo-certification-time\">2021</span>\n                </div>\n                <div class=\"details\">\n                    <span class=\"cvo-certification-title\"><p><strong class=\"ql-size-14px\">Professional Customer Care Management training course</strong></p></span>\n                </div>\n                <div style=\"clear: both\"></div>\n            </div>\n                        </div>\n</div>\n                    <div class=\"cvo-block\" id=\"cvo-award\">\n    <h3 class=\"cvo-block-title\"><span id=\"cvo-award-blocktitle\">Honors &amp; Awards</span></h3>\n    <div id=\"award-table\">\n                            <div class=\"row \">\n                <div class=\"time\">\n                    <span class=\"cvo-award-time\">2020</span>\n                </div>\n                <div class=\"details\">\n                    <span class=\"cvo-award-title\"><p><strong class=\"ql-size-14px\">Best consultant in the third quarter of 2022</strong></p></span>\n                </div>\n                <div style=\"clear: both\"></div>\n            </div>\n                        </div>\n</div>\n                </div>\n        <!-- END #group-content -->\n        <div style=\"clear: both;\"></div>\n 