{"body": "<div id=\"cvo-document\" class=\"cvo-document\">\n                <div class=\"cvo-page\">\n                    <div class=\"cvo-subpage\">\n                        <div id=\"cvo-body\">\n    <div id=\"cvo-main\">\n        <!-- #group-header -->\n        <div id=\"group-header\">\n            <!-- FIXED GROUP -->\n            <div id=\"cvo-profile\" class=\"cvo-block\">\n    <!-- Header -->\n                         <div id=\"avatar-wrapper\">\n            <img id=\"cvo-profile-avatar\" src=\"{{profile.avatar}}\" value=\"preview_avatar\" alt=\"{{profile.fullname}}\">\n        </div>\n        <div id=\"cvo-header\" class=\"\">\n        <h1><span id=\"cvo-profile-fullname\" contenteditable=\"true\"><strong class=\"ql-font-RobotoCondensed ql-size-23px\">{{profile.fullname}}</strong></span></h1>\n                <p>\n            <b>Date of birth: </b>\n            <span id=\"cvo-profile-dob\" contenteditable=\"true\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">{{profile.dob}}</span></span>\n        </p>\n                <p>\n            <b>Phone: </b>\n            <span id=\"cvo-profile-phone\" contenteditable=\"true\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">{{profile.phone}}</span></span>\n        </p>\n        <p>\n            <b>Email: </b>\n            <span id=\"cvo-profile-email\" contenteditable=\"true\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">{{profile.email}}</span></span>\n        </p>\n                <p>\n            <b>Address: </b>\n            <span id=\"cvo-profile-address\" contenteditable=\"true\">{{profile.address}}</span>\n        </p>\n                        <p>\n            <b>Website: </b>\n            <span class=\"profile-field\" id=\"cvo-profile-website\" contenteditable=\"true\"><span class=\"ql-size-13px\">{{profile.website}}</span></span>\n        </p>\n                <div style=\"clear: both\"></div>\n    </div>\n    <div style=\"clear: both;\"></div>\n</div>        </div>\n        <!-- END #group-header -->\n        <!-- #group-content -->\n        <div id=\"group-content\">\n                    {{?objective}}<div id=\"cvo-objective\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\">\n        <h3><span id=\"cvo-objective-blocktitle\">CAREER OBJECTIVES</span></h3>\n    </div>\n    <div class=\"block-content\">\n        <div class=\"cvo-block-body\">\n            <div id=\"cvo-objective-objective\" contenteditable=\"true\"><p class=\"ql-align-justify\"><span class=\"ql-size-14px\">{{objective.objective}}</span></p></div>\n        </div>\n    </div>\n</div>                    {{/objective}}<!-- Education -->\n    {{?education}}<div id=\"cvo-education\" class=\"cvo-block\">\n        <div class=\"cvo-block-title\">\n            <h3><span id=\"cvo-education-blocktitle\">Education</span></h3>\n        </div>\n        <div class=\"block-content\">\n           <div id=\"education-table\">\n                                    {{#education}}</div>\n        </div>\n        <div style=\"clear: both\"></div>\n    </div>\n                    {{/education}}{{?skillgroup}}<div id=\"cvo-skillgroup\" class=\"cvo-block\"><div class=\"cvo-block-title\">\n            <h3><span id=\"cvo-skillgroup-blocktitle\">Skills</span></h3>\n        </div>\n        <div id=\"skillgroup-table\" class=\"block-content\">{{#skillgroup}}</div></div>{{/skillgroup}}<!-- Work -->\n    {{?experience}}<div id=\"cvo-experience\" class=\"cvo-block\">\n        <div class=\"cvo-block-title\">\n            <h3><span id=\"cvo-experience-blocktitle\">Work experience</span></h3>\n        </div>\n        <div class=\"block-content\">\n            <div id=\"experience-table\">\n                            <!-- start row -->\n                {{#experience}}<!-- end row -->\n                        <!-- start row -->\n                <!-- end row -->\n                                </div>\n        </div>\n        <div style=\"clear: both\"></div>\n    </div>\n                    {{/experience}}<!-- certification -->\n    {{?certification}}<div id=\"cvo-certification\" class=\"cvo-block\">\n        <div class=\"cvo-block-title\">\n            <h3><span id=\"cvo-certification-blocktitle\">Certifications</span></h3>\n        </div>\n        <div class=\"block-content\">\n            <div id=\"certification-table\">\n                                            <!-- start row -->\n                    {{#certification}}<!-- end row -->\n                                <!-- start row -->\n                    <!-- end row -->\n                                        </div>\n        </div>\n        <div style=\"clear: both\"></div>\n    </div>\n                    {{/certification}}<!-- Award -->\n    {{?award}}<div id=\"cvo-award\" class=\"cvo-block\">\n        <div class=\"cvo-block-title\">\n            <h3><span id=\"cvo-award-blocktitle\">Honors &amp; Awards</span></h3>\n        </div>\n        <div class=\"block-content\">\n            <div id=\"award-table\">\n                                            <!-- start row -->\n                    {{#award}}<!-- end row -->\n                                        </div>\n        </div>\n        <div style=\"clear: both\"></div>\n    </div>\n                {{/award}}</div>\n        <!-- END #group-content -->\n    </div>\n    <div style=\"clear: both\"></div>\n</div>\n<div id=\"cv-watermark\">\n   © topcv.vn\n</div>\n                    </div>\n                </div>\n            </div>", "originalBody": "<div id=\"cvo-document\" class=\"cvo-document\">\n                <div class=\"cvo-page\">\n                    <div class=\"cvo-subpage\">\n                        <div id=\"cvo-body\">\n    <div id=\"cvo-main\">\n        <!-- #group-header -->\n        <div id=\"group-header\">\n            <!-- FIXED GROUP -->\n            <div id=\"cvo-profile\" class=\"cvo-block\">\n    <!-- Header -->\n                         <div id=\"avatar-wrapper\">\n            <img id=\"cvo-profile-avatar\" src=\"/api/cv/source-assets/640cf40b5d4541830388.png\" value=\"preview_avatar\" alt=\"avatar\">\n        </div>\n        <div id=\"cvo-header\" class=\"\">\n        <h1><span id=\"cvo-profile-fullname\"><strong class=\"ql-font-RobotoCondensed ql-size-23px\">PHAM HA AN</strong></span></h1>\n                <p>\n            <b>Date of birth: </b>\n            <span id=\"cvo-profile-dob\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">August 24, 1996</span></span>\n        </p>\n                <p>\n            <b>Phone: </b>\n            <span id=\"cvo-profile-phone\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">(024) 6680 5588</span></span>\n        </p>\n        <p>\n            <b>Email: </b>\n            <span id=\"cvo-profile-email\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">hotro@topcv.vn</span></span>\n        </p>\n                <p>\n            <b>Address: </b>\n            <span id=\"cvo-profile-address\">Ba Dinh, Ha Noi</span>\n        </p>\n                        <p>\n            <b>Website: </b>\n            <span class=\"profile-field\" id=\"cvo-profile-website\"><span class=\"ql-size-13px\">be.net/yourname</span></span>\n        </p>\n                <div style=\"clear: both\"></div>\n    </div>\n    <div style=\"clear: both;\"></div>\n</div>        </div>\n        <!-- END #group-header -->\n        <!-- #group-content -->\n        <div id=\"group-content\">\n                    <div id=\"cvo-objective\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\">\n        <h3><span id=\"cvo-objective-blocktitle\">CAREER OBJECTIVES</span></h3>\n    </div>\n    <div class=\"block-content\">\n        <div class=\"cvo-block-body\">\n            <div id=\"cvo-objective-objective\"><p class=\"ql-align-justify\"><span class=\"ql-size-14px\">Customer Consultant with 5 years of experience in product and course consulting at English centers and technology stores. Skilled in identifying potential customers, providing accurate information, and effectively persuading clients. Known for being quick-witted, adaptable, and thriving under pressure. Seeking a Customer Consultant position to contribute to revenue growth and customer acquisition for the company. </span></p></div>\n        </div>\n    </div>\n</div>                    <!-- Education -->\n    <div id=\"cvo-education\" class=\"cvo-block\">\n        <div class=\"cvo-block-title\">\n            <h3><span id=\"cvo-education-blocktitle\">Education</span></h3>\n        </div>\n        <div class=\"block-content\">\n           <div id=\"education-table\">\n                                    <div class=\"row \">\n                <div class=\"school\">\n                    <h4><span class=\"cvo-education-school\">TopCV University</span></h4>\n                </div>\n                                <div class=\"time\">\n                                        <h5><span class=\"cvo-education-start start\">2016</span></h5>\n                                                            -\n                                                            <h5><span class=\"cvo-education-end end\">2020</span></h5>\n                                    </div>\n                                <div style=\"clear: both\"></div>\n                                    <div><span class=\"cvo-education-title\">Business Administration</span></div>\n                                                                            <div><span class=\"cvo-education-details\"><p><span class=\"ql-size-14px\">Excellent</span></p></span></div>\n                                                </div>\n                                   </div>\n        </div>\n        <div style=\"clear: both\"></div>\n    </div>\n                    <!-- Work -->\n    <div id=\"cvo-experience\" class=\"cvo-block\">\n        <div class=\"cvo-block-title\">\n            <h3><span id=\"cvo-experience-blocktitle\">Work experience</span></h3>\n        </div>\n        <div class=\"block-content\">\n            <div id=\"experience-table\">\n                            <!-- start row -->\n                <div class=\"row \">\n                    <div class=\"company\">\n                        <h4><span class=\"cvo-experience-company\">HJS Academy</span></h4>\n                    </div>\n                                        <div class=\"time\">\n                                                <h5><span class=\"cvo-experience-start start\">2022</span></h5>\n                                                                        -\n                                                                        <h5><span class=\"cvo-experience-end end\">2025</span></h5>\n                                            </div>\n                                        <div style=\"clear: both;\"></div>\n                                        <div><span class=\"cvo-experience-position\">Consultant</span></div>\n                                        <div class=\"cvo-experience-details\"><ul><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Provided personalized consultation based on student's learning goals. </span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Recommended suitable English courses aligned with students' interests and proficiency levels, clearly explaining course features, benefits, and how they differ from competitors.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Promoted special enrollment promotions and tuition discounts to increase conversion rates, consistently exceeding 150% of assigned KPIs.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Collected and maintained a database of over 5,000 potential learners for nurturing and follow-up, contributing to long-term customer engagement and upselling.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Collaborated with Marketing and Academic departments to develop strategies for customer acquisition and retention, helping increase overall company revenue by 200% within one year. </span></li></ul></div>\n                    <div style=\"clear: both\"></div>\n                </div>\n                <!-- end row -->\n                        <!-- start row -->\n                <div class=\"row \">\n                    <div class=\"company\">\n                        <h4><span class=\"cvo-experience-company\">TopCV BCD Company</span></h4>\n                    </div>\n                                        <div class=\"time\">\n                                                <h5><span class=\"cvo-experience-start start\">August 2018</span></h5>\n                                                                        -\n                                                                        <h5><span class=\"cvo-experience-end end\">July 2020</span></h5>\n                                            </div>\n                                        <div style=\"clear: both;\"></div>\n                                        <div><span class=\"cvo-experience-position\">Software Solution Consultant</span></div>\n                                        <div class=\"cvo-experience-details\"><ul><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Searched, consulted, and introduced software and hardware solutions (e.g., printers, barcode scanners) to approximately 50 customers daily, utilizing a database of 5,000 existing contacts and self-sourced 100 new leads per day. </span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Supported and guided customers in using software products both online and onsite, ensuring effective onboarding and usage.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Managed the sales process and contract signing, consistently exceeding 150% of the annual revenue KPI.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Maintained and developed a strong pipeline of potential customers, contributing to long-term business growth. </span></li></ul></div>\n                    <div style=\"clear: both\"></div>\n                </div>\n                <!-- end row -->\n                                </div>\n        </div>\n        <div style=\"clear: both\"></div>\n    </div>\n                    <!-- certification -->\n    <div id=\"cvo-certification\" class=\"cvo-block\">\n        <div class=\"cvo-block-title\">\n            <h3><span id=\"cvo-certification-blocktitle\">Certifications</span></h3>\n        </div>\n        <div class=\"block-content\">\n            <div id=\"certification-table\">\n                                            <!-- start row -->\n                    <div class=\"row \">\n                        <div class=\"certification\">\n                            <h4><span class=\"cvo-certification-title\"><p><strong class=\"ql-size-14px\">Training Program: Telephone Selling Skills</strong></p></span></h4>\n                        </div>\n                                                <div class=\"time\">\n                            <h5><span class=\"cvo-certification-time\">2022</span></h5>\n                        </div>\n                                                <div style=\"clear: both;\"></div>\n                    </div>\n                    <!-- end row -->\n                                <!-- start row -->\n                    <div class=\"row \">\n                        <div class=\"certification\">\n                            <h4><span class=\"cvo-certification-title\"><p><strong class=\"ql-size-14px\">Professional Customer Care Management training course</strong></p></span></h4>\n                        </div>\n                                                <div class=\"time\">\n                            <h5><span class=\"cvo-certification-time\">2021</span></h5>\n                        </div>\n                                                <div style=\"clear: both;\"></div>\n                    </div>\n                    <!-- end row -->\n                                        </div>\n        </div>\n        <div style=\"clear: both\"></div>\n    </div>\n                    <!-- Award -->\n    <div id=\"cvo-award\" class=\"cvo-block\">\n        <div class=\"cvo-block-title\">\n            <h3><span id=\"cvo-award-blocktitle\">Honors &amp; Awards</span></h3>\n        </div>\n        <div class=\"block-content\">\n            <div id=\"award-table\">\n                                            <!-- start row -->\n                    <div class=\"row \">\n                        <div class=\"award\">\n                            <h4><span class=\"cvo-award-title\"><p><strong class=\"ql-size-14px\">Best consultant in the third quarter of 2022</strong></p></span></h4>\n                        </div>\n                                                <div class=\"time\">\n                            <h5><span class=\"cvo-award-time\">2020</span></h5>\n                        </div>\n                                                <div style=\"clear: both;\"></div>\n                    </div>\n                    <!-- end row -->\n                                        </div>\n        </div>\n        <div style=\"clear: both\"></div>\n    </div>\n                </div>\n        <!-- END #group-content -->\n    </div>\n    <div style=\"clear: both\"></div>\n</div>\n<div id=\"cv-watermark\">\n   © topcv.vn\n</div>\n                    </div>\n                </div>\n            </div>", "rows": {"experience": "<div class=\"row \">\n                    <div class=\"company\">\n                        <h4><span class=\"cvo-experience-company\" contenteditable=\"true\">{{experience.company}}</span></h4>\n                    </div>\n                                        <div class=\"time\">\n                                                <h5><span class=\"cvo-experience-start start\" contenteditable=\"true\">{{experience.start}}</span></h5>\n                                                                        -\n                                                                        <h5><span class=\"cvo-experience-end end\" contenteditable=\"true\">{{experience.end}}</span></h5>\n                                            </div>\n                                        <div style=\"clear: both;\"></div>\n                                        <div><span class=\"cvo-experience-position\" contenteditable=\"true\">{{experience.position}}</span></div>\n                                        <div class=\"cvo-experience-details\" contenteditable=\"true\">{{!experience.details}}</div>\n                    <div style=\"clear: both\"></div>\n                </div>", "education": "<div class=\"row \">\n                <div class=\"school\">\n                    <h4><span class=\"cvo-education-school\" contenteditable=\"true\">{{education.school}}</span></h4>\n                </div>\n                                <div class=\"time\">\n                                        <h5><span class=\"cvo-education-start start\" contenteditable=\"true\">{{education.start}}</span></h5>\n                                                            -\n                                                            <h5><span class=\"cvo-education-end end\" contenteditable=\"true\">{{education.end}}</span></h5>\n                                    </div>\n                                <div style=\"clear: both\"></div>\n                                    <div><span class=\"cvo-education-title\" contenteditable=\"true\">{{education.title}}</span></div>\n                                                                            <div><span class=\"cvo-education-details\" contenteditable=\"true\"><p><span class=\"ql-size-14px\">{{education.details}}</span></p></span></div>\n                                                </div>", "skillgroup": "<div class=\"row\"><span class=\"cvo-skillgroup-area\" contenteditable=\"true\">{{skillgroup.area}}</span></div>", "award": "<div class=\"row \">\n                        <div class=\"award\">\n                            <h4><span class=\"cvo-award-title\" contenteditable=\"true\"><p><strong class=\"ql-size-14px\">{{award.title}}</strong></p></span></h4>\n                        </div>\n                                                <div class=\"time\">\n                            <h5><span class=\"cvo-award-time\" contenteditable=\"true\">{{award.time}}</span></h5>\n                        </div>\n                                                <div style=\"clear: both;\"></div>\n                    </div>", "certification": "<div class=\"row \">\n                        <div class=\"certification\">\n                            <h4><span class=\"cvo-certification-title\" contenteditable=\"true\"><p><strong class=\"ql-size-14px\">{{certification.title}}</strong></p></span></h4>\n                        </div>\n                                                <div class=\"time\">\n                            <h5><span class=\"cvo-certification-time\" contenteditable=\"true\">{{certification.time}}</span></h5>\n                        </div>\n                                                <div style=\"clear: both;\"></div>\n                    </div>"}, "rich": {"experience.details": {"before": "<ul>", "item": "<li class=\"ql-align-justify\"><span class=\"ql-size-14px\">{{.}}</span></li>", "after": "</ul>"}}, "cssFiles": ["96a83096b07c340646e1.css", "9c7d63ccc93f634ecf68.css", "883bd085469c4754d68a.css", "1eab4a161a635d7b907d.css", "86cc20d2f25b13832014.css", "a3b1f0f65d52171c74f1.css", "cf5fa69d993d15a8dc95.css", "c29c4d7ea5bc8b237940.css", "31649e0fc45729300251.css", "acb3f9d98586f0fe8aad.css", "e63e448ff512d9cbe09d.css", "9989f6c9652651a36899.css", "73d377c3d4ab57940cc3.css", "3454a12f65b2d0d923ce.css", "75a11da44c802486bc6f.css"], "source": "classic_1-en", "newBuilder": false, "errors": [], "rootConfig": {"bodyClass": "iframe", "bodyStyle": "", "htmlStyle": ""}}