-phone\" class=\"profile-content\" contenteditable=\"true\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">{{profile.phone}}</span></span></div>\n        <div id=\"cvo-profile-email-wraper\"><i class=\"fa fa-envelope-square scheme-color\"></i><span id=\"cvo-profile-email\" class=\"profile-content\" contenteditable=\"true\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">{{profile.email}}</span></span></div>\n                <div id=\"cvo-profile-address-wraper\"><i class=\"fa fa-map-marker scheme-color\"></i><span id=\"cvo-profile-address\" class=\"profile-content\" contenteditable=\"true\">{{profile.address}}</span></div>\n                        <div id=\"cvo-profile-website-wraper\"><i class=\"fa fa-info scheme-color\"></i><span id=\"cvo-profile-website\" class=\"profile-content\" contenteditable=\"true\"><span class=\"ql-size-13px\">{{profile.website}}</span></span></div>\n            </div>\n    <div style=\"clear: both\"></div>\n</div>\n            </div>\n            <!-- END #group-top-left -->\n            <div id=\"group-bottom-left\">\n                            {{?objective}}<div id=\"cvo-objective\" class=\"cvo-block\">\n    <div class=\"cvo-block-title no-horizontal-line scheme-color scheme-border-color\"><span id=\"cvo-objective-blocktitle\">CAREER OBJECTIVES</span></div>\n    <div id=\"cvo-objective-objective\" contenteditable=\"true\"><p class=\"ql-align-justify\"><span class=\"ql-size-14px\">{{objective.objective}}</span></p></div>\n</div>\n                            {{/objective}}{{?skillrate}}<div id=\"cvo-skillrate\" class=\"cvo-block\">\n    <div class=\"cvo-block-title scheme-color scheme-border-color\"><span id=\"cvo-skillrate-blocktitle\">SKILLS</span></div>\n    <div id=\"skillrate-table\">\n                        {{#skillrate}}</div>\n</div>\n                        {{/skillrate}}</div>\n        </div>\n        <!-- END #col-left -->\n        <!-- #col-right -->\n        <div id=\"col-right\">\n            <div id=\"group-col-right\">\n                            {{?education}}<div id=\"cvo-education\" class=\"cvo-block\">\n    <div class=\"cvo-block-title scheme-background-color\">\n        <span id=\"cvo-education-blocktitle\">Education</span>\n    </div>\n    <div id=\"education-table\">\n                        {{#education}}</div>\n</div>\n                            {{/education}}{{?experience}}<div id=\"cvo-experience\" class=\"cvo-block\">\n    <div class=\"cvo-block-title scheme-background-color\"><span id=\"cvo-experience-blocktitle\">Work experience</span></div>\n    <div id=\"experience-table\">\n                        {{#experience}}</div>\n    <div style=\"clear: both\"></div>\n</div>\n                            {{/experience}}{{?award}}<div id=\"cvo-award\" class=\"cvo-block\">\n    <div class=\"cvo-block-title scheme-background-color\"><span id=\"cvo-award-blocktitle\">Honors &amp; Awards</span></div>\n    <div id=\"award-table\">\n                        {{#award}}</div>\n    <div style=\"clear: both\"></div>\n</div>\n                            {{/award}}{{?certification}}<div id=\"cvo-certification\" class=\"cvo-block\">\n    <div class=\"cvo-block-title scheme-background-color\"><span id=\"cvo-certification-blocktitle\">Certifications</span></div>\n    <div id=\"certification-table\">\n                        {{#certification}}</div>\n    <div style=\"clear: both\"></div>\n</div>\n                        {{/certification}}</div>\n        </div>\n        <!-- END #col-right -->\n        <div style=\"clear: both;\"></div>\n    </div>\n</div>\n                    </div>\n                </div>\n            </div>", "originalBody": "<div id=\"cvo-document\" class=\"cvo-document\">\n                <div class=\"cvo-page\">\n                    <div class=\"cvo-subpage\">\n                        <div id=\"cvo-body\">\n    <!--Header-->\n    <div id=\"cvo-main\">\n        <div id=\"col-left\">\n            <!-- #group-top-left -->\n            <div id=\"group-top-left\">\n                <!-- FIXED GROUP -->\n                <div id=\"cvo-profile\" class=\"cvo-block\">\n    <div id=\"profile-title-wrapper\">\n                <div id=\"cvo-profile-avatar-wraper\" class=\"scheme-border-color\">\n            <img id=\"cvo-profile-avatar\" src=\"/api/cv/source-assets/640cf40b5d4541830388.png\" value=\"preview_avatar\" alt=\"avatar\">\n        </div>\n                <div>\n            <div id=\"cvo-profile-fullname\" class=\"scheme-color\"><strong class=\"ql-font-RobotoCondensed ql-size-23px\">PHAM HA AN</strong></div>\n                        <div id=\"cvo-profile-title\" class=\"scheme-color\"><strong class=\"ql-font-BeVietnamPro ql-size-18px\">Consultant</strong></div>\n                    </div>\n    </div>\n    <div id=\"profile-contact-wraper\">\n        <div class=\"cvo-block-title scheme-color scheme-border-color\"><span id=\"cvo-profile-blocktitle\">Contact information</span></div>\n                <div id=\"cvo-profile-dob-wraper\">\n            <i class=\"fa fa-calendar scheme-color\"></i><span id=\"cvo-profile-dob\" class=\"profile-content\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">August 24, 1996</span></span>\n        </div>\n                        <div id=\"cvo-profile-gender-wraper\"><i class=\"fa fa-user scheme-color\"></i><span id=\"cvo-profile-gender\" class=\"profile-content\"><span class=\"ql-size-13px\">Male/Female/Other</span></span></div>\n                <div id=\"cvo-profile-phone-wraper\"><i class=\"fa fa-phone scheme-color\"></i><span id=\"cvo-profile-phone\" class=\"profile-content\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">(024) 6680 5588</span></span></div>\n        <div id=\"cvo-profile-email-wraper\"><i class=\"fa fa-envelope-square scheme-color\"></i><span id=\"cvo-profile-email\" class=\"profile-content\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">hotro@topcv.vn</span></span></div>\n                <div id=\"cvo-profile-address-wraper\"><i class=\"fa fa-map-marker scheme-color\"></i><span id=\"cvo-profile-address\" class=\"profile-content\">Ba Dinh, Ha Noi</span></div>\n                        <div id=\"cvo-profile-website-wraper\"><i class=\"fa fa-info scheme-color\"></i><span id=\"cvo-profile-website\" class=\"profile-content\"><span class=\"ql-size-13px\">be.net/yourname</span></span></div>\n            </div>\n    <div style=\"clear: both\"></div>\n</div>\n            </div>\n            <!-- END #group-top-left -->\n            <div id=\"group-bottom-left\">\n                            <div id=\"cvo-objective\" class=\"cvo-block\">\n    <div class=\"cvo-block-title no-horizontal-line scheme-color scheme-border-color\"><span id=\"cvo-objective-blocktitle\">CAREER OBJECTIVES</span></div>\n    <div id=\"cvo-objective-objective\"><p class=\"ql-align-justify\"><span class=\"ql-size-14px\">Customer Consultant with 5 years of experience in product and course consulting at English centers and technology stores. Skilled in identifying potential customers, providing accurate information, and effectively persuading clients. Known for being quick-witted, adaptable, and thriving under pressure. Seeking a Customer Consultant position to contribute to revenue growth and customer acquisition for the company. </span></p></div>\n</div>\n                            <div id=\"cvo-skillrate\" class=\"cvo-block\">\n    <div class=\"cvo-block-title scheme-color scheme-border-color\"><span id=\"cvo-skillrate-blocktitle\">SKILLS</span></div>\n    <div id=\"skillrate-table\">\n                        <div class=\"row\">\n            <div><span class=\"cvo-skillrate-title\">Customer Needs Analysis</span></div>\n            <div class=\"cvo-skillrate-bar scheme-border-color\" bval=\"5\" rate-value=\"5\">\n                <span class=\"cvo-skillrate-value scheme-background-color\"></span>\n            </div>\n        </div>\n                <div class=\"row\">\n            <div><span class=\"cvo-skillrate-title\">Market Research &amp; Client Profiling</span></div>\n            <div class=\"cvo-skillrate-bar scheme-border-color\" bval=\"5\" rate-value=\"5\">\n                <span class=\"cvo-skillrate-value scheme-background-color\"></span>\n            </div>\n        </div>\n                <div class=\"row\">\n            <div><span class=\"cvo-skillrate-title\">Sales Pitch &amp; Persuasive Communication</span></div>\n            <div class=\"cvo-skillrate-bar scheme-border-color\" bval=\"5\" rate-value=\"5\">\n                <span class=\"cvo-skillrate-value scheme-background-color\"></span>\n            </div>\n        </div>\n                <div class=\"row\">\n            <div><span class=\"cvo-skillrate-title\">CRM Systems (e.g., Salesforce, HubSpot)</span></div>\n            <div class=\"cvo-skillrate-bar scheme-border-color\" bval=\"5\" rate-value=\"5\">\n                <span class=\"cvo-skillrate-value scheme-background-color\"></span>\n            </div>\n        </div>\n                <div class=\"row\">\n            <div><span class=\"cvo-skillrate-title\">Microsoft Office Suite (Excel, Word, PowerPoint)</span></div>\n            <div class=\"cvo-skillrate-bar scheme-border-color\" bval=\"5\" rate-value=\"5\">\n                <span class=\"cvo-skillrate-value scheme-background-color\"></span>\n            </div>\n        </div>\n                    </div>\n</div>\n                        </div>\n        </div>\n        <!-- END #col-left -->\n        <!-- #col-right -->\n        <div id=\"col-right\">\n            <div id=\"group-col-right\">\n                            <div id=\"cvo-education\" class=\"cvo-block\">\n    <div class=\"cvo-block-title scheme-background-color\">\n        <span id=\"cvo-education-blocktitle\">Education</span>\n    </div>\n    <div id=\"education-table\">\n                        <div class=\"row \">\n            <div class=\"row-title\">\n                <div class=\"cvo-education-first-line\">\n                    <div class=\"cvo-education-school-wraper\">\n                        <span class=\"cvo-education-school\">TopCV University</span>\n                    </div>\n                                        <div class=\"cvo-education-time\">\n                        &nbsp;/&nbsp;&nbsp;<span class=\"cvo-education-start\">2016</span><!--\n                        --><!--\n                        --><!--\n                            -->                            -\n                            <!--\n                        --><!--\n                        --><!--\n                        --><span class=\"cvo-education-end\">2020</span><!--\n                        -->                    </div>\n                                    </div>\n                <div style=\"clear:both;\"></div>\n                                <div>\n                    <span class=\"cvo-education-title\">Business Administration</span>\n                </div>\n                            </div>\n                        <div class=\"row-details\">\n                <div class=\"cvo-education-details\"><p><span class=\"ql-size-14px\">Excellent</span></p></div>\n            </div>\n                        <div style=\"clear:both;\"></div>\n        </div>\n                    </div>\n</div>\n                            <div id=\"cvo-experience\" class=\"cvo-block\">\n    <div class=\"cvo-block-title scheme-background-color\"><span id=\"cvo-experience-blocktitle\">Work experience</span></div>\n    <div id=\"experience-table\">\n                        <div class=\"row \">\n            <div class=\"row-title\">\n                <div class=\"cvo-experience-first-line\">\n                    <div class=\"cvo-experience-company-wraper\">\n                        <span class=\"cvo-experience-company\">HJS Academy</span>\n                    </div>\n                                        <div class=\"cvo-experience-time\">\n                        &nbsp;/&nbsp;&nbsp;<!--\n                        --><span class=\"cvo-experience-start\">2022</span><!--\n                        --><!--\n                        --><!--\n                         -->                            -\n                            <!--\n                        --><!--\n                        --><!--\n                        --><span class=\"cvo-experience-end\">2025</span><!--\n                        --><!--\n                    --></div><!--\n                    -->                </div>\n                <div style=\"clear:both;\"></div>\n                                <div>\n                    <span class=\"cvo-experience-position\">Consultant</span>\n                </div>\n                            </div>\n            <div class=\"row-details\">\n                <div class=\"cvo-experience-details\"><ul><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Provided personalized consultation based on student's learning goals. </span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Recommended suitable English courses aligned with students' interests and proficiency levels, clearly explaining course features, benefits, and how they differ from competitors.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Promoted special enrollment promotions and tuition discounts to increase conversion rates, consistently exceeding 150% of assigned KPIs.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Collected and maintained a database of over 5,000 potential learners for nurturing and follow-up, contributing to long-term customer engagement and upselling.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Collaborated with Marketing and Academic departments to develop strategies for customer acquisition and retention, helping increase overall company revenue by 200% within one year. </span></li></ul></div>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>\n                <div class=\"row \">\n            <div class=\"row-title\">\n                <div class=\"cvo-experience-first-line\">\n                    <div class=\"cvo-experience-company-wraper\">\n                        <span class=\"cvo-experience-company\">TopCV BCD Company</span>\n                    </div>\n                                        <div class=\"cvo-experience-time\">\n                        &nbsp;/&nbsp;&nbsp;<!--\n                        --><span class=\"cvo-experience-start\">August 2018</span><!--\n                        --><!--\n                        --><!--\n                         -->                            -\n                            <!--\n                        --><!--\n                        --><!--\n                        --><span class=\"cvo-experience-end\">July 2020</span><!--\n                        --><!--\n                    --></div><!--\n                    -->                </div>\n                <div style=\"clear:both;\"></div>\n                                <div>\n                    <span class=\"cvo-experience-position\">Software Solution Consultant</span>\n                </div>\n                            </div>\n            <div class=\"row-details\">\n                <div class=\"cvo-experience-details\"><ul><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Searched, consulted, and introduced software and hardware solutions (e.g., printers, barcode scanners) to approximately 50 customers daily, utilizing a database of 5,000 existing contacts and self-sourced 100 new leads per day. </span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Supported and guided customers in using software products both online and onsite, ensuring effective onboarding and usage.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Managed the sales process and contract signing, consistently exceeding 150% of the annual revenue KPI.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Maintained and developed a strong pipeline of potential customers, contributing to long-term business growth. </span></li></ul></div>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>\n                    </div>\n    <div style=\"clear: both\"></div>\n</div>\n                            <div id=\"cvo-award\" class=\"cvo-block\">\n    <div class=\"cvo-block-title scheme-background-color\"><span id=\"cvo-award-blocktitle\">Honors &amp; Awards</span></div>\n    <div id=\"award-table\">\n                        <div class=\"row \">\n            <div class=\"row-title\">\n                <div class=\"cvo-award-title-wraper\">\n                    <span class=\"cvo-award-title\"><p><strong class=\"ql-size-14px\">Best consultant in the third quarter of 2022</strong></p></span>\n                </div>\n                                <div class=\"cvo-award-time-wraper\">\n                    <span class=\"cvo-award-time\">2020</span>\n                </div>\n                                <div style=\"clear:both;\"></div>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>\n                    </div>\n    <div style=\"clear: both\"></div>\n</div>\n                            <div id=\"cvo-certification\" class=\"cvo-block\">\n    <div class=\"cvo-block-title scheme-background-color\"><span id=\"cvo-certification-blocktitle\">Certifications</span></div>\n    <div id=\"certification-table\">\n                        <div class=\"row \">\n            <div class=\"row-title\">\n                <div class=\"cvo-certification-title-wraper\">\n                    <span class=\"cvo-certification-title\"><p><strong class=\"ql-size-14px\">Training Program: Telephone Selling Skills</strong></p></span>\n                </div>\n                                <div class=\"cvo-certification-time-wraper\">\n                    <span class=\"cvo-certification-time\">2022</span>\n                </div>\n                                <div style=\"clear:both;\"></div>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>\n                <div class=\"row \">\n            <div class=\"row-title\">\n                <div class=\"cvo-certification-title-wraper\">\n                    <span class=\"cvo-certification-title\"><p><strong class=\"ql-size-14px\">Professional Customer Care Management training course</strong></p></span>\n                </div>\n                                <div class=\"cvo-certification-time-wraper\">\n                    <span class=\"cvo-certification-time\">2021</span>\n                </div>\n                                <div style=\"clear:both;\"></div>\n            </div>\n            <div style=\"clear:both;\"></div>\n        </div>\n                    </div>\n    <div style=\"clear: both\"></div>\n</div>\n                        </div>\n        </div>\n        <!-- END #col-right -->\n        <div style=\"clear: both;\"></div>\n    </div>\n</div>\n                    </div>\n                </div>\n            </div>", "rows": {"experience": "<div class=\"row \">\n            <div class=\"row-title\">\n                <div class=\"cvo-experience-first-line\">\n                    <div class=\"cvo-experience-company-wraper\">\n                        <span class=\"cvo-experience-company\" contenteditable=\"true\">{{experience.company}}</span>\n                    </div>\n                                        <div class=\"cvo-experience-time\">\n                         /  <!--\n                        --><span class=\"cvo-experience-start\" contenteditable=\"true\">{{experience.start}}</span><!--\n                        --><!--\n                        --><!--\n                         -->                            -\n                            <!--\n                        --><!--\n                        --><!--\n                        --><span class=\"cvo-experience-end\" contenteditable=\"true\">{{experience.end}}</span><!--\n                        --><!--\n                   