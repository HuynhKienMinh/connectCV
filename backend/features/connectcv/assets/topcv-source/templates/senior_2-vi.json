{"body": "<div id=\"cvo-document\" class=\"cvo-document\">\n                <div class=\"cvo-page\">\n                    <div class=\"cvo-subpage\">\n                        <div id=\"cvo-body\">\n    <div id=\"cvo-main\">\n        <!-- #group-header -->\n        <div id=\"group-header\">\n            <!-- FIXED GROUP -->\n            <div id=\"cvo-profile\" class=\"cvo-block\">\n    <!-- Header -->\n    <div id=\"cvo-header\" class=\"hide-avatar\">\n        <h1><span id=\"cvo-profile-fullname\" contenteditable=\"true\"><strong class=\"end-action ql-size-22px\">{{profile.fullname}}</strong></span></h1>\n                <p>\n            <span id=\"cvo-profile-address\" contenteditable=\"true\"><span class=\"end-action ql-size-13px\">{{profile.address}}</span></span>\n        </p>\n                <p>\n            <i class=\"fa fa-phone\"></i>\n            <span id=\"cvo-profile-phone\" contenteditable=\"true\"><span class=\"end-action ql-size-13px\">{{profile.phone}}</span></span>\n            <i class=\"fa fa-envelope\"></i>\n            <span id=\"cvo-profile-email\" contenteditable=\"true\"><span class=\"end-action ql-size-13px\">{{profile.email}}</span></span>\n                        <i class=\"fa fa-link\"></i>\n            <span id=\"cvo-profile-website\" contenteditable=\"true\"><span class=\"ql-size-13px\">{{profile.website}}</span></span>\n                    </p>\n        <div style=\"clear: both\"></div>\n    </div>\n    <div style=\"clear: both;\"></div>\n</div>\n        </div>\n        <!-- END #group-header -->\n        <!-- #group-content -->\n        <div id=\"group-content\">\n                    {{?objective}}<div id=\"cvo-objective\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\">\n        <h3><span id=\"cvo-objective-blocktitle\">Mục tiêu nghề nghiệp</span></h3>\n    </div>\n    <div class=\"block-content\">\n        <div class=\"cvo-block-body\">\n            <div id=\"cvo-objective-objective\" contenteditable=\"true\"><p class=\"ql-align-justify\">{{objective.objective}}</p></div>\n        </div>\n    </div>\n</div>                    {{/objective}}<!-- Education -->\n    {{?education}}<div id=\"cvo-education\" class=\"cvo-block\">\n        <div class=\"cvo-block-title\">\n            <h3><span id=\"cvo-education-blocktitle\">Học vấn</span></h3>\n        </div>\n        <div class=\"block-content\">\n           <div id=\"education-table\">\n                                    {{#education}}</div>\n        </div>\n        <div style=\"clear: both\"></div>\n    </div>\n                    {{/education}}{{?skillgroup}}<div id=\"cvo-skillgroup\" class=\"cvo-block\"><div class=\"cvo-block-title\">\n            <h3><span id=\"cvo-skillgroup-blocktitle\">Kỹ năng</span></h3>\n        </div>\n        <div id=\"skillgroup-table\" class=\"block-content\">{{#skillgroup}}</div></div>{{/skillgroup}}<!-- Work -->\n    {{?experience}}<div id=\"cvo-experience\" class=\"cvo-block\">\n        <div class=\"cvo-block-title\">\n            <h3><span id=\"cvo-experience-blocktitle\">Kinh nghiệm làm việc</span></h3>\n        </div>\n        <div class=\"block-content\">\n            <div id=\"experience-table\">\n                            <!-- start row -->\n                {{#experience}}<!-- end row -->\n                        <!-- start row -->\n                <!-- end row -->\n                                </div>\n        </div>\n        <div style=\"clear: both\"></div>\n    </div>\n                    {{/experience}}<!-- Social Activity -->\n    {{?activity}}<div id=\"cvo-activity\" class=\"cvo-block\">\n        <div class=\"cvo-block-title\">\n            <h3><span id=\"cvo-activity-blocktitle\">Hoạt động</span></h3>\n        </div>\n        <div class=\"block-content\">\n            <div id=\"activity-table\">\n                                    <!-- start row -->\n                {{#activity}}<!-- end row -->\n                                </div>\n        </div>\n        <div style=\"clear: both\"></div>\n    </div>\n                    {{/activity}}<!-- certification -->\n    {{?certification}}<div id=\"cvo-certification\" class=\"cvo-block\">\n        <div class=\"cvo-block-title\">\n            <h3><span id=\"cvo-certification-blocktitle\">Chứng chỉ</span></h3>\n        </div>\n        <div class=\"block-content\">\n            <div id=\"certification-table\">\n                                            <!-- start row -->\n                    {{#certification}}<!-- end row -->\n                                <!-- start row -->\n                    <!-- end row -->\n                                        </div>\n        </div>\n        <div style=\"clear: both\"></div>\n    </div>\n                    {{/certification}}<!-- Award -->\n    {{?award}}<div id=\"cvo-award\" class=\"cvo-block\">\n        <div class=\"cvo-block-title\">\n            <h3><span id=\"cvo-award-blocktitle\">Danh hiệu và giải thưởng</span></h3>\n        </div>\n        <div class=\"block-content\">\n            <div id=\"award-table\">\n                                            <!-- start row -->\n                    {{#award}}<!-- end row -->\n                                        </div>\n        </div>\n        <div style=\"clear: both\"></div>\n    </div>\n                    {{/award}}<!-- Reference -->\n    {{?reference}}<div id=\"cvo-reference\" class=\"cvo-block\">\n        <div class=\"cvo-block-title\">\n            <h3><span id=\"cvo-reference-blocktitle\">Người giới thiệu</span></h3>\n        </div>\n        <div class=\"block-content\">\n            <div id=\"reference-table\">\n                                                            {{#reference}}</div>\n            <div style=\"clear: both\"></div>\n        </div>\n    </div>\n                {{/reference}}</div>\n        <!-- END #group-content -->\n        <div style=\"clear: both;\"></div>\n    </div>\n</div>\n                    </div>\n                </div>\n            </div>", "originalBody": "<div id=\"cvo-document\" class=\"cvo-document\">\n                <div class=\"cvo-page\">\n                    <div class=\"cvo-subpage\">\n                        <div id=\"cvo-body\">\n    <div id=\"cvo-main\">\n        <!-- #group-header -->\n        <div id=\"group-header\">\n            <!-- FIXED GROUP -->\n            <div id=\"cvo-profile\" class=\"cvo-block\">\n    <!-- Header -->\n    <div id=\"cvo-header\" class=\"hide-avatar\">\n        <h1><span id=\"cvo-profile-fullname\"><strong class=\"end-action ql-size-22px\">Nguyễn Hoàng Anh</strong></span></h1>\n                <p>\n            <span id=\"cvo-profile-address\"><span class=\"end-action ql-size-13px\">Ba Đình, Hà Nội</span></span>\n        </p>\n                <p>\n            <i class=\"fa fa-phone\"></i>\n            <span id=\"cvo-profile-phone\"><span class=\"end-action ql-size-13px\">(024) 6680 5588</span></span>\n            <i class=\"fa fa-envelope\"></i>\n            <span id=\"cvo-profile-email\"><span class=\"end-action ql-size-13px\">hotro@topcv.vn</span></span>\n                        <i class=\"fa fa-link\"></i>\n            <span id=\"cvo-profile-website\"><span class=\"ql-size-13px\">be.net/tencuaban</span></span>\n                    </p>\n        <div style=\"clear: both\"></div>\n    </div>\n    <div style=\"clear: both;\"></div>\n</div>\n        </div>\n        <!-- END #group-header -->\n        <!-- #group-content -->\n        <div id=\"group-content\">\n                    <div id=\"cvo-objective\" class=\"cvo-block\">\n    <div class=\"cvo-block-title\">\n        <h3><span id=\"cvo-objective-blocktitle\">Mục tiêu nghề nghiệp</span></h3>\n    </div>\n    <div class=\"block-content\">\n        <div class=\"cvo-block-body\">\n            <div id=\"cvo-objective-objective\"><p class=\"ql-align-justify\">Tôi mong muốn ứng tuyển vào vị trí Tổng đài viên Chăm sóc khách hàng để tận dụng 3 năm kinh nghiệm xử lý yêu cầu và phản hồi khách hàng chuyên nghiệp, cùng với khả năng giao tiếp tiếng Anh tốt và tinh thần làm việc năng động, linh hoạt. Mục tiêu của tôi là không ngừng nâng cao trải nghiệm khách hàng, góp phần xây dựng hình ảnh chuyên nghiệp và thân thiện cho doanh nghiệp.</p></div>\n        </div>\n    </div>\n</div>                    <!-- Education -->\n    <div id=\"cvo-education\" class=\"cvo-block\">\n        <div class=\"cvo-block-title\">\n            <h3><span id=\"cvo-education-blocktitle\">Học vấn</span></h3>\n        </div>\n        <div class=\"block-content\">\n           <div id=\"education-table\">\n                                    <div class=\"row \">\n                <div class=\"school\">\n                    <h4><span class=\"cvo-education-school\">ĐH TopCV</span>\n                    - <span class=\"cvo-education-title\">Quản trị kinh doanh</span>                     </h4>\n                </div>\n                                <div class=\"time\">\n                                        <h5><span class=\"cvo-education-start start\">2016</span></h5>\n                                                            -\n                                                            <h5><span class=\"cvo-education-end end\">2020</span></h5>\n                                    </div>\n                                <div style=\"clear: both\"></div>\n                                                            <div><span class=\"cvo-education-details\"><p><span class=\"ql-size-13px end-action\">Tốt nghiệp loại Giỏi</span></p></span></div>\n                                                </div>\n                                   </div>\n        </div>\n        <div style=\"clear: both\"></div>\n    </div>\n                    <!-- Work -->\n    <div id=\"cvo-experience\" class=\"cvo-block\">\n        <div class=\"cvo-block-title\">\n            <h3><span id=\"cvo-experience-blocktitle\">Kinh nghiệm làm việc</span></h3>\n        </div>\n        <div class=\"block-content\">\n            <div id=\"experience-table\">\n                            <!-- start row -->\n                <div class=\"row \">\n                    <div class=\"company\">\n                        <h4><span class=\"cvo-experience-company\">SVT Finance Innovation Co.</span>\n                                                    - <span class=\"cvo-experience-position\">Tổng Đài Viên Chăm Sóc Khách Hàng</span>\n                                                </h4>\n                    </div>\n                                        <div class=\"time\">\n                                                <h5><span class=\"cvo-experience-start start\">08/2020</span></h5>\n                                                                        -\n                                                                        <h5><span class=\"cvo-experience-end end\">Nay</span></h5>\n                                            </div>\n                                        <div style=\"clear: both;\"></div>\n\n                    <div class=\"cvo-experience-details\"><ul><li class=\"ql-align-justify\">Tiếp nhận và giải đáp thắc mắc của phụ huynh liên quan đến khóa học, lịch học, học phí, chính sách hoàn trả qua điện thoại, Zalo và email.</li><li class=\"ql-align-justify\">Gọi điện nhắc lịch học, lịch kiểm tra, lịch đóng phí và tư vấn các chương trình ưu đãi mới phù hợp với từng nhóm học viên.</li><li class=\"ql-align-justify\">Phối hợp với bộ phận học vụ và giáo viên để xử lý các phản hồi từ phụ huynh về chất lượng giảng dạy hoặc tiến độ học tập của học viên.</li><li class=\"ql-align-justify\">Theo dõi mức độ hài lòng của phụ huynh, ghi nhận các phản hồi và đề xuất cải thiện trải nghiệm dịch vụ.</li><li class=\"ql-align-justify\">Cập nhật và quản lý thông tin khách hàng trên hệ thống CRM, đảm bảo dữ liệu đầy đủ, chính xác và dễ truy xuất.</li><li class=\"ql-align-justify\">Tham gia đào tạo nội bộ và cập nhật kiến thức khóa học để hỗ trợ tư vấn và chăm sóc khách hàng hiệu quả hơn.</li><li class=\"ql-align-justify\">Thành tích:&nbsp;Duy trì tỷ lệ hài lòng của phụ huynh trên 95% trong 12 tháng liên tiếp (dựa trên khảo sát nội bộ sau khóa học).</li></ul></div>\n                    <div style=\"clear: both\"></div>\n                </div>\n                <!-- end row -->\n                        <!-- start row -->\n                <div class=\"row \">\n                    <div class=\"company\">\n                        <h4><span class=\"cvo-experience-company\">SVT Investment &amp; Development Co., Ltd</span>\n                                                    - <span class=\"cvo-experience-position\">Chuyên Viên Tư Vấn Giải Pháp Phần Mềm</span>\n                                                </h4>\n                    </div>\n                                        <div class=\"time\">\n                                                <h5><span class=\"cvo-experience-start start\">08/2018</span></h5>\n                                                                        -\n                                                                        <h5><span class=\"cvo-experience-end end\">07/2020</span></h5>\n                                            </div>\n                                        <div style=\"clear: both;\"></div>\n\n                    <div class=\"cvo-experience-details\"><ul><li class=\"ql-align-justify\">Phân tích nhu cầu và quy trình quản lý nhân sự của khách hàng, từ đó đề xuất giải pháp phần mềm chấm công, tính lương, quản lý ca phù hợp.</li><li class=\"ql-align-justify\">Tư vấn giải pháp và trình bày demo sản phẩm cho khách hàng doanh nghiệp, giúp họ hiểu rõ tính năng và lợi ích của phần mềm.</li><li class=\"ql-align-justify\">Làm việc cùng đội ngũ kỹ thuật để tùy chỉnh phần mềm theo yêu cầu đặc thù của từng doanh nghiệp (ca kíp phức tạp, quy định tính công riêng...).</li><li class=\"ql-align-justify\">Hướng dẫn sử dụng phần mềm cho khách hàng (trực tiếp hoặc online), xây dựng tài liệu hướng dẫn, hỗ trợ trong quá trình triển khai ban đầu.</li><li class=\"ql-align-justify\">Theo dõi hiệu quả sau triển khai và hỗ trợ bảo trì, tiếp nhận phản hồi và phối hợp cải tiến giải pháp cho phù hợp với quy mô, nhu cầu thực tế của khách hàng.</li></ul></div>\n                    <div style=\"clear: both\"></div>\n                </div>\n                <!-- end row -->\n                                </div>\n        </div>\n        <div style=\"clear: both\"></div>\n    </div>\n                    <!-- Social Activity -->\n    <div id=\"cvo-activity\" class=\"cvo-block\">\n        <div class=\"cvo-block-title\">\n            <h3><span id=\"cvo-activity-blocktitle\">Hoạt động</span></h3>\n        </div>\n        <div class=\"block-content\">\n            <div id=\"activity-table\">\n                                    <!-- start row -->\n                <div class=\"row \">\n                    <div class=\"organization\">\n                        <h4><span class=\"cvo-activity-organization\">Câu lạc bộ Sự kiện, trường Đại học TopCV</span>\n                                                        - <span class=\"cvo-activity-position\">Ban Sự Kiện</span>\n                                                    </h4>\n                    </div>\n                                        <div class=\"time\">\n                                                <h5><span class=\"cvo-activity-start start\">06/2016</span></h5>\n                                                                            -\n                                                                        <h5><span class=\"cvo-activity-end end\">09/2020</span></h5>\n                                            </div>\n                                        <div style=\"clear: both;\"></div>\n\n                    <div>\n                        <div class=\"cvo-activity-details\"><ul><li class=\"ql-align-justify\"><span class=\"end-action ql-size-13px\">Xây dựng 5 sự kiện chào đón tân sinh viên với 5000 sinh viên tham gia. </span></li><li class=\"ql-align-justify\"><span class=\"ql-size-13px end-action\">Hỗ trợ 500 tân sinh viên mỗi năm làm hồ sơ, tìm hiểu về nhà trường. </span></li><li class=\"ql-align-justify\"><span class=\"ql-size-13px end-action\">Giao tiếp và hỗ trợ thông tin cho phụ huynh.</span></li></ul></div>\n                    </div>\n                    <div style=\"clear: both\"></div>\n                </div>\n                <!-- end row -->\n                                </div>\n        </div>\n        <div style=\"clear: both\"></div>\n    </div>\n                    <!-- certification -->\n    <div id=\"cvo-certification\" class=\"cvo-block\">\n        <div class=\"cvo-block-title\">\n            <h3><span id=\"cvo-certification-blocktitle\">Chứng chỉ</span></h3>\n        </div>\n        <div class=\"block-content\">\n            <div id=\"certification-table\">\n                                            <!-- start row -->\n                    <div class=\"row \">\n                        <div class=\"certification\">\n                            <h4><span class=\"cvo-certification-title\"><p><span class=\"ql-size-13px\">Chương trình đào tạo: Kỹ Năng Bán Hàng Qua Điện Thoại</span></p></span></h4>\n                        </div>\n                                                <div class=\"time\">\n                            <h5><span class=\"cvo-certification-time\">2022</span></h5>\n                        </div>\n                                                <div style=\"clear: both;\"></div>\n                    </div>\n                    <!-- end row -->\n                                <!-- start row -->\n                    <div class=\"row \">\n                        <div class=\"certification\">\n                            <h4><span class=\"cvo-certification-title\"><p><span class=\"ql-size-13px\">Đào tạo Quản Lý Chăm Sóc Khách Hàng Chuyên Nghiệp</span></p></span></h4>\n                        </div>\n                                                <div class=\"time\">\n                            <h5><span class=\"cvo-certification-time\">2021</span></h5>\n                        </div>\n                                                <div style=\"clear: both;\"></div>\n                    </div>\n                    <!-- end row -->\n                                        </div>\n        </div>\n        <div style=\"clear: both\"></div>\n    </div>\n                    <!-- Award -->\n    <div id=\"cvo-award\" class=\"cvo-block\">\n        <div class=\"cvo-block-title\">\n            <h3><span id=\"cvo-award-blocktitle\">Danh hiệu và giải thưởng</span></h3>\n        </div>\n        <div class=\"block-content\">\n            <div id=\"award-table\">\n                                            <!-- start row -->\n                    <div class=\"row \">\n                        <div class=\"award\">\n                            <h4><span class=\"cvo-award-title\"><p><span class=\"ql-size-13px\">Tư vấn viên xuất sắc nhất Quý 3/2020</span></p></span></h4>\n                        </div>\n                                                <div class=\"time\">\n                            <h5><span class=\"cvo-award-time\">2020</span></h5>\n                        </div>\n                                                <div style=\"clear: both;\"></div>\n                    </div>\n                    <!-- end row -->\n                                        </div>\n        </div>\n        <div style=\"clear: both\"></div>\n    </div>\n                    <!-- Reference -->\n    <div id=\"cvo-reference\" class=\"cvo-block\">\n        <div class=\"cvo-block-title\">\n            <h3><span id=\"cvo-reference-blocktitle\">Người giới thiệu</span></h3>\n        </div>\n        <div class=\"block-content\">\n            <div id=\"reference-table\">\n                                                            <div class=\"row\">\n                            <div>\n                                <span class=\"cvo-reference-content\">\n                                                                        <p>Đỗ Quỳnh Mai - HR Director - SVT Finance Innovation Co.</p><p>Tel.: (024) 6680 5588</p>\n                                </span>\n                            </div>\n                        </div>\n                                            <div class=\"row\">\n                            <div>\n                                <span class=\"cvo-reference-content\">\n                                                                        <p>Toàn Viên Hựu - HRBP Manager - SVT Investment &amp; Development Co., Ltd</p><p>Tel.: (024) 6680 5588</p>\n                                </span>\n                            </div>\n                        </div>\n                                                </div>\n            <div style=\"clear: both\"></div>\n        </div>\n    </div>\n                </div>\n        <!-- END #group-content -->\n        <div style=\"clear: both;\"></div>\n    </div>\n</div>\n                    </div>\n                </div>\n            </div>", "rows": {"experience": "<div class=\"row \">\n                    <div class=\"company\">\n                        <h4><span class=\"cvo-experience-company\" contenteditable=\"true\">{{experience.company}}</span>\n                                                    - <span class=\"cvo-experience-position\" contenteditable=\"true\">{{experience.position}}</span>\n                                                </h4>\n                    </div>\n                                        <div class=\"time\">\n                                                <h5><span class=\"cvo-experience-start start\" contenteditable=\"true\">{{experience.start}}</span></h5>\n                                                                        -\n                                                                        <h5><span class=\"cvo-experience-end end\" contenteditable=\"true\">{{experience.end}}</span></h5>\n                                            </div>\n                                   