{"body": "<div id=\"cvo-document\" class=\"cvo-document\">\n                <div class=\"cvo-page\">\n                    <div class=\"cvo-subpage\">\n                        <div id=\"cvo-body\">\n    <div id=\"cvo-main\">\n        <div id=\"group-header\">\n            <div class=\"cvo-col-7\">\n                                    <div id=\"cvo-profile-avatar-wraper\" class=\"profile-item\">\n                        <img id=\"cvo-profile-avatar\" src=\"{{profile.avatar}}\" value=\"preview_avatar\" alt=\"{{profile.fullname}}\">\n                    </div>\n                                <div class=\"cvo-profile-fullname-and-title\">\n                    <div id=\"cvo-profile-fullname-wraper\">\n                        <span id=\"cvo-profile-fullname\" contenteditable=\"true\"><strong class=\"ql-font-RobotoCondensed ql-size-23px\">{{profile.fullname}}</strong></span>\n                    </div>\n                                        <div id=\"cvo-profile-title-wraper\">\n                        <span id=\"cvo-profile-title\" contenteditable=\"true\"><strong class=\"ql-font-BeVietnamPro ql-size-18px\">{{profile.title}}</strong></span>\n                    </div>\n                                    </div>\n            </div>\n            <div class=\"cvo-col-5\">\n                <div id=\"cvo-profile\" class=\"cvo-block\">\n        <div class=\"contact-item\">\n        Gender: <span id=\"cvo-profile-gender\" contenteditable=\"true\"><span class=\"ql-size-13px\">{{profile.gender}}</span></span>\n    </div>\n                <div class=\"contact-item\">\n            Date of birth: <span id=\"cvo-profile-dob\" contenteditable=\"true\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">{{profile.dob}}</span></span>\n        </div>\n        <div class=\"contact-item\">\n        Email: <span id=\"cvo-profile-email\" contenteditable=\"true\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">{{profile.email}}</span></span>\n    </div>\n    <div class=\"contact-item\">\n        Phone: <span id=\"cvo-profile-phone\" contenteditable=\"true\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">{{profile.phone}}</span></span>\n    </div>\n    <div class=\"contact-item\">\n        Address: <span id=\"cvo-profile-address\" contenteditable=\"true\">{{profile.address}}</span>\n    </div>\n        <div class=\"contact-item\">\n        Website: <span id=\"cvo-profile-website\" contenteditable=\"true\"><span class=\"ql-size-13px\">{{profile.website}}</span></span>\n    </div>\n    </div>\n            </div>\n        </div>\n        <div class=\"cvo-col-7\">\n            <div id=\"group-left\">\n                                    {{?objective}}<div id=\"cvo-objective\" class=\"cvo-block\">\n    <div class=\"cvo-block-header\">\n        <span id=\"cvo-objective-blocktitle\">CAREER OBJECTIVES</span>\n    </div>\n    <div class=\"cvo-block-body\">\n        <div id=\"cvo-objective-objective\" contenteditable=\"true\"><p class=\"ql-align-justify\"><span class=\"ql-size-14px\">{{objective.objective}}</span></p></div>\n    </div>\n</div>                                    {{/objective}}{{?education}}<div id=\"cvo-education\" class=\"cvo-block\">\n    <div class=\"cvo-block-header\">\n        <span id=\"cvo-education-blocktitle\">Education</span>\n    </div>\n    <div id=\"education-table\" class=\"cvo-block-body\">\n                        {{#education}}</div>\n</div>\n                                    {{/education}}{{?skillgroup}}<div id=\"cvo-skillgroup\" class=\"cvo-block\"><div class=\"cvo-block-title\">Skills</div><div id=\"skillgroup-table\" class=\"block-content\">{{#skillgroup}}</div></div>{{/skillgroup}}{{?experience}}<div id=\"cvo-experience\" class=\"cvo-block\">\n    <div class=\"cvo-block-header\">\n        <span id=\"cvo-experience-blocktitle\">Work experience</span>\n    </div>\n    <div id=\"experience-table\" class=\"cvo-block-body\">\n                        {{#experience}}</div>\n</div>\n                            {{/experience}}</div>\n        </div>\n        <div class=\"cvo-col-5\">\n            <div id=\"group-right\">\n                                    {{?award}}<div id=\"cvo-award\" class=\"cvo-block\">\n    <div class=\"cvo-block-header\"><span id=\"cvo-award-blocktitle\">Honors &amp; Awards</span></div>\n    <div id=\"award-table\" class=\"cvo-block-body\">\n                        {{#award}}</div>\n    <div style=\"clear: both\"></div>\n</div>\n                                    {{/award}}{{?certification}}<div id=\"cvo-certification\" class=\"cvo-block\">\n    <div class=\"cvo-block-header\"><span id=\"cvo-certification-blocktitle\">Certifications</span></div>\n    <div id=\"certification-table\" class=\"cvo-block-body\">\n                        {{#certification}}</div>\n    <div style=\"clear: both\"></div>\n</div>\n                            {{/certification}}</div>\n        </div>\n        <div style=\"clear: both;\"></div>\n    </div>\n</div>\n                    </div>\n                </div>\n            </div>", "originalBody": "<div id=\"cvo-document\" class=\"cvo-document\">\n                <div class=\"cvo-page\">\n                    <div class=\"cvo-subpage\">\n                        <div id=\"cvo-body\">\n    <div id=\"cvo-main\">\n        <div id=\"group-header\">\n            <div class=\"cvo-col-7\">\n                                    <div id=\"cvo-profile-avatar-wraper\" class=\"profile-item\">\n                        <img id=\"cvo-profile-avatar\" src=\"/api/cv/source-assets/640cf40b5d4541830388.png\" value=\"preview_avatar\" alt=\"avatar\">\n                    </div>\n                                <div class=\"cvo-profile-fullname-and-title\">\n                    <div id=\"cvo-profile-fullname-wraper\">\n                        <span id=\"cvo-profile-fullname\"><strong class=\"ql-font-RobotoCondensed ql-size-23px\">PHAM HA AN</strong></span>\n                    </div>\n                                        <div id=\"cvo-profile-title-wraper\">\n                        <span id=\"cvo-profile-title\"><strong class=\"ql-font-BeVietnamPro ql-size-18px\">Consultant</strong></span>\n                    </div>\n                                    </div>\n            </div>\n            <div class=\"cvo-col-5\">\n                <div id=\"cvo-profile\" class=\"cvo-block\">\n        <div class=\"contact-item\">\n        Gender: <span id=\"cvo-profile-gender\"><span class=\"ql-size-13px\">Male/Female/Other</span></span>\n    </div>\n                <div class=\"contact-item\">\n            Date of birth: <span id=\"cvo-profile-dob\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">August 24, 1996</span></span>\n        </div>\n        <div class=\"contact-item\">\n        Email: <span id=\"cvo-profile-email\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">hotro@topcv.vn</span></span>\n    </div>\n    <div class=\"contact-item\">\n        Phone: <span id=\"cvo-profile-phone\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">(024) 6680 5588</span></span>\n    </div>\n    <div class=\"contact-item\">\n        Address: <span id=\"cvo-profile-address\">Ba Dinh, Ha Noi</span>\n    </div>\n        <div class=\"contact-item\">\n        Website: <span id=\"cvo-profile-website\"><span class=\"ql-size-13px\">be.net/yourname</span></span>\n    </div>\n    </div>\n            </div>\n        </div>\n        <div class=\"cvo-col-7\">\n            <div id=\"group-left\">\n                                    <div id=\"cvo-objective\" class=\"cvo-block\">\n    <div class=\"cvo-block-header\">\n        <span id=\"cvo-objective-blocktitle\">CAREER OBJECTIVES</span>\n    </div>\n    <div class=\"cvo-block-body\">\n        <div id=\"cvo-objective-objective\"><p class=\"ql-align-justify\"><span class=\"ql-size-14px\">Customer Consultant with 5 years of experience in product and course consulting at English centers and technology stores. Skilled in identifying potential customers, providing accurate information, and effectively persuading clients. Known for being quick-witted, adaptable, and thriving under pressure. Seeking a Customer Consultant position to contribute to revenue growth and customer acquisition for the company. </span></p></div>\n    </div>\n</div>                                    <div id=\"cvo-education\" class=\"cvo-block\">\n    <div class=\"cvo-block-header\">\n        <span id=\"cvo-education-blocktitle\">Education</span>\n    </div>\n    <div id=\"education-table\" class=\"cvo-block-body\">\n                        <div class=\"row \">\n                            <div><span class=\"cvo-education-title\">Business Administration</span></div>\n                        <div class=\"cvo-section-info\">\n                <div class=\"cvo-education-school-wraper\">\n                    <i class=\"fa fa-briefcase\" aria-hidden=\"true\"></i>\n                    <span class=\"cvo-education-school\">TopCV University</span>\n                </div>\n                                <div class=\"cvo-education-time\">\n                    <i class=\"fa fa-calendar-o\" aria-hidden=\"true\"></i>\n                    <span class=\"time-background\">\n                                                <span class=\"cvo-education-start\">2016</span>\n                                                 -                                                 <span class=\"cvo-education-end\">2020</span>\n                                            </span>\n                </div>\n                            </div>\n                        <div class=\"cvo-education-details\"><p><span class=\"ql-size-14px\">Excellent</span></p></div>\n                    </div>\n                    </div>\n</div>\n                                    <div id=\"cvo-experience\" class=\"cvo-block\">\n    <div class=\"cvo-block-header\">\n        <span id=\"cvo-experience-blocktitle\">Work experience</span>\n    </div>\n    <div id=\"experience-table\" class=\"cvo-block-body\">\n                        <div class=\"row \">\n                            <div><span class=\"cvo-experience-position\">Consultant</span></div>\n                        <div class=\"cvo-section-info\">\n                <div class=\"cvo-experience-company-wraper\">\n                    <i class=\"fa fa-building\" aria-hidden=\"true\"></i>\n                    <span class=\"cvo-experience-company\">HJS Academy</span>\n                </div>\n                                <div class=\"cvo-experience-time\">\n                    <i class=\"fa fa-calendar-o\" aria-hidden=\"true\"></i>\n                    <span class=\"time-background\">\n                                                <span class=\"cvo-experience-start\">2022</span>\n                                                                        -\n                                                                        <span class=\"cvo-experience-end\">2025</span>\n                                            </span>\n                </div>\n                            </div>\n            <div class=\"cvo-experience-details\"><ul><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Provided personalized consultation based on student's learning goals. </span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Recommended suitable English courses aligned with students' interests and proficiency levels, clearly explaining course features, benefits, and how they differ from competitors.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Promoted special enrollment promotions and tuition discounts to increase conversion rates, consistently exceeding 150% of assigned KPIs.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Collected and maintained a database of over 5,000 potential learners for nurturing and follow-up, contributing to long-term customer engagement and upselling.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Collaborated with Marketing and Academic departments to develop strategies for customer acquisition and retention, helping increase overall company revenue by 200% within one year. </span></li></ul></div>\n        </div>\n                <div class=\"row \">\n                            <div><span class=\"cvo-experience-position\">Software Solution Consultant</span></div>\n                        <div class=\"cvo-section-info\">\n                <div class=\"cvo-experience-company-wraper\">\n                    <i class=\"fa fa-building\" aria-hidden=\"true\"></i>\n                    <span class=\"cvo-experience-company\">TopCV BCD Company</span>\n                </div>\n                                <div class=\"cvo-experience-time\">\n                    <i class=\"fa fa-calendar-o\" aria-hidden=\"true\"></i>\n                    <span class=\"time-background\">\n                                                <span class=\"cvo-experience-start\">August 2018</span>\n                                                                        -\n                                                                        <span class=\"cvo-experience-end\">July 2020</span>\n                                            </span>\n                </div>\n                            </div>\n            <div class=\"cvo-experience-details\"><ul><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Searched, consulted, and introduced software and hardware solutions (e.g., printers, barcode scanners) to approximately 50 customers daily, utilizing a database of 5,000 existing contacts and self-sourced 100 new leads per day. </span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Supported and guided customers in using software products both online and onsite, ensuring effective onboarding and usage.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Managed the sales process and contract signing, consistently exceeding 150% of the annual revenue KPI.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Maintained and developed a strong pipeline of potential customers, contributing to long-term business growth. </span></li></ul></div>\n        </div>\n                    </div>\n</div>\n                            </div>\n        </div>\n        <div class=\"cvo-col-5\">\n            <div id=\"group-right\">\n                                    <div id=\"cvo-award\" class=\"cvo-block\">\n    <div class=\"cvo-block-header\"><span id=\"cvo-award-blocktitle\">Honors &amp; Awards</span></div>\n    <div id=\"award-table\" class=\"cvo-block-body\">\n                        <div class=\"row \">\n                            <span class=\"cvo-award-time\">2020</span>\n                        <span class=\"cvo-award-symbol\">:</span>\n            <span class=\"cvo-award-title\"><p><strong class=\"ql-size-14px\">Best consultant in the third quarter of 2022</strong></p></span>\n            <div style=\"clear:both;\"></div>\n        </div>\n                    </div>\n    <div style=\"clear: both\"></div>\n</div>\n                                    <div id=\"cvo-certification\" class=\"cvo-block\">\n    <div class=\"cvo-block-header\"><span id=\"cvo-certification-blocktitle\">Certifications</span></div>\n    <div id=\"certification-table\" class=\"cvo-block-body\">\n                        <div class=\"row \">\n                            <span class=\"cvo-certification-time\">2022</span>\n                        <span class=\"cvo-certification-symbol\">:</span>\n            <span class=\"cvo-certification-title\"><p><strong class=\"ql-size-14px\">Training Program: Telephone Selling Skills</strong></p></span>\n            <div style=\"clear:both;\"></div>\n        </div>\n                <div class=\"row \">\n                            <span class=\"cvo-certification-time\">2021</span>\n                        <span class=\"cvo-certification-symbol\">:</span>\n            <span class=\"cvo-certification-title\"><p><strong class=\"ql-size-14px\">Professional Customer Care Management training course</strong></p></span>\n            <div style=\"clear:both;\"></div>\n        </div>\n                    </div>\n    <div style=\"clear: both\"></div>\n</div>\n                            </div>\n        </div>\n        <div style=\"clear: both;\"></div>\n    </div>\n</div>\n                    </div>\n                </div>\n            </div>", "rows": {"experience": "<div class=\"row \">\n                            <div><span class=\"cvo-experience-position\" contenteditable=\"true\">{{experience.position}}</span></div>\n                        <div class=\"cvo-section-info\">\n                <div class=\"cvo-experience-company-wraper\">\n                    <i class=\"fa fa-building\" aria-hidden=\"true\"></i>\n                    <span class=\"cvo-experience-company\" contenteditable=\"true\">{{experience.company}}</span>\n                </div>\n                                <div class=\"cvo-experience-time\">\n                    <i class=\"fa fa-calendar-o\" aria-hidden=\"true\"></i>\n                    <span class=\"time-background\">\n                                                <span class=\"cvo-experience-start\" contenteditable=\"true\">{{experience.start}}</span>\n                                                                        -\n                                                                        <span class=\"cvo-experience-end\" contenteditable=\"true\">{{experience.end}}</span>\n                                            </span>\n                </div>\n                            </div>\n            <div class=\"cvo-experience-details\" contenteditable=\"true\">{{!experience.details}}</div>\n        </div>", "education": "<div class=\"row \">\n                            <div><span class=\"cvo-education-title\" contenteditable=\"true\">{{education.title}}</span></div>\n                        <div class=\"cvo-section-info\">\n                <div class=\"cvo-education-school-wraper\">\n                    <i class=\"fa fa-briefcase\" aria-hidden=\"true\"></i>\n                    <span class=\"cvo-education-school\" contenteditable=\"true\">{{education.school}}</span>\n                </div>\n                                <div class=\"cvo-education-time\">\n                    <i class=\"fa fa-calendar-o\" aria-hidden=\"true\"></i>\n                    <span class=\"time-background\">\n                                                <span class=\"cvo-education-start\" contenteditable=\"true\">{{education.start}}</span>\n                                                 -                                                 <span class=\"cvo-education-end\" contenteditable=\"true\">{{education.end}}</span>\n                                            </span>\n                </div>\n                            </div>\n                        <div class=\"cvo-education-details\" contenteditable=\"true\"><p><span class=\"ql-size-14px\">{{education.details}}</span></p></div>\n                    </div>", "skillgroup": "<div class=\"row\"><span class=\"cvo-skillgroup-area\" contenteditable=\"true\">{{skillgroup.area}}</span></div>", "award": "<div class=\"row \">\n                            <span class=\"cvo-award-time\" contenteditable=\"true\">{{award.time}}</span>\n                        <span class=\"cvo-award-symbol\">:</span>\n            <span class=\"cvo-award-title\" contenteditable=\"true\"><p><strong class=\"ql-size-14px\">{{award.title}}</strong></p></span>\n            <div style=\"clear:both;\"></div>\n        </div>", "certification": "<div class=\"row \">\n                            <span class=\"cvo-certification-time\" contenteditable=\"true\">{{certification.time}}</span>\n                        <span class=\"cvo-certification-symbol\">:</span>\n            <span class=\"cvo-certification-title\" contenteditable=\"true\"><p><strong class=\"ql-size-14px\">{{certification.title}}</strong></p></span>\n            <div style=\"clear:both;\"></div>\n        </div>"}, "rich": {"experience.details": {"before": "<ul>", "item": "<li class=\"ql-align-justify\"><span class=\"ql-size-14px\">{{.}}</span></li>", "after": "</ul>"}}, "cssFiles": ["96a83096b07c340646e1.css", "9c7d63ccc93f634ecf68.css", "883bd085469c4754d68a.css", "1eab4a161a635d7b907d.css", "86cc20d2f25b13832014.css", "a3b1f0f65d52171c74f1.css", "cf5fa69d993d15a8dc95.css", "bd42b0dad7201bbdc6a8.css", "31649e0fc45729300251.css", "acb3f9d98586f0fe8aad.css", "e63e448ff512d9cbe09d.css", "9989f6c9652651a36899.css", "73d377c3d4ab57940cc3.css", "3454a12f65b2d0d923ce.css", "75a11da44c802486bc6f.css"], "source": "impressive_5-en", "newBuilder": false, "errors": [], "rootConfig": {"bodyClass": "iframe", "htmlStyle": ""}}