itable=\"true\"><p><span class=\"ql-size-14px\">{{education.details}}</span></p></div>\n                    </div>", "skillgroup": "<div class=\"row\"><span class=\"cvo-skillgroup-area\" contenteditable=\"true\">{{skillgroup.area}}</span></div>", "award": "<div class=\"row \">\n                            <div class=\"cvo-award-wrapper\"><span class=\"cvo-award-time\" contenteditable=\"true\">{{award.time}}</span></div>\n                        <div class=\"cvo-award-title\" contenteditable=\"true\"><p><strong class=\"ql-size-14px\">{{award.title}}</strong></p></div>\n            <div style=\"clear:both;\"></div>\n        </div>"}, "rich": {"experience.details": {"before": "<ul>", "item": "<li class=\"ql-align-justify\"><span class=\"ql-size-14px\">{{.}}</span></li>", "after": "</ul>"}}, "cssFiles": ["96a83096b07c340646e1.css", "9c7d63ccc93f634ecf68.css", "883bd085469c4754d68a.css", "1eab4a161a635d7b907d.css", "86cc20d2f25b13832014.css", "a3b1f0f65d52171c74f1.css", "cf5fa69d993d15a8dc95.css", "4f5d85ef236590d3438d.css", "f4c3fedddfea28add2b2.css", "31649e0fc45729300251.css", "acb3f9d98586f0fe8aad.css", "e63e448ff512d9cbe09d.css", "9989f6c9652651a36899.css", "73d377c3d4ab57940cc3.css", "3454a12f65b2d0d923ce.css", "75a11da44c802486bc6f.css"], "source": "chrome-en", "newBuilder": false, "errors": [], "rootConfig": {"bodyClass": "iframe", "htmlStyle": ""}}