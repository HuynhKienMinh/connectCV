           <span class=\"cvo-profile-info-value\" id=\"cvo-profile-phone\" contenteditable=\"true\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">{{profile.phone}}</span></span>\n                        </div>\n                        <div class=\"cvo-profile-info-row\" id=\"cvo-profile-email-wraper\">\n                            <i class=\"fa fa-envelope\" aria-hidden=\"true\"></i>\n                            <span class=\"cvo-profile-info-value\" id=\"cvo-profile-email\" contenteditable=\"true\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">{{profile.email}}</span></span>\n                        </div>\n                                                    <div class=\"cvo-profile-info-row\">\n                                <i class=\"fa fa-globe\" aria-hidden=\"true\"></i>\n                                <span id=\"cvo-profile-website\" contenteditable=\"true\"><span class=\"ql-size-13px\">{{profile.website}}</span></span>\n                            </div>\n                                                                            <div class=\"cvo-profile-info-row\" id=\"cvo-profile-address-wraper\">\n                                <i class=\"fa fa-location-arrow\" aria-hidden=\"true\"></i>\n                                <span class=\"cvo-profile-info-value\" id=\"cvo-profile-address\" contenteditable=\"true\">{{profile.address}}</span>\n                            </div>\n                                                                            <div class=\"cvo-profile-info-row\" id=\"cvo-profile-gender-wraper\">\n                                <i class=\"fa fa-user\" aria-hidden=\"true\"></i>\n                                <span class=\"cvo-profile-info-value\" id=\"cvo-profile-gender\" contenteditable=\"true\"><span class=\"ql-size-13px\">{{profile.gender}}</span></span>\n                            </div>\n                                            </div>\n                </div>\n            </div>\n            <div class=\"h-description\">\n                {{?objective}}<div id=\"cvo-objective\" class=\"cvo-block\">\n    <div class=\"cvo-block-body\">\n        <div id=\"cvo-objective-objective\" contenteditable=\"true\"><p class=\"ql-align-justify\"><span class=\"ql-size-14px\">{{objective.objective}}</span></p></div>\n    </div>\n</div>\n            {{/objective}}</div>\n        </div>\n    </div>\n    <div class=\"cvo-col-7\">\n        <div id=\"group-left\">\n                            {{?education}}<div id=\"cvo-education\" class=\"cvo-block\">\n    <div class=\"cvo-block-header text-primary\">\n        <span id=\"cvo-education-blocktitle\"><i class=\"fa fa-graduation-cap\" aria-hidden=\"true\"></i> Education</span>\n    </div>\n    <div id=\"education-table\" class=\"cvo-block-body\">\n                        {{#education}}</div>\n</div>\n                            {{/education}}{{?skillgroup}}<div id=\"cvo-skillgroup\" class=\"cvo-block\"><div class=\"cvo-block-title\">Skills</div><div id=\"skillgroup-table\" class=\"block-content\">{{#skillgroup}}</div></div>{{/skillgroup}}{{?experience}}<div id=\"cvo-experience\" class=\"cvo-block\">\n    <div class=\"cvo-block-header text-primary\">\n        <span id=\"cvo-experience-blocktitle\"><i class=\"fa fa-briefcase\" aria-hidden=\"true\"></i> Work experience</span>\n    </div>\n    <div id=\"experience-table\" class=\"cvo-block-body\">\n                        {{#experience}}</div>\n</div>\n                    {{/experience}}</div>\n    </div>\n    <div class=\"cvo-col-5\">\n        <div id=\"group-right\">\n                            {{?award}}<div id=\"cvo-award\" class=\"cvo-block\">\n    <div class=\"cvo-block-header text-primary\">\n        <span id=\"cvo-award-blocktitle\"><i class=\"fa fa-gift\" aria-hidden=\"true\"></i> Honors &amp; Awards</span>\n    </div>\n    <div id=\"award-table\" class=\"cvo-block-body\">\n                        {{#award}}</div>\n\n</div>\n                    {{/award}}</div>\n    </div>\n    <div style=\"clear: both;\"></div>\n</div>\n <div id=\"cv-watermark\">\n    © topcv.vn\n</div>\n                    </div>\n                </div>\n            </div>", "originalBody": "<div id=\"cvo-document\" class=\"cvo-document\">\n                <div class=\"cvo-page\">\n                    <div class=\"cvo-subpage\">\n                        <div id=\"cvo-body\">\n    <div class=\"navigation\">\n        <div class=\"nav-header\">\n            <div class=\"action\">\n                <span class=\"toggle close\"></span>\n                <span class=\"toggle hide\"></span>\n                <span class=\"toggle full-screen\"></span>\n            </div>\n            <div class=\"tabs\">\n                <div class=\"tab prev\"></div>\n                <div class=\"tab active text-primary\">\n                    <span>Curriculum Vitae</span>\n                    <i class=\"fa fa-times icon text-primary\" aria-hidden=\"true\" style=\"float: right;\"></i>\n                </div>\n                <div class=\"tab next\"></div>\n            </div>\n            <div class=\"add-tab text-primary\"><i class=\"fa fa-plus\" aria-hidden=\"true\"></i></div>\n        </div>\n        <div class=\"nav-body\">\n            <div class=\"action\">\n                <span class=\"prev text-primary\"><i class=\"fa fa-angle-left\" aria-hidden=\"true\"></i></span>\n                <span class=\"next text-primary\"><i class=\"fa fa-angle-right\" aria-hidden=\"true\"></i></span>\n                <span class=\"reload text-primary\"><i class=\"fa fa-repeat\" aria-hidden=\"true\"></i></span>\n            </div>\n            <div class=\"search bg-primary-trans\">\n                <div class=\"input-search\">\n                    <span class=\"icon text-primary\">\n                        <i class=\"fa fa-briefcase\" aria-hidden=\"true\"></i>\n                    </span>\n                    <span class=\"title\">\n                        <strong class=\"ql-font-BeVietnamPro ql-size-18px\">Consultant</strong>\n                    </span>\n                </div>\n            </div>\n            <div class=\"action-right\">\n                <span class=\"icon text-primary\"><i class=\"fa fa-microphone\" aria-hidden=\"true\"></i></span>\n                <span class=\"icon text-primary\"><i class=\"fa fa-ellipsis-v\" aria-hidden=\"true\"></i></span>\n            </div>\n        </div>\n    </div>\n    <div id=\"group-header\" class=\"p-16 pb-0\">\n        <div class=\"h-content\">\n            <div class=\"top-content\">\n                                    <div id=\"cvo-profile-avatar-wraper\" class=\"profile-item\">\n                        <img id=\"cvo-profile-avatar\" src=\"/api/cv/source-assets/640cf40b5d4541830388.png\" value=\"preview_avatar\" alt=\"avatar\">\n                    </div>\n                                <div class=\"cvo-profile-fullname-and-title\">\n                    <div id=\"cvo-profile-fullname-wraper\">\n                        <span id=\"cvo-profile-fullname\" class=\"text-primary\"><strong class=\"ql-font-RobotoCondensed ql-size-23px\">PHAM HA AN</strong></span>\n                    </div>\n                                            <div id=\"cvo-profile-title-wraper\">\n                            <span id=\"cvo-profile-title\" class=\"text-primary\"><strong class=\"ql-font-BeVietnamPro ql-size-18px\">Consultant</strong></span>\n                        </div>\n                                        <div class=\"information\">\n                                                    <div class=\"cvo-profile-info-row\" id=\"cvo-profile-dob-wraper\">\n                                <i class=\"fa fa-calendar-o\" aria-hidden=\"true\"></i>\n                                <span class=\"cvo-profile-info-value\" id=\"cvo-profile-dob\">\n                                    <span class=\"ql-size-13px ql-font-BeVietnamPro\">August 24, 1996</span>\n                                </span>\n                            </div>\n                                                <div class=\"cvo-profile-info-row\">\n                            <i class=\"fa fa-phone\" aria-hidden=\"true\"></i>\n                            <span class=\"cvo-profile-info-value\" id=\"cvo-profile-phone\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">(024) 6680 5588</span></span>\n                        </div>\n                        <div class=\"cvo-profile-info-row\" id=\"cvo-profile-email-wraper\">\n                            <i class=\"fa fa-envelope\" aria-hidden=\"true\"></i>\n                            <span class=\"cvo-profile-info-value\" id=\"cvo-profile-email\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">hotro@topcv.vn</span></span>\n                        </div>\n                                                    <div class=\"cvo-profile-info-row\">\n                                <i class=\"fa fa-globe\" aria-hidden=\"true\"></i>\n                                <span id=\"cvo-profile-website\"><span class=\"ql-size-13px\">be.net/yourname</span></span>\n                            </div>\n                                                                            <div class=\"cvo-profile-info-row\" id=\"cvo-profile-address-wraper\">\n                                <i class=\"fa fa-location-arrow\" aria-hidden=\"true\"></i>\n                                <span class=\"cvo-profile-info-value\" id=\"cvo-profile-address\">\n                                    Ba Dinh, Ha Noi\n                                </span>\n                            </div>\n                                                                            <div class=\"cvo-profile-info-row\" id=\"cvo-profile-gender-wraper\">\n                                <i class=\"fa fa-user\" aria-hidden=\"true\"></i>\n                                <span class=\"cvo-profile-info-value\" id=\"cvo-profile-gender\">\n                                    <span class=\"ql-size-13px\">Male/Female/Other</span>\n                                </span>\n                            </div>\n                                            </div>\n                </div>\n            </div>\n            <div class=\"h-description\">\n                <div id=\"cvo-objective\" class=\"cvo-block\">\n    <div class=\"cvo-block-body\">\n        <div id=\"cvo-objective-objective\"><p class=\"ql-align-justify\"><span class=\"ql-size-14px\">Customer Consultant with 5 years of experience in product and course consulting at English centers and technology stores. Skilled in identifying potential customers, providing accurate information, and effectively persuading clients. Known for being quick-witted, adaptable, and thriving under pressure. Seeking a Customer Consultant position to contribute to revenue growth and customer acquisition for the company. </span></p></div>\n    </div>\n</div>\n            </div>\n        </div>\n    </div>\n    <div class=\"cvo-col-7\">\n        <div id=\"group-left\">\n                            <div id=\"cvo-education\" class=\"cvo-block\">\n    <div class=\"cvo-block-header text-primary\">\n        <span id=\"cvo-education-blocktitle\"><i class=\"fa fa-graduation-cap\" aria-hidden=\"true\"></i> Education</span>\n    </div>\n    <div id=\"education-table\" class=\"cvo-block-body\">\n                        <div class=\"row \">\n            <div class=\"cvo-section-info\">\n                <div class=\"cvo-education-school-wraper\">\n                    <span class=\"cvo-education-school\">TopCV University</span>\n                </div>\n                                <div class=\"cvo-education-time\">\n                    <span class=\"time-background\">\n                                                <span class=\"cvo-education-start\">2016</span>\n                                                 -                                                 <span class=\"cvo-education-end\">2020</span>\n                                            </span>\n                </div>\n                            </div>\n                            <div class=\"cvo-education-wrapper\"><span class=\"cvo-education-title\">Business Administration</span></div>\n                                    <div class=\"cvo-education-details\"><p><span class=\"ql-size-14px\">Excellent</span></p></div>\n                    </div>\n                    </div>\n</div>\n                            <div id=\"cvo-experience\" class=\"cvo-block\">\n    <div class=\"cvo-block-header text-primary\">\n        <span id=\"cvo-experience-blocktitle\"><i class=\"fa fa-briefcase\" aria-hidden=\"true\"></i> Work experience</span>\n    </div>\n    <div id=\"experience-table\" class=\"cvo-block-body\">\n                        <div class=\"row \">\n            <div class=\"cvo-section-info\">\n                <div class=\"cvo-experience-company-wraper\">\n                    <span class=\"cvo-experience-company\">HJS Academy</span>\n                </div>\n                                <div class=\"cvo-experience-time\">\n                    <span class=\"time-background\">\n                                                <span class=\"cvo-experience-start\">2022</span>\n                                                                        -\n                                                                        <span class=\"cvo-experience-end\">2025</span>\n                                            </span>\n                </div>\n                            </div>\n                            <div class=\"cvo-experience-wrapper\"><span class=\"cvo-experience-position\">Consultant</span></div>\n                        <div class=\"cvo-experience-details\"><ul><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Provided personalized consultation based on student's learning goals. </span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Recommended suitable English courses aligned with students' interests and proficiency levels, clearly explaining course features, benefits, and how they differ from competitors.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Promoted special enrollment promotions and tuition discounts to increase conversion rates, consistently exceeding 150% of assigned KPIs.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Collected and maintained a database of over 5,000 potential learners for nurturing and follow-up, contributing to long-term customer engagement and upselling.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Collaborated with Marketing and Academic departments to develop strategies for customer acquisition and retention, helping increase overall company revenue by 200% within one year. </span></li></ul></div>\n        </div>\n                <div class=\"row \">\n            <div class=\"cvo-section-info\">\n                <div class=\"cvo-experience-company-wraper\">\n                    <span class=\"cvo-experience-company\">TopCV BCD Company</span>\n                </div>\n                                <div class=\"cvo-experience-time\">\n                    <span class=\"time-background\">\n                                                <span class=\"cvo-experience-start\">August 2018</span>\n                                                                        -\n                                                                        <span class=\"cvo-experience-end\">July 2020</span>\n                                            </span>\n                </div>\n                            </div>\n                            <div class=\"cvo-experience-wrapper\"><span class=\"cvo-experience-position\">Software Solution Consultant</span></div>\n                        <div class=\"cvo-experience-details\"><ul><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Searched, consulted, and introduced software and hardware solutions (e.g., printers, barcode scanners) to approximately 50 customers daily, utilizing a database of 5,000 existing contacts and self-sourced 100 new leads per day. </span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Supported and guided customers in using software products both online and onsite, ensuring effective onboarding and usage.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Managed the sales process and contract signing, consistently exceeding 150% of the annual revenue KPI.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Maintained and developed a strong pipeline of potential customers, contributing to long-term business growth. </span></li></ul></div>\n        </div>\n                    </div>\n</div>\n                    </div>\n    </div>\n    <div class=\"cvo-col-5\">\n        <div id=\"group-right\">\n                            <div id=\"cvo-award\" class=\"cvo-block\">\n    <div class=\"cvo-block-header text-primary\">\n        <span id=\"cvo-award-blocktitle\"><i class=\"fa fa-gift\" aria-hidden=\"true\"></i> Honors &amp; Awards</span>\n    </div>\n    <div id=\"award-table\" class=\"cvo-block-body\">\n                        <div class=\"row \">\n                            <div class=\"cvo-award-wrapper\"><span class=\"cvo-award-time\">2020</span></div>\n                        <div class=\"cvo-award-title\"><p><strong class=\"ql-size-14px\">Best consultant in the third quarter of 2022</strong></p></div>\n            <div style=\"clear:both;\"></div>\n        </div>\n                    </div>\n\n</div>\n                    </div>\n    </div>\n    <div style=\"clear: both;\"></div>\n</div>\n <div id=\"cv-watermark\">\n    © topcv.vn\n</div>\n                    </div>\n                </div>\n            </div>", "rows": {"experience": "<div class=\"row \">\n            <div class=\"cvo-section-info\">\n                <div class=\"cvo-experience-company-wraper\">\n                    <span class=\"cvo-experience-company\" contenteditable=\"true\">{{experience.company}}</span>\n             