n id=\"cvo-experience-blocktitle\" class=\"title-common-before\">Work experience</span>\n            </div>\n            <div id=\"experience-table\">\n                                                {{#experience}}</div>\n            <div style=\"clear: both\"></div>\n        </div>\n    </div>\n</div>\n                            {{/experience}}</div>\n        </div>\n        <!-- END #col-right -->\n        <div style=\"clear: both;\"></div>\n    </div>\n</div>\n<div id=\"cv-watermark\">\n    © topcv.vn\n</div>\n                    </div>\n                </div>\n            </div>", "originalBody": "<div id=\"cvo-document\" class=\"cvo-document\">\n                <div class=\"cvo-page\">\n                    <div class=\"cvo-subpage\">\n                        <div id=\"cvo-body\">\n    <!--Header-->\n    <div id=\"cvo-main\">\n        <div id=\"col-left\">\n            <!-- #group-top-left -->\n            <div id=\"group-top-left\">\n                <!-- FIXED GROUP -->\n                <div id=\"cvo-profile\" class=\"cvo-block\">\n    <div id=\"profile-title-wrapper\">\n                <div id=\"cvo-profile-avatar-wraper\">\n            <div id=\"cvo-profile-avatar-outer\">\n                <img id=\"cvo-profile-avatar\" src=\"/api/cv/source-assets/640cf40b5d4541830388.png\" value=\"preview_avatar\" alt=\"avatar\">\n            </div>\n            <div class=\"label-top\"></div>\n        </div>\n                <div class=\"block-name-profile\">\n                            <i class=\"fa fa-chevron-right\"></i><span id=\"cvo-profile-title\"><strong class=\"ql-font-BeVietnamPro ql-size-18px\">Consultant</strong></span>\n                        <span id=\"cvo-profile-fullname\"><strong class=\"ql-font-RobotoCondensed ql-size-23px\">PHAM HA AN</strong></span><br>\n        </div>\n    </div>\n    <div id=\"profile-contact-wraper\">\n        <div class=\"cvo-block-title\">\n            <span id=\"cvo-profile-blocktitle\" class=\"title-common-before\">Contact information</span>\n        </div>\n                <div class=\"cvo-profile-info-row\" id=\"cvo-profile-dob-wraper\">\n            <i class=\"fa fa-calendar\"></i><span class=\"cvo-profile-info-value\" id=\"cvo-profile-dob\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">August 24, 1996</span></span>\n        </div>\n                <div class=\"cvo-profile-info-row\" id=\"cvo-profile-email-wraper\"><i class=\"fa fa-envelope\"></i><span class=\"cvo-profile-info-value\" id=\"cvo-profile-email\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">hotro@topcv.vn</span></span></div>\n                    <div class=\"cvo-profile-info-row\" id=\"cvo-profile-website-wraper\"><i class=\"fa fa-globe\"></i><span class=\"cvo-profile-info-value\" id=\"cvo-profile-website\"><span class=\"ql-size-13px\">be.net/yourname</span></span></div>\n                <div class=\"cvo-profile-info-row\" id=\"cvo-profile-phone-wraper\"><i class=\"fa fa-tablet\"></i><span class=\"cvo-profile-info-value\" id=\"cvo-profile-phone\"><span class=\"ql-size-13px ql-font-BeVietnamPro\">(024) 6680 5588</span></span></div>\n                    <div class=\"cvo-profile-info-row\" id=\"cvo-profile-address-wraper\"><i class=\"fa fa-home\"></i><span class=\"cvo-profile-info-value\" id=\"cvo-profile-address\">Ba Dinh, Ha Noi</span></div>\n            </div>\n    <div style=\"clear: both\"></div>\n</div>\n            </div>\n            <!-- END #group-top-left -->\n            <div id=\"group-bottom-left\">\n                                <div id=\"cvo-award\" class=\"cvo-block\">\n    <div class=\"cvo-block-content-wrapper\">\n        <div class=\"block-title-section-content\">\n            <div class=\"cvo-block-title\">\n                <span id=\"cvo-award-blocktitle\" class=\"title-common-before\">Honors &amp; Awards</span>\n            </div>\n            <div id=\"award-table\">\n                                                <div class=\"row \">\n                    <div class=\"row-title\">\n                                                <div class=\"cvo-award-time-wraper\">\n                            <span class=\"cvo-award-time\">2020</span>\n                        </div>\n                                                <div style=\"clear:both;\"></div>\n                        <div class=\"cvo-award-title-wraper\">\n                            <span class=\"cvo-award-title\"><p><strong class=\"ql-size-14px\">Best consultant in the third quarter of 2022</strong></p></span>\n                        </div>\n                    </div>\n                    <div style=\"clear:both;\"></div>\n                </div>\n                                            </div>\n        </div>\n    </div>\n    <div style=\"clear: both\"></div>\n</div>\n                                <div id=\"cvo-certification\" class=\"cvo-block\">\n    <div class=\"cvo-block-content-wrapper\">\n        <div class=\"block-title-section-content\">\n            <div class=\"cvo-block-title\">\n                <span id=\"cvo-certification-blocktitle\" class=\"title-common-before\">Certifications</span>\n            </div>\n            <div id=\"certification-table\">\n                                                <div class=\"row \">\n                    <div class=\"row-title\">\n                                                <div class=\"cvo-certification-time-wraper\">\n                            <span class=\"cvo-certification-time\">2022</span>\n                        </div>\n                                                <div style=\"clear:both;\"></div>\n                        <div class=\"cvo-certification-title-wraper\">\n                            <span class=\"cvo-certification-title\"><p><strong class=\"ql-size-14px\">Training Program: Telephone Selling Skills</strong></p></span>\n                        </div>\n                    </div>\n                    <div style=\"clear:both;\"></div>\n                </div>\n                                <div class=\"row \">\n                    <div class=\"row-title\">\n                                                <div class=\"cvo-certification-time-wraper\">\n                            <span class=\"cvo-certification-time\">2021</span>\n                        </div>\n                                                <div style=\"clear:both;\"></div>\n                        <div class=\"cvo-certification-title-wraper\">\n                            <span class=\"cvo-certification-title\"><p><strong class=\"ql-size-14px\">Professional Customer Care Management training course</strong></p></span>\n                        </div>\n                    </div>\n                    <div style=\"clear:both;\"></div>\n                </div>\n                                            </div>\n        </div>\n    </div>\n    <div style=\"clear: both\"></div>\n</div>\n                            </div>\n        </div>\n        <!-- END #col-left -->\n        <!-- #col-right -->\n        <div id=\"col-right\">\n            <div id=\"group-col-right\">\n                                <div id=\"cvo-objective\" class=\"cvo-block\">\n    <div class=\"cvo-block-content-wrapper\">\n        <div class=\"block-title-section-content\">\n            <div class=\"cvo-block-title no-horizontal-line\">\n                <span id=\"cvo-objective-blocktitle\" class=\"title-common-before\">CAREER OBJECTIVES</span>\n            </div>\n            <div id=\"cvo-objective-objective\"><p class=\"ql-align-justify\"><span class=\"ql-size-14px\">Customer Consultant with 5 years of experience in product and course consulting at English centers and technology stores. Skilled in identifying potential customers, providing accurate information, and effectively persuading clients. Known for being quick-witted, adaptable, and thriving under pressure. Seeking a Customer Consultant position to contribute to revenue growth and customer acquisition for the company. </span></p></div>\n        </div>\n    </div>\n</div>\n                                <div id=\"cvo-education\" class=\"cvo-block\">\n    <div class=\"cvo-block-content-wrapper\">\n        <div class=\"block-title-section-content\">\n            <div class=\"cvo-block-title\">\n                <span id=\"cvo-education-blocktitle\" class=\"title-common-before\">Education</span>\n            </div>\n            <div id=\"education-table\">\n                                                <div class=\"row \">\n                    <div class=\"row-title\">\n                                                    <div class=\"block-education-title\">\n                                <span class=\"cvo-education-title\">Business Administration</span>\n                            </div>\n                                                                            <div class=\"cvo-section-time-value\">\n                                <div class=\"cvo-background-time\">\n                                    <span class=\"cvo-education-start\">2016</span>                                                                                                                        -\n                                                                                                                                                        <span class=\"cvo-education-end\">2020</span>\n                                                                    </div>\n                            </div>\n                                                <div style=\"clear:both;\"></div>\n                        <div class=\"cvo-info-wrapper\">\n                            <span class=\"cvo-education-school\">TopCV University</span>\n                        </div>\n                    </div>\n                                        <div class=\"row-details\">\n                        <div class=\"cvo-education-details\"><p><span class=\"ql-size-14px\">Excellent</span></p></div>\n                    </div>\n                                        <div style=\"clear:both;\"></div>\n                </div>\n                                            </div>\n        </div>\n    </div>\n</div>\n                                <div id=\"cvo-experience\" class=\"cvo-block\">\n    <div class=\"cvo-block-content-wrapper\">\n        <div class=\"block-title-section-content\">\n            <div class=\"cvo-block-title\">\n                <span id=\"cvo-experience-blocktitle\" class=\"title-common-before\">Work experience</span>\n            </div>\n            <div id=\"experience-table\">\n                                                <div class=\"row \">\n                    <div class=\"row-title\">\n                                                    <div class=\"block-experience-position\">\n                                <span class=\"cvo-experience-position\">Consultant</span>\n                            </div>\n                                                                        <div class=\"cvo-experience-time\">\n                            <div class=\"cvo-background-time\">\n                                <span class=\"cvo-experience-start\">2022</span>                                                                                                -\n                                                                                                <span class=\"cvo-experience-end\">2025</span>                            </div>\n                        </div>\n                                                <div style=\"clear:both;\"></div>\n                        <div class=\"block-detail-company\">\n                            <span class=\"cvo-experience-company\">HJS Academy</span>\n                        </div>\n                    </div>\n                    <div class=\"row-details\">\n                        <div class=\"cvo-experience-details\"><ul><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Provided personalized consultation based on student's learning goals. </span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Recommended suitable English courses aligned with students' interests and proficiency levels, clearly explaining course features, benefits, and how they differ from competitors.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Promoted special enrollment promotions and tuition discounts to increase conversion rates, consistently exceeding 150% of assigned KPIs.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Collected and maintained a database of over 5,000 potential learners for nurturing and follow-up, contributing to long-term customer engagement and upselling.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Collaborated with Marketing and Academic departments to develop strategies for customer acquisition and retention, helping increase overall company revenue by 200% within one year. </span></li></ul></div>\n                    </div>\n                    <div style=\"clear:both;\"></div>\n                </div>\n                                <div class=\"row \">\n                    <div class=\"row-title\">\n                                                    <div class=\"block-experience-position\">\n                                <span class=\"cvo-experience-position\">Software Solution Consultant</span>\n                            </div>\n                                                                        <div class=\"cvo-experience-time\">\n                            <div class=\"cvo-background-time\">\n                                <span class=\"cvo-experience-start\">August 2018</span>                                                                                                -\n                                                                                                <span class=\"cvo-experience-end\">July 2020</span>                            </div>\n                        </div>\n                                                <div style=\"clear:both;\"></div>\n                        <div class=\"block-detail-company\">\n                            <span class=\"cvo-experience-company\">TopCV BCD Company</span>\n                        </div>\n                    </div>\n                    <div class=\"row-details\">\n                        <div class=\"cvo-experience-details\"><ul><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Searched, consulted, and introduced software and hardware solutions (e.g., printers, barcode scanners) to approximately 50 customers daily, utilizing a database of 5,000 existing contacts and self-sourced 100 new leads per day. </span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Supported and guided customers in using software products both online and onsite, ensuring effective onboarding and usage.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Managed the sales process and contract signing, consistently exceeding 150% of the annual revenue KPI.</span></li><li class=\"ql-align-justify\"><span class=\"ql-size-14px\">Maintained and developed a strong pipeline of potential customers, contributing to long-term business growth. </span></li></ul></div>\n                    </div>\n                    <div style=\"clear:both;\"></div>\n                </div>\n                                            </div>\n            <div style=\"clear: both\"></div>\n        </div>\n    </div>\n</div>\n                            </div>\n        </div>\n        <!-- END #col-right -->\n        <div style=\"clear: both;\"></div>\n    </div>\n</div>\n<div id=\"cv-watermark\">\n    © topcv.vn\n</div>\n                    </div>\n                </div>\n            </div>", "rows": {"experience": "<div class=\"row \">\n                    <div class=\"row-title\">\n                                                    <div class=\"block-experience-position\">\n                                <span class=\"cvo-experience-position\" c