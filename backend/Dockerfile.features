FROM node:22-alpine
WORKDIR /app
RUN apk add --no-cache chromium nss freetype harfbuzz ca-certificates ttf-freefont font-noto font-noto-extra font-noto-emoji font-dejavu
COPY package*.json ./
COPY features/connectcv/package*.json ./features/connectcv/
RUN npm ci --omit=dev
COPY server.js app.js ./
COPY src ./src
COPY features ./features
RUN mkdir -p /app/data && chown node:node /app/data
ENV NODE_ENV=production CHROMIUM_PATH=/usr/bin/chromium-browser
USER node
EXPOSE 5000
CMD ["node","server.js"]
